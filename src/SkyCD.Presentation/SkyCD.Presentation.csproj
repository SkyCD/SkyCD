<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\SkyCD.Documents\SkyCD.Documents.csproj" />
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]" />
        <ProjectReference Include="..\SkyCD.Plugin.Host\SkyCD.Plugin.Host.csproj" />
        <ProjectReference Include="..\SkyCD.Plugin.Runtime\SkyCD.Plugin.Runtime.csproj" />
        <ProjectReference Include="..\SkyCD.Formatting\SkyCD.Formatting.csproj" />
        <ProjectReference Include="..\SkyCD.UI\SkyCD.UI.csproj" />
        <ProjectReference Include="..\SkyCD.Core\SkyCD.Core.csproj" />
        <ProjectReference Include="..\SkyCD.Couchbase\SkyCD.Couchbase.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Declared explicitly (issue #1226): Presentation still renders Avalonia images/controls in the
             thumbnail pipeline, so the framework is a direct dependency, not only a transitive one. -->
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Couchbase.Lite" Version="4.1.3" />
        <PackageReference Include="FluentFTP" Version="55.1.0" />
        <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="11.0.0" />
        <PackageReference Include="SSH.NET" Version="2026.0.1" />
        <PackageReference Include="WebDav.Client" Version="2.9.0" />
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <!-- Test seam: FTPS certificate trust policy injection (see FtpCatalogConnector). -->
        <InternalsVisibleTo Include="SkyCD.App.Tests" />
    </ItemGroup>
</Project>
