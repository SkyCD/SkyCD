<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.5"/>
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>
        <PackageReference Include="SmartFormat" Version="3.6.2"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
        <ProjectReference Include="..\SkyCD.Formatting\SkyCD.Formatting.csproj"/>
        <EmbeddedResource Include="Translations\*.yaml"/>
        <Content Include="Translations\en-*.yaml" Link="Data\i18n\en\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <Content Include="Translations\lt-*.yaml" Link="Data\i18n\lt\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
