<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <!-- Dialogs take their request in the constructor, so the compiled XAML has no runtime-loader entry point. -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>
        <PackageReference Include="SmartFormat" Version="3.6.2"/>
        <!-- Issue #1184: the shared search field draws the same Lucide glyph the app already uses. -->
        <PackageReference Include="IconPacks.Avalonia" Version="2.0.0"/>
        <PackageReference Include="IconPacks.Avalonia.Lucide" Version="2.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SkyCD.SDK\SkyCD.SDK.csproj"/>
        <ProjectReference Include="..\SkyCD.Formatting\SkyCD.Formatting.csproj"/>
        <AvaloniaResource Include="../SkyCD.App/Assets/skycd.ico" Link="Assets/skycd.ico"/>
        <EmbeddedResource Include="Translations\*.yaml"/>
        <Content Include="Translations\en-*.yaml" Link="Data\i18n\en\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <Content Include="Translations\lt-*.yaml" Link="Data\i18n\lt\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
