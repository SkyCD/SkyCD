<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkyCD.UI.Controls.StatusBar.StatusBar"
             x:Name="Root"
             Height="22"
             MinHeight="22">
    <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,1,0,0"
            Padding="4,0"
            Height="22">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Text="{Binding StatusText, ElementName=Root}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProgressText, ElementName=Root}"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       IsVisible="{Binding IsProgressVisible, ElementName=Root}" />
            <ProgressBar Grid.Column="2"
                         Width="100"
                         Height="14"
                         Minimum="{Binding ProgressMin, ElementName=Root}"
                         Maximum="{Binding ProgressMax, ElementName=Root}"
                         Value="{Binding ProgressValue, ElementName=Root}"
                         VerticalAlignment="Center"
                         Margin="2,0,4,0"
                         IsVisible="{Binding IsProgressVisible, ElementName=Root}">
                <ProgressBar.Foreground>
                    <DrawingBrush TileMode="Tile"
                                  SourceRect="0,0,8,14"
                                  DestinationRect="0,0,8,14">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{DynamicResource ThemeAccentBrush}"
                                                 Geometry="M 0,0 L 6,0 L 6,14 L 0,14 Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock Grid.Column="3"
                       Margin="4,0,2,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{Binding McpStatusColor, ElementName=Root}"
                       Text="{Binding McpStatusGlyph, ElementName=Root}"
                       FontSize="11"
                       ToolTip.Tip="{Binding McpStatusTooltip, ElementName=Root}"
                       IsVisible="{Binding IsMcpStatusVisible, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
