<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization"
             x:Class="SkyCD.UI.Controls.RichText.RichTextEditor"
             x:Name="Root"
             Focusable="True">
    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Background="{DynamicResource ThemeBackgroundBrush}">
        <Grid RowDefinitions="Auto,*">
            <!-- Toolbar -->
            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource ThemeControlMidBrush}"
                    Padding="4,2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton Name="BoldButton"
                                  ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Bold}}"
                                  FontWeight="Bold"
                                  Width="26" Height="26"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="B"
                                  Click="OnBoldClicked" />
                    <ToggleButton Name="ItalicButton"
                                  ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Italic}}"
                                  FontStyle="Italic"
                                  Width="26" Height="26"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="I"
                                  Click="OnItalicClicked" />
                    <ToggleButton Name="UnderlineButton"
                                  ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Underline}}"
                                  Width="26" Height="26"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Click="OnUnderlineClicked">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                    <ToggleButton Name="StrikeoutButton"
                                  ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Strikeout}}"
                                  Width="26" Height="26"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Click="OnStrikeoutClicked">
                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                    </ToggleButton>
                    <ToggleButton Name="BulletButton"
                                  ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Bullets}}"
                                  Width="26" Height="26"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="•"
                                  Click="OnBulletClicked" />
                    <Separator Width="1" Height="18" Margin="4,0" />
                    <Button Name="UndoButton"
                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Undo}}"
                            Width="26" Height="26"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="↶"
                            Click="OnUndoClicked" />
                    <Button Name="RedoButton"
                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Redo}}"
                            Width="26" Height="26"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="↷"
                            Click="OnRedoClicked" />
                </StackPanel>
            </Border>

            <!-- Editor Surface -->
            <Grid Grid.Row="1">
                <ScrollViewer Name="EditorScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="4">
                        <SelectableTextBlock Name="FormattedDisplay"
                                             TextWrapping="Wrap"
                                             IsHitTestVisible="False"
                                             Margin="3,2,3,2" />
                        <TextBox Name="EditorTextBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="Transparent"
                                 CaretBrush="{DynamicResource ThemeForegroundBrush}"
                                 Margin="0"
                                 Padding="3,2,3,2" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
