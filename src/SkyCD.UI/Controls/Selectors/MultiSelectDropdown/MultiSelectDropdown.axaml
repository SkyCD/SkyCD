<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization"
             xmlns:search="clr-namespace:SkyCD.UI.Controls.SearchTextBox"
             xmlns:multiSelect="clr-namespace:SkyCD.UI.Controls.Selectors.MultiSelectDropdown"
             x:Class="SkyCD.UI.Controls.Selectors.MultiSelectDropdown.MultiSelectDropdown"
             x:Name="Root">
    <Grid RowDefinitions="Auto">
        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SkyCornerRadius}"
                Padding="{DynamicResource SkyRowPadding}"
                Height="32">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                <TextBox x:Name="InlineSearchTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="{DynamicResource SkyInputPadding}"
                         VerticalContentAlignment="Center"
                         IsReadOnly="{Binding IsIconPicker, ElementName=Root}"
                         KeyDown="OnInlineSearchTextBoxKeyDown"
                         TextChanged="OnInlineSearchTextChanged"
                         GotFocus="OnInlineSearchTextBoxGotFocus"
                         LostFocus="OnInlineSearchTextBoxLostFocus" />
                <ContentControl x:Name="SelectedIconPreview"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ContentTemplate="{Binding ItemPreviewTemplate, ElementName=Root}"
                                Content="{Binding SelectedIconKey, ElementName=Root}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="▾"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           PointerPressed="OnChevronPointerPressed" />
            </Grid>
        </Border>

        <Popup x:Name="DropdownPopup"
               PlacementTarget="{Binding #InlineSearchTextBox}"
               Placement="BottomEdgeAlignedLeft"
               IsOpen="False"
               IsLightDismissEnabled="True"
               Closed="OnDropdownPopupClosed"
               Opened="OnDropdownPopupOpened"
               Topmost="False">
            <Border Background="{DynamicResource ThemeBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SkyCornerRadius}"
                    MinWidth="{Binding Bounds.Width, ElementName=Root}"
                    Padding="{DynamicResource SkyInsetSm}">
                <Grid>
                    <ListBox x:Name="ItemsListBox"
                             IsVisible="{Binding !IsIconPicker, ElementName=Root}"
                             MaxHeight="220"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             SelectionMode="Single"
                             GotFocus="OnItemsListGotFocus"
                             KeyDown="OnItemsListKeyDown"
                             SelectionChanged="OnItemsListSelectionChanged"
                             PointerPressed="OnItemsListPointerPressed">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{DynamicResource ThemeBorderHighBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="{DynamicResource SkyControlPadding}"
                                        CornerRadius="2">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBorderHighBrush}" />
                                        </Style>
                                    </Border.Styles>
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  AutomationProperties.Name="{Binding Label}"
                                                  PointerPressed="OnItemCheckBoxPointerPressed"
                                                  VerticalAlignment="Center" />
                                        <ContentControl Grid.Column="1"
                                                        IsVisible="{Binding ItemPreviewTemplate, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                        VerticalAlignment="Center"
                                                        ContentTemplate="{Binding ItemPreviewTemplate, ElementName=Root}"
                                                        Content="{Binding Label}" />
                                        <TextBlock Grid.Column="2"
                                                   IsVisible="{Binding ShowItemLabels, ElementName=Root}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        Issue #1214: the status icon picker imitates the Windows emoji panel — a search
                        field, a strip of pack tabs and one continuous tile sheet with no checkboxes.
                        The sheet scrolls through every pack; scrolling moves the active tab and picking
                        a tab scrolls the sheet to that pack. Only the type multi-select keeps the list above.
                    -->
                    <Grid x:Name="IconPickerPanel"
                          IsVisible="{Binding IsIconPicker, ElementName=Root}"
                          Width="{DynamicResource SkyIconPickerWidth}"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <search:SearchTextBox x:Name="IconSearchTextBox"
                                              AutomationProperties.AutomationId="IconSearchTextBox"
                                              PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SearchIcons}}"
                                              TextChanged="OnIconSearchTextChanged" />

                        <ListBox Grid.Row="1"
                                 x:Name="IconCategoryList"
                                 AutomationProperties.AutomationId="IconCategoryList"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="OnIconCategorySelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{DynamicResource SkySpaceMd}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.icon-category">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                </Style>
                                <Style Selector="Border.icon-category:pointerover">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHighBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="multiSelect:IconCategoryItem">
                                    <Border Classes="icon-category"
                                            BorderThickness="0,0,0,2"
                                            BorderBrush="Transparent"
                                            Padding="{DynamicResource SkyIconCategoryPadding}"
                                            ToolTip.Tip="{Binding Label}"
                                            AutomationProperties.Name="{Binding Label}">
                                        <ContentControl Width="{DynamicResource SkyIconSize}"
                                                        Height="{DynamicResource SkyIconSize}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Content="{Binding IconKey}"
                                                        ContentTemplate="{Binding ItemTileTemplate, ElementName=Root}" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Row="2"
                                 x:Name="IconTilesListBox"
                                 AutomationProperties.AutomationId="IconTilesListBox"
                                 SelectionMode="Single"
                                 Focusable="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Height="{DynamicResource SkyIconGridHeight}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="Border.icon-tile">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="Border.icon-tile:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
                                </Style>
                                <Style Selector="Border.icon-tile.icon-selected">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="multiSelect:IconTileRow">
                                    <ItemsControl ItemsSource="{Binding Tiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{DynamicResource SkySpaceXxs}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="multiSelect:IconTileItem">
                                                <Border Classes="icon-tile"
                                                        Classes.icon-selected="{Binding IsHighlighted}"
                                                        Width="{DynamicResource SkyIconTileSize}"
                                                        Height="{DynamicResource SkyIconTileSize}"
                                                        CornerRadius="{DynamicResource SkyCornerRadius}"
                                                        BorderThickness="1"
                                                        ToolTip.Tip="{Binding Key}"
                                                        AutomationProperties.Name="{Binding Key}"
                                                        PointerPressed="OnIconTilePointerPressed">
                                                    <ContentControl Width="{DynamicResource SkyIconSize}"
                                                                    Height="{DynamicResource SkyIconSize}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    VerticalContentAlignment="Stretch"
                                                                    Content="{Binding Key}"
                                                                    ContentTemplate="{Binding ItemTileTemplate, ElementName=Root}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
