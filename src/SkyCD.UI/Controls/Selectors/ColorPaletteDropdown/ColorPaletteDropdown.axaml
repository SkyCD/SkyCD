<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
             x:Class="SkyCD.UI.Controls.Selectors.ColorPaletteDropdown.ColorPaletteDropdownControl"
             x:Name="Root">
    <Grid>
        <Button x:Name="ToggleButton"
                Click="OnToggleButtonClick"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Height="32">
            <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource ThemeBackgroundBrush}"
                    CornerRadius="{DynamicResource SkyCornerRadius}"
                    Padding="{DynamicResource SkyRowPadding}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                    <Border Width="16"
                            Height="16"
                            CornerRadius="{DynamicResource SkyCornerRadiusSmall}"
                            BorderBrush="{DynamicResource SkyDropdownChrome}"
                            BorderThickness="1"
                            Background="{Binding SelectedBrush, ElementName=Root}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedColor, ElementName=Root}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="▾"
                               Foreground="{DynamicResource SkyDropdownChrome}" />
                </Grid>
            </Border>
        </Button>

        <Popup x:Name="PalettePopup"
               PlacementTarget="{Binding #ToggleButton}"
               Placement="BottomEdgeAlignedLeft"
               IsOpen="False"
               IsLightDismissEnabled="True"
               Topmost="False">
            <Border Background="{DynamicResource ThemeBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SkyCornerRadius}"
                    Padding="{DynamicResource SkyInsetMd}">
                <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Color}}"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               FontSize="{DynamicResource SkyFontSecondary}"
                               FontWeight="SemiBold" />
                    <Border x:Name="SvSurfaceBorder"
                            Width="200"
                            Height="140"
                            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left">
                        <Grid x:Name="SvSurface"
                              PointerPressed="OnSvSurfacePointerPressed"
                              PointerMoved="OnSvSurfacePointerMoved"
                              PointerReleased="OnSvSurfacePointerReleased">
                            <Image x:Name="SvImage"
                                   Stretch="Fill" />
                            <Canvas>
                                <Border x:Name="SvThumb"
                                        Width="10"
                                        Height="10"
                                        BorderBrush="White"
                                        BorderThickness="1.5"
                                        CornerRadius="{DynamicResource SkyColorThumbRadius}"
                                        Background="Transparent" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Hue}}"
                               Margin="{DynamicResource SkyGapTopXxs}"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               FontSize="{DynamicResource SkyFontSecondary}"
                               FontWeight="SemiBold" />
                    <Border x:Name="HueBarBorder"
                            Width="200"
                            Height="12"
                            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left">
                        <Grid x:Name="HueBarSurface"
                              PointerPressed="OnHueBarPointerPressed"
                              PointerMoved="OnHueBarPointerMoved"
                              PointerReleased="OnHueBarPointerReleased">
                            <Image x:Name="HueImage"
                                   Stretch="Fill" />
                            <Canvas>
                                <Border x:Name="HueThumb"
                                        Width="8"
                                        Height="12"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Background="Transparent" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Hex}}"
                               Margin="{DynamicResource SkyGapTopXxs}"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               FontSize="{DynamicResource SkyFontSecondary}"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="HexTextBox"
                             Width="200"
                             HorizontalAlignment="Left"
                             TextInput="OnHexTextBoxTextInput"
                             TextChanged="OnHexTextChanged" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
