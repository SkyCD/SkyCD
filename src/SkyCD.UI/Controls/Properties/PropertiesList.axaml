<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkyCD.UI.Controls.Properties.PropertiesList"
             x:Name="Root">
    <UserControl.Resources>
        <!-- The header and row grids disable layout rounding so the scrollbar gutter cannot change how this width rounds. -->
        <GridLength x:Key="PropertyColumnWidth">183</GridLength>
        <ItemsPanelTemplate x:Key="DefaultRowsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="DefaultPropertyCellTemplate">
            <TextBlock Text="{Binding Key}" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="DefaultValueCellTemplate">
            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox.editable-rows">
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        </Style>
    </UserControl.Styles>
    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
            <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource ThemeControlMidBrush}">
                <Grid UseLayoutRounding="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource PropertyColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="0,0,1,0" Padding="{DynamicResource SkyControlPadding}">
                        <TextBlock Text="{Binding PropertyHeader, ElementName=Root}" FontWeight="SemiBold" />
                    </Border>
                    <Border Grid.Column="1" Padding="{DynamicResource SkyControlPadding}">
                        <TextBlock Text="{Binding ValueHeader, ElementName=Root}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <ListBox x:Name="RowsListBox"
                     Grid.Row="1"
                     Classes.editable-rows="{Binding !RowIsTabStop, ElementName=Root}"
                     BorderThickness="0"
                     Padding="0"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemsPanel="{Binding RowsPanel, ElementName=Root}"
                     ItemsSource="{Binding Rows, ElementName=Root}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsTabStop" Value="{Binding RowIsTabStop, ElementName=Root}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid UseLayoutRounding="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource PropertyColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="0,0,1,1"
                                    Padding="{DynamicResource SkyControlPadding}">
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{Binding PropertyCellTemplate, ElementName=Root}" />
                            </Border>
                            <!-- The value-cell class lets in-place editing find the editable column. -->
                            <Border Grid.Column="1"
                                    Classes="value-cell"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="{DynamicResource SkyControlPadding}">
                                <ContentPresenter Content="{Binding}"
                                                  ContentTemplate="{Binding ValueCellTemplate, ElementName=Root}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
