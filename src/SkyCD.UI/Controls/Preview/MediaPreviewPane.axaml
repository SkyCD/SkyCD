<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
             xmlns:pv="clr-namespace:SkyCD.UI.Controls.Preview;assembly=SkyCD.UI"
             x:Class="SkyCD.UI.Controls.Preview.MediaPreviewPane"
             x:Name="Root"
             MinHeight="80">
    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeControlMidBrush}"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="EntryNameText"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="{Binding EntryName, ElementName=Root}"
                               AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.EntryNameAutomation}}" />
                    <TextBlock x:Name="StateText"
                               Grid.Column="1"
                               FontSize="11"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText, ElementName=Root}"
                               AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.StateAutomation}}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ClipToBounds="True">
                <Image x:Name="PreviewImageControl"
                       Margin="6"
                       Stretch="Uniform"
                       Source="{Binding PreviewImage, ElementName=Root}"
                       AutomationProperties.Name="{Binding PreviewAutomationName, ElementName=Root}" />

                <TextBox x:Name="PreviewTextControl"
                         Margin="4"
                         Padding="4"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Text="{Binding PreviewText, ElementName=Root, Mode=OneWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.PreviewTextAutomation}}" />

                <ProgressBar x:Name="LoadingIndicator"
                             Height="3"
                             Margin="0"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.StateLoading}}" />

                <TextBlock x:Name="StateMessageText"
                           Margin="16"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding StateMessage, ElementName=Root}"
                           AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.StateAutomation}}" />
            </Grid>

            <Grid Grid.Row="2" x:Name="FieldsSection" RowDefinitions="Auto,*">
                <Border Background="{DynamicResource ThemeControlMidBrush}"
                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,3">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Text="{i18n:Translate {x:Static i18n:PreviewKeys.FieldsHeader}}" />
                </Border>

                <ListBox Grid.Row="1"
                         x:Name="FieldsList"
                         MaxHeight="150"
                         BorderThickness="0"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Fields, ElementName=Root}"
                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.FieldsAutomation}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pv:MediaPreviewFieldRow">
                            <Grid ColumnDefinitions="140,*" Margin="0">
                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="0,0,1,1"
                                        Padding="8,3">
                                    <TextBlock FontSize="11"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Label}" />
                                </Border>
                                <Border Grid.Column="1"
                                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,3">
                                    <StackPanel Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <SelectableTextBlock FontSize="11"
                                                                 Text="{Binding Value}"
                                                                 TextWrapping="Wrap" />
                                            <Button Grid.Column="1"
                                                    FontSize="10"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsVisible="{Binding IsCopyable}"
                                                    Tag="{Binding Value}"
                                                    Click="OnCopyFieldClick"
                                                    Content="{i18n:Translate {x:Static i18n:PreviewKeys.CopyValue}}"
                                                    AutomationProperties.Name="{i18n:Translate {x:Static i18n:PreviewKeys.CopyValue}}" />
                                        </Grid>
                                        <TextBlock FontSize="10"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasHint}"
                                                   Text="{Binding Hint}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
