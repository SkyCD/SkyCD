<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cl="clr-namespace:SkyCD.UI.Controls.Lists;assembly=SkyCD.UI"
             x:Class="SkyCD.UI.Controls.Lists.BrowserItemsView"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Focusable" Value="True" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlHighlightHighBrush}" />
        </Style>
        <Style Selector="ListBox:focus ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlHighlightHighBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <cl:DetailsListView x:Name="DetailsListView"
                            IsVisible="False"
                            ListMinWidth="{Binding ListMinWidth, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            ListContextMenu="{Binding ListContextMenu, ElementName=Root}"
                            HeaderContent="{Binding HeaderContent, ElementName=Root}"
                            RowTemplate="{Binding DetailsRowTemplate, ElementName=Root}" />

        <ListBox x:Name="ListModeListBox"
                 MinWidth="{Binding ListMinWidth, ElementName=Root}"
                 IsVisible="False"
                 ItemsSource="{Binding ItemsSource, ElementName=Root}"
                 SelectionMode="Multiple"
                 ContextMenu="{Binding ListContextMenu, ElementName=Root}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ListBox x:Name="IconGridListBox"
                 MinWidth="{Binding ListMinWidth, ElementName=Root}"
                 IsVisible="False"
                 ItemsSource="{Binding ItemsSource, ElementName=Root}"
                 SelectionMode="Multiple"
                 ContextMenu="{Binding ListContextMenu, ElementName=Root}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>
