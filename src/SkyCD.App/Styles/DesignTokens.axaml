<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The single source of spacing, type and control metrics (issue #898).
        Windows and shared controls reference these keys instead of literals; plugin views
        rendered inside host surfaces resolve the same application-level resources.
        Spacing follows a 2/4/8/12/16/24/32 ramp; 2 is the hairline step for dense legacy layouts.
    -->
    <x:Double x:Key="SkySpaceXxs">2</x:Double>
    <x:Double x:Key="SkySpaceXs">4</x:Double>
    <x:Double x:Key="SkySpaceSm">8</x:Double>
    <x:Double x:Key="SkySpaceMd">12</x:Double>
    <x:Double x:Key="SkySpaceLg">16</x:Double>
    <x:Double x:Key="SkySpaceXl">24</x:Double>
    <x:Double x:Key="SkySpaceXxl">32</x:Double>

    <Thickness x:Key="SkyWindowPadding">12</Thickness>

    <Thickness x:Key="SkySectionPadding">12</Thickness>
    <Thickness x:Key="SkyControlPadding">8,4</Thickness>
    <Thickness x:Key="SkyInsetXxs">2</Thickness>
    <Thickness x:Key="SkyInsetXs">4</Thickness>
    <Thickness x:Key="SkyInsetSm">8</Thickness>
    <Thickness x:Key="SkyInsetMd">12</Thickness>
    <Thickness x:Key="SkyInsetLg">16</Thickness>

    <!--
        Source picker rows (issue #1030). The closed ComboBox field and its dropdown rows share one
        inset, so the icon column and the label column line up between the field and the open list;
        the 16 px icon plus the vertical inset sets the row height.
    -->
    <Thickness x:Key="SkyComboBoxContentPadding">8,4</Thickness>

    <!--
        Text inputs share one inner inset (issue #1184). The icon of a search field sits on the
        same inset as plain input text, so the glyph and the text start at one shared edge.
    -->
    <Thickness x:Key="SkyInputPadding">8,4</Thickness>
    <!-- The Lucide search glyph every search field draws (issue #1184). -->
    <x:Double x:Key="SkySearchIconSize">14</x:Double>

    <!--
        The inset vocabulary (issue #999). Margin and Padding take one of these keys, or a plain 0
        when a surface inherits an inset it does not want; never a number. SkyInset* dresses all four
        sides. SkyGap* keeps the same ramp but zeroes the sides that must not move, because XAML
        cannot assemble a Thickness from the scalar spacing ramp. A gap is named after the ramp step
        it uses; a value that differs per side is named after the surface it shapes.
    -->
    <!-- One side: separates a block from the neighbour above or below it. -->
    <Thickness x:Key="SkyGapTopXxs">0,2,0,0</Thickness>
    <Thickness x:Key="SkyGapTopXs">0,4,0,0</Thickness>
    <Thickness x:Key="SkyGapTopSm">0,8,0,0</Thickness>
    <Thickness x:Key="SkyGapTopMd">0,12,0,0</Thickness>
    <Thickness x:Key="SkyGapTopLg">0,16,0,0</Thickness>
    <Thickness x:Key="SkyGapBottomXxs">0,0,0,2</Thickness>
    <Thickness x:Key="SkyGapBottomXs">0,0,0,4</Thickness>
    <Thickness x:Key="SkyGapBottomSm">0,0,0,8</Thickness>
    <Thickness x:Key="SkyGapBottomMd">0,0,0,12</Thickness>
    <Thickness x:Key="SkyGapLeftSm">8,0,0,0</Thickness>

    <!-- One axis: separates rows or columns inside a stack. -->
    <Thickness x:Key="SkyGapYXxs">0,2,0,2</Thickness>
    <Thickness x:Key="SkyGapYXs">0,4,0,4</Thickness>
    <Thickness x:Key="SkyGapYSm">0,8,0,8</Thickness>
    <Thickness x:Key="SkyGapYMd">0,12,0,12</Thickness>
    <Thickness x:Key="SkyGapXXxs">2,0,2,0</Thickness>
    <Thickness x:Key="SkyGapXXs">4,0,4,0</Thickness>

    <!-- Composed insets: each replaces the second wrapper element a per-side inset would need. -->
    <Thickness x:Key="SkyRowPadding">8,6</Thickness>
    <Thickness x:Key="SkyControlPaddingTight">4,2</Thickness>
    <!--
        The card tab header keeps the horizontal inset of SkyInsetMd, the content inset of the same
        card, so the header text and the tab body share one left edge (issue #997). The 5/6 split
        centers the label above the 1px card border the selected header overlaps.
    -->
    <Thickness x:Key="SkyTabHeaderPadding">12,5,12,6</Thickness>
    <!-- The 25px toolbar holds 22px buttons, so only 1px is inset above and below them (issue #412). -->
    <Thickness x:Key="SkyToolbarPadding">2,1</Thickness>
    <!-- Text inset of the inline property editor, so it opens exactly on the cell text it replaces. -->
    <Thickness x:Key="SkyPropertyEditorPadding">7,1</Thickness>

    <!--
        Tab card geometry: the card is inset on three sides but stays flush with the footer it sits
        above, and its 1px border is only ever overlapped by a 1px shift, never by a ramp step.
    -->
    <Thickness x:Key="SkyTabCardMargin">8,8,8,0</Thickness>
    <Thickness x:Key="SkyTabCardBorderOverlap">0,-1,0,0</Thickness>
    <Thickness x:Key="SkyTabCardHeaderHoverInset">0,0,0,1</Thickness>

    <!--
        Values that used to be hand-tuned pixels and are now declared once, with their coupling.
        The editor cancels SkyControlPadding; the hint aligns under the label of the checkbox above it.
    -->
    <Thickness x:Key="SkyControlPaddingInverse">-8,-4</Thickness>
    <Thickness x:Key="SkyCheckboxHintIndent">28,0,0,0</Thickness>

    <!-- Icon slot: the 16px toolbar button image and the matching glyphs in the Options toolbar lists (issue #933). -->
    <x:Double x:Key="SkyIconSize">16</x:Double>

    <!--
        Status icon picker (issue #1214). The popup imitates the Windows emoji panel: a 360px
        surface wide enough for a wrapping tile grid, 32px tiles that center the 16px glyph, and
        a scroll cap that keeps the popup shorter than the Statuses page it opens over.
    -->
    <x:Double x:Key="SkyIconPickerWidth">360</x:Double>
    <x:Double x:Key="SkyIconTileSize">32</x:Double>
    <x:Double x:Key="SkyIconGridMaxHeight">220</x:Double>
    <Thickness x:Key="SkyIconCategoryPadding">6,2,6,4</Thickness>

    <!--
        Menu rhythm (issue #1003): the menu bar, the browser/tree/details context menus and any
        plugin context menu share one row metric set. Padding is a composed thickness because
        XAML cannot assemble a Thickness from the scalar spacing ramp.
    -->
    <x:Double x:Key="SkyMenuItemMinHeight">22</x:Double>
    <Thickness x:Key="SkyMenuItemPadding">8,2</Thickness>
    <x:Double x:Key="SkyMenuGutterWidth">20</x:Double>
    <Thickness x:Key="SkyMenuIconMargin">2</Thickness>
    <x:Double x:Key="SkyMenuArrowColumnWidth">20</x:Double>
    <x:Double x:Key="SkyMenuSeparatorHeight">1</x:Double>
    <x:Double x:Key="SkyMenuSeparatorRowHeight">9</x:Double>

    <CornerRadius x:Key="SkyCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="SkyCornerRadiusLarge">8</CornerRadius>

    <!-- Type scale: caption/small, secondary, body, subtitle, title, window title. -->
    <x:Double x:Key="SkyFontCaption">11</x:Double>
    <x:Double x:Key="SkyFontSecondary">12</x:Double>
    <x:Double x:Key="SkyFontBody">14</x:Double>
    <x:Double x:Key="SkyFontSubtitle">16</x:Double>
    <x:Double x:Key="SkyFontTitle">20</x:Double>
    <x:Double x:Key="SkyFontWindowTitle">24</x:Double>

    <!-- Classic Windows look, with the packaged Inter font as the cross-platform fallback. -->
    <FontFamily x:Key="SkyFontFamily">Segoe UI, Inter</FontFamily>
    <!-- Template and code editors: fixed pitch so columns line up. -->
    <FontFamily x:Key="SkyFontFamilyMono">Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
</ResourceDictionary>
