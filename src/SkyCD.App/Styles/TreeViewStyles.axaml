<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Theme Resources -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TreeViewActiveSelectionBackgroundBrush" Color="#D4E2FF" />
                    <SolidColorBrush x:Key="TreeViewActiveSelectionForegroundBrush" Color="#1E1F22" />
                    <SolidColorBrush x:Key="TreeViewInactiveSelectionBackgroundBrush" Color="#E4E6EB" />
                    <SolidColorBrush x:Key="TreeViewInactiveSelectionForegroundBrush" Color="#1E1F22" />
                </ResourceDictionary>

                <!-- Dark Theme Resources -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TreeViewActiveSelectionBackgroundBrush" Color="#2A4371" />
                    <SolidColorBrush x:Key="TreeViewActiveSelectionForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TreeViewInactiveSelectionBackgroundBrush" Color="#2B2D30" />
                    <SolidColorBrush x:Key="TreeViewInactiveSelectionForegroundBrush" Color="#DFE1E5" />
                </ResourceDictionary>

                <!-- Default Fallback Theme Resources -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TreeViewActiveSelectionBackgroundBrush" Color="#2A4371" />
                    <SolidColorBrush x:Key="TreeViewActiveSelectionForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TreeViewInactiveSelectionBackgroundBrush" Color="#2B2D30" />
                    <SolidColorBrush x:Key="TreeViewInactiveSelectionForegroundBrush" Color="#DFE1E5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- TreeView container styling -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
        <Setter Property="Padding" Value="2,4" />
    </Style>

    <!-- TreeViewItem row height and spacing matching modern IDE tree -->
    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>

    <Style Selector="TreeViewItem /template/ Border#SelectionBorder">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="4,1" />
    </Style>

    <!-- Base selected state -->
    <Style Selector="TreeViewItem:selected /template/ Border#SelectionBorder">
        <Setter Property="Background" Value="{DynamicResource TreeViewActiveSelectionBackgroundBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TreeViewActiveSelectionForegroundBrush}" />
    </Style>

    <!-- Inactive selection: high-contrast styling when TreeView loses focus -->
    <Style Selector="TreeViewItem:selected:not(:focus) /template/ Border#SelectionBorder">
        <Setter Property="Background" Value="{DynamicResource TreeViewInactiveSelectionBackgroundBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected:not(:focus)">
        <Setter Property="Foreground" Value="{DynamicResource TreeViewInactiveSelectionForegroundBrush}" />
    </Style>

    <!-- Active selection: high-contrast highlighted text and background when focused -->
    <Style Selector="TreeViewItem:selected:focus /template/ Border#SelectionBorder">
        <Setter Property="Background" Value="{DynamicResource TreeViewActiveSelectionBackgroundBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected:focus">
        <Setter Property="Foreground" Value="{DynamicResource TreeViewActiveSelectionForegroundBrush}" />
    </Style>

</Styles>
