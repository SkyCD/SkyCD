<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TabCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TabCardBorderBrush" Color="#ADADAD" />
                    <SolidColorBrush x:Key="TabHeaderForegroundBrush" Color="#505050" />
                    <SolidColorBrush x:Key="TabHeaderHoverBrush" Color="#E8E8E8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TabCardBackgroundBrush" Color="#282828" />
                    <SolidColorBrush x:Key="TabCardBorderBrush" Color="#666666" />
                    <SolidColorBrush x:Key="TabHeaderForegroundBrush" Color="#C6C6C6" />
                    <SolidColorBrush x:Key="TabHeaderHoverBrush" Color="#3A3A3A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ControlTheme x:Key="CardTabControlTheme" TargetType="TabControl">
                <Setter Property="Background" Value="{DynamicResource TabCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TabCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <!-- One content inset for every card tab surface; window markup must not re-pad tab bodies. -->
                <Setter Property="Padding" Value="{DynamicResource SkyInsetMd}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid RowDefinitions="Auto,*">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                            ZIndex="1" />
                            <!-- The selected header covers the top border where it meets the page. -->
                            <Border Grid.Row="1"
                                    Margin="{DynamicResource SkyTabCardBorderOverlap}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Panel ClipToBounds="True">
                                    <ContentPresenter Name="PART_SelectedContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <ContentPresenter Name="PART_SelectedContentHost2"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      IsVisible="False" />
                                </Panel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="CardTabItemTheme" TargetType="TabItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1,1,1,0" />
                <Setter Property="Foreground" Value="{DynamicResource TabHeaderForegroundBrush}" />
                <Setter Property="Padding" Value="{DynamicResource SkyTabHeaderPadding}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border Name="HoverBackground"
                                    Margin="{DynamicResource SkyTabCardHeaderHoverInset}"
                                    Background="{DynamicResource TabHeaderHoverBrush}"
                                    IsHitTestVisible="False"
                                    IsVisible="False" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              RecognizesAccessKey="True" />
                            <Border Name="FocusOutline"
                                    Margin="{DynamicResource SkyInsetXs}"
                                    BorderBrush="{DynamicResource ThemeForegroundBrush}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False"
                                    IsVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover:not(:selected):not(:disabled) /template/ Border#HoverBackground">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{DynamicResource TabCardBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TabCardBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#FocusOutline">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Opacity" Value="{DynamicResource ThemeDisabledOpacity}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="TabControl[TabStripPlacement=Top]">
        <Setter Property="Theme" Value="{StaticResource CardTabControlTheme}" />
    </Style>
    <Style Selector="TabControl[TabStripPlacement=Top] > TabItem">
        <Setter Property="Theme" Value="{StaticResource CardTabItemTheme}" />
    </Style>
</Styles>
