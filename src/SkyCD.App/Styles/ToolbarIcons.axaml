    <StreamGeometry x:Key="ToolbarIcon.ViewLargeIcons">F0 M0.5,0.5 L7.5,0.5 L7.5,6.5 L0.5,6.5 Z M9.5,2.5 L15.5,2.5 L15.5,4.5 L9.5,4.5 Z M0.5,8.5 L7.5,8.5 L7.5,15.5 L0.5,15.5 Z M9.5,8.5 L14.5,8.5 L14.5,10.5 L9.5,10.5 Z M9.5,12.5 L12.5,12.5 L12.5,14.5 L9.5,14.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolbarIcon.ViewList">F0 M3.5,0.5 L5.5,0.5 L5.5,2.5 L3.5,2.5 Z M8.5,0.5 L15.5,0.5 L15.5,2.5 L8.5,2.5 Z M3.5,5.5 L5.5,5.5 L5.5,8.5 L3.5,8.5 Z M8.5,5.5 L12.5,5.5 L12.5,8.5 L8.5,8.5 Z M3.5,10.5 L5.5,10.5 L5.5,13.5 L3.5,13.5 Z M8.5,10.5 L15.5,10.5 L15.5,13.5 L8.5,13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolbarIcon.ViewDetails">F0 M0.5,0.5 L6.5,0.5 L6.5,4.5 L0.5,4.5 Z M8.5,1.5 L15.5,1.5 L15.5,3.5 L8.5,3.5 Z M0.5,6.5 L15.5,6.5 L15.5,7.5 L0.5,7.5 Z M0.5,9.5 L15.5,9.5 L15.5,10.5 L0.5,10.5 Z M0.5,12.5 L15.5,12.5 L15.5,13.5 L0.5,13.5 Z</StreamGeometry>

    <!-- Panes: the shown pane is the filled part (outer frame minus the other pane). -->
    <StreamGeometry x:Key="ToolbarIcon.StatusBar">F0 M0.5,1.5 L15.5,1.5 L15.5,14.5 L0.5,14.5 Z M0.5,1.5 L15.5,1.5 L15.5,9.5 L0.5,9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolbarIcon.PreviewPane">F0 M0.5,1.5 L15.5,1.5 L15.5,14.5 L0.5,14.5 Z M0.5,1.5 L9.5,1.5 L9.5,14.5 L0.5,14.5 Z</StreamGeometry>

