<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="SkyCD.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SkyCD.App/Styles/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The packaged IconPacks theme was compiled against an older Avalonia binding API. -->
            <ControlTheme x:Key="{x:Type iconPacks:PackIconControl}" TargetType="iconPacks:PackIconControl">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Path Data="{TemplateBinding Data}"
                              Fill="{TemplateBinding Foreground}"
                              Stretch="Uniform"
                              UseLayoutRounding="False" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://SkyCD.App/Styles/GlobalStyles.axaml" />
        <StyleInclude Source="avares://SkyCD.App/Styles/TabControlStyles.axaml" />
        <StyleInclude Source="avares://SkyCD.App/Styles/IconStyles.axaml" />
        <StyleInclude Source="avares://SkyCD.App/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="avares://SkyCD.App/Styles/TreeViewStyles.axaml" />
        <StyleInclude Source="avares://SkyCD.App/Styles/MenuStyles.axaml" />
    </Application.Styles>
</Application>
