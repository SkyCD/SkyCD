<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:split="clr-namespace:SkyCD.Presentation.Catalog.Split;assembly=SkyCD.Presentation"
        x:Class="SkyCD.App.Views.SplitWindow"
        x:DataType="vm:SplitDialogViewModel"
        Width="620"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.SplitDialogTitle}}">

    <DockPanel Margin="{DynamicResource SkyInsetMd}">
        <StackPanel DockPanel.Dock="Bottom" Spacing="{DynamicResource SkySpaceXs}"
                    Margin="{DynamicResource SkyGapTopMd}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource SkyErrorForeground}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="{DynamicResource SkySpaceSm}">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.SplitAction}}"
                        Command="{Binding SplitCommand}" MinWidth="90" IsDefault="True" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                        Command="{Binding CancelCommand}" MinWidth="90"
                        IsEnabled="{Binding IsBusy}" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Close}}"
                        MinWidth="90" IsCancel="True" Click="OnCloseClicked" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="{DynamicResource SkySpaceSm}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitSourceCatalog}}" />
                <TextBlock Text="{Binding SourceName}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EntrySummary}" Classes="caption" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitOutputFolder}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceXs}">
                    <TextBox Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.SplitOutputFolder}}" />
                    <Button Grid.Column="1" Content="{i18n:Translate {x:Static i18n:UiKeys.Browse}}"
                            Click="OnBrowseClicked" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitFileNamePattern}}" />
                <TextBox Text="{Binding FileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.SplitFileNamePattern}}" />
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitPatternHint}}"
                           Classes="caption" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SkySpaceMd}">
                <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitEntriesPerPart}}" />
                    <TextBox Text="{Binding EntriesPerPart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.SplitEntriesPerPart}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource SkySpaceXxs}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitPartSize}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceXs}">
                        <TextBox Text="{Binding PartSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.SplitPartSize}}" />
                        <ComboBox Grid.Column="1" MinWidth="88"
                                  ItemsSource="{Binding SizeUnits}"
                                  SelectedItem="{Binding PartSizeUnit, Mode=TwoWay}"
                                  AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.SplitPartSize}}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SplitSavingFormat}}" />
                <ComboBox ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedSplitFormat, Mode=TwoWay}"
                          AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.SplitSavingFormat}}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="split:SplitFormatOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
