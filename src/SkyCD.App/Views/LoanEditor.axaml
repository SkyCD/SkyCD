<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
             xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
             x:Class="SkyCD.App.Views.LoanEditor"
             x:DataType="vm:LoanDialogViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="5">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Borrower}}" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Borrowers}" SelectedItem="{Binding SelectedBorrower}"
                      AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Borrower}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{ReflectionBinding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                <TextBox Text="{Binding ContactName}" PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.BorrowerName}}" />
                <Button Grid.Column="1" Content="{i18n:Translate {x:Static i18n:UiKeys.AddBorrower}}" Command="{Binding AddBorrowerCommand}" />
                <Button Grid.Column="2" Content="{i18n:Translate {x:Static i18n:UiKeys.RenameBorrower}}" Command="{Binding RenameBorrowerCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.LoanDateLabel}}" />
                    <TextBox Text="{Binding LoanDate}" PlaceholderText="YYYY-MM-DD"
                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.LoanDateLabel}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.LoanDueLabel}}" />
                    <TextBox Text="{Binding DueDate}" PlaceholderText="YYYY-MM-DD"
                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.LoanDueLabel}}" />
                </StackPanel>
            </Grid>
            <TextBox Text="{Binding Note}" PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.LoanNote}}" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MarkLent}}" Command="{Binding MarkLentCommand}" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MarkReturned}}" Command="{Binding MarkReturnedCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.LoanHistory}}" />
            <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedLoan}" MaxHeight="160"
                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.LoanHistory}}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoanHistoryRow">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.LoanChangesSave}}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
