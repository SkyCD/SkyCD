<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
             xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
             x:Class="SkyCD.App.Views.RemoteCredentialsForm"
             x:DataType="vm:LoginDialogViewModel">
    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="130,*" ColumnSpacing="10" IsVisible="{Binding IsSftp}">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AuthenticationMethod}}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AuthMethodNames}" SelectedIndex="{Binding AuthMethodIndex}" />
        </Grid>

        <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Username}}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Username}" IsEnabled="{Binding IsCredentialEntryEnabled}" />
        </Grid>

        <Grid ColumnDefinitions="130,*" ColumnSpacing="10" IsVisible="{Binding IsSmb}">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Domain}}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Domain}" />
        </Grid>

        <Grid ColumnDefinitions="130,*" ColumnSpacing="10" MinHeight="28">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Password}}"
                       IsVisible="{Binding IsPasswordAuthentication}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" PasswordChar="*" Text="{Binding Password}"
                     IsEnabled="{Binding IsCredentialEntryEnabled}" IsVisible="{Binding IsPasswordAuthentication}" />
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.KeyFile}}"
                       IsVisible="{Binding IsKeyAuthentication}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding IsKeyAuthentication}">
                <TextBox Text="{Binding KeyFilePath}" />
                <Button Grid.Column="1"
                        Content="{i18n:Translate {x:Static i18n:UiKeys.Browse}}"
                        Click="OnBrowseKeyFileClicked" />
            </Grid>
        </Grid>

        <Grid ColumnDefinitions="130,*" ColumnSpacing="10" MinHeight="28" IsVisible="{Binding IsSftp}">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.KeyPassphrase}}"
                       IsVisible="{Binding IsKeyAuthentication}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" PasswordChar="*" Text="{Binding KeyFilePassphrase}"
                     IsVisible="{Binding IsKeyAuthentication}" />
        </Grid>

        <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AnonymousAccess}}"
                  IsChecked="{Binding UseAnonymous}" IsVisible="{Binding IsAnonymousAvailable}" />

        <Grid ColumnDefinitions="130,*" ColumnSpacing="10" IsVisible="{Binding IsFtp}">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.TlsMode}}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TlsModeNames}" SelectedIndex="{Binding TlsModeIndex}" />
        </Grid>

        <Grid ColumnDefinitions="130,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto"
              RowSpacing="4" IsVisible="{Binding IsSftp}">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.HostKey}}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding HostKeyFingerprint, Mode=OneWay}" IsReadOnly="True"
                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.HostKey}}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CheckHostKey}}"
                        Command="{Binding CheckHostKeyCommand}" />
                <Button Content="{Binding HostKeyTrustButtonLabel}"
                        Command="{Binding TrustHostKeyCommand}" IsVisible="{Binding IsHostKeyTrustAvailable}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding HostKeyStatus}" TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</UserControl>
