<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
        x:Class="SkyCD.App.Views.LocationsWindow"
        x:DataType="vm:LocationsDialogViewModel"
        Title="{i18n:Translate {x:Static i18n:UiKeys.ManageLocations}}"
        Width="560" Height="480"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/skycd.ico">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="Gray" />
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Close}}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="90" />
        </StackPanel>
        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Translate {x:Static i18n:UiKeys.Locations}}" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox x:Name="PART_LocationList" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" MinHeight="180"
                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Locations}}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocationItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding UsageCount, StringFormat='({0})'}" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NewLocation}}" />
                <TextBox Text="{Binding NewLocationName, Mode=TwoWay}" AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.LocationName}}" />
                <Button x:Name="PART_CreateButton" Content="{i18n:Translate {x:Static i18n:UiKeys.NewLocation}}" Command="{Binding CreateLocationCommand}" />
                <Separator Margin="0,6,0,6" />
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.RenameLocation}}" />
                <TextBox Text="{Binding RenameTo, Mode=TwoWay}" AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.RenameLocation}}" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.RenameLocation}}" Command="{Binding RenameLocationCommand}" />
                <Separator Margin="0,6,0,6" />
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.MergeInto}}" />
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding MergeTarget, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationItemViewModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MergeLocations}}" Command="{Binding MergeLocationsCommand}" />
                <Separator Margin="0,6,0,6" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.DeleteLocation}}" Command="{Binding DeleteLocationCommand}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Spacing="6">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.ShowItems}}" Command="{Binding ShowItemsCommand}" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding FilterResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" MaxHeight="120"
                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.AssignedItems}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogFindResult">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Document.Name}" />
                                <TextBlock Text="{Binding FullPath}" Foreground="Gray" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.OpenResult}}" Command="{Binding NavigateToSelectedCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
