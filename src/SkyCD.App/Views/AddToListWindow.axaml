<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
        xmlns:converters="using:SkyCD.App.Converters"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:views="using:SkyCD.App.Views"
        x:Class="SkyCD.App.Views.AddToListWindow"
        x:DataType="vm:AddToListDialogViewModel"
        Classes="compact"
        Width="445"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.AddToList}}">

    <Design.DataContext>
        <vm:AddToListDialogViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:InternetProtocolIconConverter x:Key="InternetProtocolIcon" />
        <converters:SourceIconImageConverter x:Key="SourceIconImage" />
        <!-- Issue #1030: the dropdown rows share the closed field's inset. -->
        <ControlTheme x:Key="SourceComboBoxItemTheme"
                      TargetType="ComboBoxItem"
                      BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="{DynamicResource SkyComboBoxContentPadding}" />
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.source">
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="{DynamicResource SkyInsetXxs}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.source.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#7A7A7A" />
            <Setter Property="Background" Value="#207A7A7A" />
        </Style>
        <Style Selector="Button.source:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBox.source-field, ComboBox.source-field, Button.source-field">
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="{DynamicResource SkyComboBoxContentPadding}" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource SourceComboBoxItemTheme}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid"
          Margin="{DynamicResource SkyWindowPadding}"
          RowDefinitions="*,Auto"
          ColumnDefinitions="89,*"
          ColumnSpacing="{DynamicResource SkySpaceSm}">
        <Border x:Name="SourcePanel"
                Grid.Row="0"
                Grid.Column="0"
                BorderBrush="#B0B0B0"
                BorderThickness="1"
                Padding="{DynamicResource SkyInsetXxs}">
            <StackPanel VerticalAlignment="Top">
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceMedia}"
                        IsEnabled="{Binding CanUseMedia}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Media">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{Binding Converter={StaticResource SourceIconImage}, ConverterParameter=Media}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromMedia}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceFolder}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Folder">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{Binding Converter={StaticResource SourceIconImage}, ConverterParameter=Folder}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromFolder}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceInternet}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Internet">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{Binding Converter={StaticResource SourceIconImage}, ConverterParameter=Internet}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromInternet}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceTitleOnly}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="TitleOnly">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{Binding Converter={StaticResource SourceIconImage}, ConverterParameter=TitleOnly}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.TitleOnly}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentColumn"
              Grid.Row="0"
              Grid.Column="1"
              RowDefinitions="Auto,*,Auto">
            <!--
                Issue #942: the name/Location block and the source fields each own a sizing row spaced by
                the token ramp instead of sharing a fixed 6 px row, so no section can draw over its neighbour.
            -->
            <Grid x:Name="FormFieldsGrid"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="{DynamicResource SkySpaceXs}">
                <StackPanel x:Name="NameLocationBlock" Spacing="{DynamicResource SkySpaceXs}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectMediaName}}" />
                    <TextBox Classes="source-field" Text="{Binding MediaName}" />
                    <StackPanel IsVisible="{Binding IsLocationPickerVisible}" Spacing="{DynamicResource SkySpaceXs}">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Location}}" />
                        <ComboBox Classes="source-field"
                                  ItemsSource="{Binding LocationChoices}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Location}}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocationItemViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!--
                    The source-specific fields scroll when a tab needs more room than the fixed window
                    height allows (#823 keeps the window size fixed, #942 the content is never clipped).
                -->
                <ScrollViewer x:Name="SourceFieldsScrollViewer"
                              Grid.Row="1"
                              MaxHeight="{DynamicResource SkyFormFieldsMaxHeight}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="SourceDetailsPanel" VerticalAlignment="Top" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0"
                                    IsVisible="{Binding HasMultipleDroppedRoots}"
                                    Spacing="{DynamicResource SkySpaceXs}"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.DroppedRoots}}" />
                            <ComboBox Classes="source-field"
                                      ItemsSource="{Binding DroppedRoots}"
                                      SelectedItem="{Binding SelectedDroppedRoot}"
                                      AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.DroppedRoots}}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DroppedSource">
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceMedia}" Spacing="{DynamicResource SkySpaceXs}" VerticalAlignment="Top">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectDrive}}" />
                            <ComboBox Classes="source-field"
                                      ItemsSource="{Binding AvailableDrives}"
                                      SelectedItem="{Binding SelectedDrive}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.IncludeMediaInfo}}"
                                      IsChecked="{Binding IncludeMediaInfo}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFolders}}"
                                      IsChecked="{Binding IncludeSubfolders}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFiles}}"
                                      IsChecked="{Binding IncludeFiles}" />
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectedRootAlwaysAdded}}"
                                       Foreground="#666666"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceFolder}" Spacing="{DynamicResource SkySpaceXs}" VerticalAlignment="Top">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectFolder}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <TextBox Classes="source-field" Text="{Binding SourceValue}" />
                                <Button Grid.Column="1"
                                        Classes="source-field"
                                        Content="..."
                                        Width="28"
                                        Click="OnBrowseFolderClicked" />
                            </Grid>
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFolders}}"
                                      IsChecked="{Binding IncludeSubfolders}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFiles}}"
                                      IsChecked="{Binding IncludeFiles}" />
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectedRootAlwaysAdded}}"
                                       Foreground="#666666"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceInternet}" Spacing="{DynamicResource SkySpaceXs}" VerticalAlignment="Top">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <ComboBox x:Name="InternetProtocolComboBox"
                                          Classes="source-field"
                                          ItemsSource="{Binding InternetProtocols}"
                                          SelectedItem="{Binding InternetProtocol}"
                                          AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.InternetProtocol}}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                                <iconPacks:PackIconControl Width="16" Height="16"
                                                                           Kind="{Binding Converter={StaticResource InternetProtocolIcon}}"
                                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        x:Name="PasteInternetUrlButton"
                                        IsEnabled="False"
                                        Content="{i18n:Translate {x:Static i18n:UiKeys.PasteInternetUrl}}"
                                        Click="OnPasteInternetUrlClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,72" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}" RowSpacing="{DynamicResource SkySpaceXs}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.InternetHost}}" />
                                <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}" />
                                <TextBox Grid.Row="1" Classes="source-field" Text="{Binding InternetHost}"
                                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.InternetHost}}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Classes="source-field"
                                         Text="{Binding InternetPort}" PlaceholderText="{Binding SuggestedInternetPort}" MaxLength="5"
                                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Port}}" />
                            </Grid>
                            <TextBlock IsVisible="{Binding !IsSmbInternetProtocol}"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.InternetPath}}" />
                            <TextBlock IsVisible="{Binding IsSmbInternetProtocol}"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.InternetSharePath}}" />
                            <TextBox Classes="source-field" Text="{Binding InternetPath}" />
                            <views:RemoteCredentialsForm DataContext="{Binding InternetCredentials}" />
                            <StackPanel Spacing="{DynamicResource SkySpaceXs}" IsVisible="{Binding !InternetCredentials.IsSftp}">
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CheckHostKey}}"
                                        Command="{Binding CheckInternetConnectionCommand}" />
                                <TextBlock Text="{Binding InternetCheckStatus}" TextWrapping="Wrap"
                                           IsVisible="{Binding InternetCheckStatus, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   IsVisible="{Binding IsSourceTitleOnly}"
                                   VerticalAlignment="Top"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.TitleOnlyMediaHint}}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>

            </Grid>

            <!--
                The destination radios render directly in the content column. The radios and the
                actions share the bottom row so OK/Cancel stay pinned to the window edge (#823, #1031).
            -->
            <Grid x:Name="DestinationSection" Grid.Row="2" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="TargetPlacementGroup"
                            Spacing="{DynamicResource SkySpaceSm}"
                            Margin="{DynamicResource SkyGapTopXs}">
                    <RadioButton Content="{i18n:Translate {x:Static i18n:UiKeys.AsNewMedia}}"
                                 IsChecked="{Binding IsTargetNewMedia, Mode=OneWay}"
                                 Command="{Binding SelectTargetCommand}"
                                 CommandParameter="NewMedia" />
                    <RadioButton Content="{i18n:Translate {x:Static i18n:UiKeys.ToSelectedMediaFolder}}"
                                 IsChecked="{Binding IsTargetSelectedFolder, Mode=OneWay}"
                                 Command="{Binding SelectTargetCommand}"
                                 CommandParameter="SelectedFolder" />
                    <TextBlock x:Name="TargetParentDescriptionText"
                               Margin="{DynamicResource SkyGapTopXs}"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasTargetParentDescription}"
                               Text="{Binding TargetParentDescription}" />
                </StackPanel>

                <StackPanel x:Name="DialogActions"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{DynamicResource SkyGapBottomXxs}"
                            Spacing="{DynamicResource SkySpaceSm}">
                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                            Width="72"
                            Height="25"
                            Command="{Binding ConfirmCommand}" />
                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                            Width="72"
                            Height="25"
                            Click="OnCancelClicked" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock x:Name="ValidationMessageText"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   MinHeight="14"
                   Foreground="#B00000"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
