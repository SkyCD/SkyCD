<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:accounts="clr-namespace:SkyCD.Presentation.Accounts;assembly=SkyCD.Presentation"
        xmlns:capture="clr-namespace:SkyCD.SDK.Capabilities.Capture;assembly=SkyCD.SDK"
        xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
        xmlns:converters="using:SkyCD.App.Converters"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:icons="using:SkyCD.App.Icons"
        xmlns:views="using:SkyCD.App.Views"
        x:Class="SkyCD.App.Views.AddToListWindow"
        x:DataType="vm:AddToListDialogViewModel"
        Classes="compact"
        Width="445"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.AddToList}}">

    <Design.DataContext>
        <vm:AddToListDialogViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:InternetProtocolIconConverter x:Key="InternetProtocolIcon" />
        <!-- Issue #1030: the dropdown rows share the closed field's inset. -->
        <ControlTheme x:Key="SourceComboBoxItemTheme"
                      TargetType="ComboBoxItem"
                      BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="{DynamicResource SkyComboBoxContentPadding}" />
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.source">
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="{DynamicResource SkyInsetXxs}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.source.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SkySourceSelectedBorder}" />
            <Setter Property="Background" Value="{DynamicResource SkySourceSelectedBackground}" />
        </Style>
        <Style Selector="Button.source:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBox.source-field, ComboBox.source-field, Button.source-field">
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="{DynamicResource SkyComboBoxContentPadding}" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource SourceComboBoxItemTheme}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid"
          Margin="{DynamicResource SkyWindowPadding}"
          RowDefinitions="*,Auto"
         
          ColumnSpacing="{DynamicResource SkySpaceSm}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SkyAddToListSourceWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="SourcePanel"
                Grid.Row="0"
                Grid.Column="0"
                BorderBrush="{DynamicResource SkySourcePanelBorder}"
                BorderThickness="1"
                Padding="{DynamicResource SkyInsetXxs}">
            <StackPanel VerticalAlignment="Top">
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceMedia}"
                        IsEnabled="{Binding CanUseMedia}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Media">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{x:Static icons:SourceIcons.Media}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromMedia}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceFolder}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Folder">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{x:Static icons:SourceIcons.Folder}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromFolder}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceInternet}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Internet">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{x:Static icons:SourceIcons.Internet}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromInternet}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceTitleOnly}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="TitleOnly">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{x:Static icons:SourceIcons.TitleOnly}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.TitleOnly}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceFromAccount}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="FromAccount">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{x:Static icons:SourceIcons.Account}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromAccount}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <!-- Plugin-contributed capture types only take a slot while an enabled plugin provides one. -->
                <Button Classes="source"
                        IsVisible="{Binding HasCaptureProviders}"
                        Classes.selected="{Binding IsSourceCapture}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="CaptureSource">
                    <StackPanel Spacing="{DynamicResource SkySpaceXs}" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               Source="{x:Static icons:SourceIcons.Capture}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CaptureSource}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentColumn"
              Grid.Row="0"
              Grid.Column="1"
              RowDefinitions="Auto,*,Auto">
            <!--
                Issue #942: the name/Location block owns the top sizing row so no section can draw
                over its neighbour. Issue #1150: the source fields own the star row below it, so
                they use the full remaining height and scroll only inside their own border.
            -->
            <StackPanel x:Name="NameLocationBlock"
                        IsVisible="{Binding IsNameEntryVisible}"
                        Margin="{DynamicResource SkyGapBottomXs}"
                        Spacing="{DynamicResource SkySpaceSm}">
                <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectMediaName}}" />
                    <TextBox Classes="source-field" Text="{Binding MediaName}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsLocationPickerVisible}" Spacing="{DynamicResource SkySpaceXs}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PhysicalLocation}}" />
                    <ComboBox Classes="source-field"
                              ItemsSource="{Binding LocationChoices}"
                              SelectedItem="{Binding SelectedLocation}"
                              AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PhysicalLocation}}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationItemViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="caption"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.PhysicalLocationHint}}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock IsVisible="{Binding IsScannedPathNoteVisible}"
                           Classes="caption"
                           Text="{i18n:Translate {x:Static i18n:UiKeys.LocationFromScannedPath}}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!--
                The source-specific fields use the remaining height and scroll when a tab needs more
                room than the fixed window height allows (#823 keeps the window size fixed, #942 the
                content is never clipped, #1150 the star row is no longer capped).
            -->
            <ScrollViewer x:Name="SourceFieldsScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="SourceDetailsPanel" VerticalAlignment="Top" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0"
                                IsVisible="{Binding HasMultipleDroppedRoots}"
                                Spacing="{DynamicResource SkySpaceXs}"
                                VerticalAlignment="Top">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.DroppedRoots}}" />
                        <ComboBox Classes="source-field"
                                  ItemsSource="{Binding DroppedRoots}"
                                  SelectedItem="{Binding SelectedDroppedRoot}"
                                  AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.DroppedRoots}}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DroppedSource">
                                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceMedia}" Spacing="{DynamicResource SkySpaceXs}" VerticalAlignment="Top">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectDrive}}" />
                        <ComboBox Classes="source-field"
                                  ItemsSource="{Binding AvailableDrives}"
                                  SelectedItem="{Binding SelectedDrive}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.IncludeMediaInfo}}"
                                  IsChecked="{Binding IncludeMediaInfo}" />
                        <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFolders}}"
                                  IsChecked="{Binding IncludeSubfolders}" />
                        <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFiles}}"
                                  IsChecked="{Binding IncludeFiles}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectedRootAlwaysAdded}}"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceFolder}" Spacing="{DynamicResource SkySpaceSm}" VerticalAlignment="Top">
                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectFolder}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <TextBox Classes="source-field" Text="{Binding SourceValue}" />
                                <Button Grid.Column="1"
                                        Classes="source-field"
                                        Content="..."
                                        Width="28"
                                        Click="OnBrowseFolderClicked" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFolders}}"
                                      IsChecked="{Binding IncludeSubfolders}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFiles}}"
                                      IsChecked="{Binding IncludeFiles}" />
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectedRootAlwaysAdded}}"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceInternet}" Spacing="{DynamicResource SkySpaceXs}" VerticalAlignment="Top">
                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.InternetProtocol}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <ComboBox x:Name="InternetProtocolComboBox"
                                          Classes="source-field"
                                          ItemsSource="{Binding InternetProtocols}"
                                          SelectedItem="{Binding InternetProtocol}"
                                          AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.InternetProtocol}}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                                <iconPacks:PackIconControl Width="16" Height="16"
                                                                           Kind="{Binding Converter={StaticResource InternetProtocolIcon}}"
                                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        x:Name="PasteInternetUrlButton"
                                        Classes="source-field"
                                        IsEnabled="False"
                                        Content="{i18n:Translate {x:Static i18n:UiKeys.PasteInternetUrl}}"
                                        Click="OnPasteInternetUrlClicked" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,72" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}" RowSpacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.InternetHost}}" />
                            <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}" />
                            <TextBox Grid.Row="1" Classes="source-field" Text="{Binding InternetHost}"
                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.InternetHost}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Classes="source-field"
                                     Text="{Binding InternetPort}" PlaceholderText="{Binding SuggestedInternetPort}" MaxLength="5"
                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Port}}" />
                        </Grid>
                        <TextBlock IsVisible="{Binding !IsSmbInternetProtocol}"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.InternetPath}}" />
                        <TextBlock IsVisible="{Binding IsSmbInternetProtocol}"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.InternetSharePath}}" />
                        <TextBox Classes="source-field" Text="{Binding InternetPath}" />
                        <views:RemoteCredentialsForm DataContext="{Binding InternetCredentials}" />
                        <StackPanel Spacing="{DynamicResource SkySpaceXs}" IsVisible="{Binding !InternetCredentials.IsSftp}">
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CheckHostKey}}"
                                    Command="{Binding CheckInternetConnectionCommand}" />
                            <TextBlock Text="{Binding InternetCheckStatus}" TextWrapping="Wrap"
                                       IsVisible="{Binding InternetCheckStatus, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceFromAccount}" Spacing="{DynamicResource SkySpaceXs}" VerticalAlignment="Top">
                        <StackPanel IsVisible="{Binding ShowAccountEmptyState}" Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AccountNoConnected}}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AvailableAccountConnectors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountConnectorItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                            <TextBlock Text="{Binding ProviderName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Content="{i18n:Translate {x:Static i18n:UiKeys.AccountConnect}}"
                                                    Command="{Binding $parent[Window].DataContext.ConnectAccountCommand}"
                                                    CommandParameter="{Binding Session}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock IsVisible="{Binding AccountConnectError, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}"
                                       Classes="caption"
                                       Text="{Binding AccountConnectError}"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding IsAccountConnecting}"
                                       Classes="caption"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AccountWorking}}"
                                       TextWrapping="Wrap" />
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AccountOpenSettings}}"
                                    HorizontalAlignment="Left"
                                    Click="OnOpenAccountSettingsClicked"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AccountOpenSettings}}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding ShowAccountPicker}" Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Accounts}}" />
                            <TextBlock IsVisible="{Binding SelectedAccountNeedsSignIn}"
                                       Classes="caption"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AccountNotSignedIn}}"
                                       TextWrapping="Wrap" />
                            <ComboBox Classes="source-field"
                                      ItemsSource="{Binding AccountChoices}"
                                      SelectedItem="{Binding SelectedAccount}"
                                      AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Accounts}}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AddToListAccountChoice">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="caption"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AccountAddHint}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AccountProductsHeader}}" />
                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding SelectedAccount.Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="accounts:AccountEntryPlan">
                                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="{DynamicResource SkyRowPadding}">
                                                <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="caption"
                                                               Opacity="0.7"
                                                               Text="{Binding Detail}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock IsVisible="{Binding ShowAccountNoProducts}"
                                       Classes="caption"
                                       Opacity="0.75"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AccountNoProducts}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" IsVisible="{Binding IsSourceCapture}" Spacing="{DynamicResource SkySpaceSm}" VerticalAlignment="Top">
                        <StackPanel IsVisible="{Binding IsCaptureProviderPickerVisible}" Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CapturePlugin}}" />
                            <ComboBox Classes="source-field"
                                      ItemsSource="{Binding CaptureProviders}"
                                      SelectedItem="{Binding SelectedCaptureProvider}"
                                      AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.CapturePlugin}}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="capture:ICaptureSourcePluginCapability">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CaptureSourceType}}" />
                            <ComboBox Classes="source-field"
                                      ItemsSource="{Binding CaptureKinds}"
                                      SelectedItem="{Binding SelectedCaptureKind}"
                                      AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.CaptureSourceType}}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="capture:CaptureSourceKind">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding ShowCaptureDevicePicker}" Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{Binding CaptureLocationLabel}" />
                            <ComboBox Classes="source-field"
                                      ItemsSource="{Binding CaptureDevices}"
                                      SelectedItem="{Binding SelectedCaptureDevice}"
                                      AutomationProperties.Name="{Binding CaptureLocationLabel}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="capture:CaptureDevice">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding ShowCaptureFilePicker}" Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{Binding CaptureLocationLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <TextBox Classes="source-field"
                                         Text="{Binding CaptureLocation}"
                                         AutomationProperties.Name="{Binding CaptureLocationLabel}" />
                                <Button Grid.Column="1"
                                        Classes="source-field"
                                        Content="..."
                                        Width="28"
                                        Click="OnBrowseCaptureSourceClicked" />
                            </Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding ShowCaptureLocationField}" Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{Binding CaptureLocationLabel}" />
                            <TextBox Classes="source-field"
                                     Text="{Binding CaptureLocation}"
                                     AutomationProperties.Name="{Binding CaptureLocationLabel}" />
                        </StackPanel>

                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CapturePreview}}"
                                    IsEnabled="{Binding !IsCapturePreviewRunning}"
                                    HorizontalAlignment="Left"
                                    Click="OnPreviewCaptureClicked" />
                            <TextBlock Text="{Binding CaptureMessage}"
                                       Foreground="{DynamicResource SkyErrorForeground}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CaptureMessage, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CaptureDestination}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <TextBox Classes="source-field"
                                         Text="{Binding CaptureDestination}"
                                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.CaptureDestination}}" />
                                <Button Grid.Column="1"
                                        Classes="source-field"
                                        Content="..."
                                        Width="28"
                                        Click="OnBrowseCaptureDestinationClicked" />
                            </Grid>
                            <TextBlock Classes="caption"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.CaptureDestinationHint}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CaptureLabel}}" />
                            <TextBox Classes="source-field"
                                     Text="{Binding CaptureLabel}"
                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.CaptureLabel}}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding IsSourceTitleOnly}"
                               VerticalAlignment="Top"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.TitleOnlyMediaHint}}"
                               TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>

            <!--
                The destination radios render directly in the content column. The radios and the
                actions share the bottom row so OK/Cancel stay pinned to the window edge (#823, #1031).
            -->
            <Grid x:Name="DestinationSection" Grid.Row="2" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="TargetPlacementGroup"
                            IsVisible="{Binding IsDestinationSectionVisible}"
                            Spacing="{DynamicResource SkySpaceSm}"
                            Margin="{DynamicResource SkyGapTopXs}">
                    <RadioButton Content="{i18n:Translate {x:Static i18n:UiKeys.AsNewMedia}}"
                                 IsChecked="{Binding IsTargetNewMedia, Mode=OneWay}"
                                 Command="{Binding SelectTargetCommand}"
                                 CommandParameter="NewMedia" />
                    <!--
                        The destination reads as the option's own second line so the value stays
                        attached to the choice that owns it (#1314), and vanishes with the choice.
                    -->
                    <RadioButton IsChecked="{Binding IsTargetSelectedFolder, Mode=OneWay}"
                                 Command="{Binding SelectTargetCommand}"
                                 CommandParameter="SelectedFolder">
                        <StackPanel>
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ToSelectedMediaFolder}}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="TargetParentDescriptionText"
                                       Classes="caption"
                                       Margin="{DynamicResource SkyGapTopXxs}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasTargetParentDescription}"
                                       Text="{Binding TargetParentDescription}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel x:Name="DialogActions"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{DynamicResource SkyGapBottomXxs}"
                            Spacing="{DynamicResource SkySpaceSm}">
                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                            Width="72"
                            Height="25"
                            Command="{Binding ConfirmCommand}" />
                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                            Width="72"
                            Height="25"
                            Click="OnCancelClicked" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock x:Name="ValidationMessageText"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   MinHeight="14"
                   Foreground="{DynamicResource SkyErrorForeground}"
                   Text="{Binding DisplayedValidationMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
