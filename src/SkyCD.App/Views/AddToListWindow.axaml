<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
        xmlns:converters="using:SkyCD.App.Converters"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:views="using:SkyCD.App.Views"
        x:Class="SkyCD.App.Views.AddToListWindow"
        x:DataType="vm:AddToListDialogViewModel"
        Width="445"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.AddToList}}">

    <Design.DataContext>
        <vm:AddToListDialogViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:InternetProtocolIconConverter x:Key="InternetProtocolIcon" />
        <ControlTheme x:Key="AddToListTabItemTheme" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="#B0B0B0"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True" />
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style Selector="^:pointerover, ^:focus-visible">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="7,2" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="#207A7A7A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="7,2" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.source">
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.source.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#7A7A7A" />
            <Setter Property="Background" Value="#207A7A7A" />
        </Style>
        <Style Selector="Button.source:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBox.source-field, ComboBox.source-field, Button.source-field">
            <Setter Property="Height" Value="26" />
        </Style>
    </Window.Styles>

    <Grid Margin="8"
          ColumnDefinitions="89,*"
          ColumnSpacing="8">
        <Border BorderBrush="#B0B0B0"
                BorderThickness="1"
                Padding="2"
                VerticalAlignment="Top">
            <StackPanel>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceMedia}"
                        IsEnabled="{Binding CanUseMedia}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Media">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               Stretch="Uniform"
                               Source="/Assets/add-from-media.png" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromMedia}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceFolder}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Folder">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               Stretch="Uniform"
                               Source="/Assets/add-from-folder.png" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromFolder}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceInternet}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="Internet">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               Stretch="Uniform"
                               Source="/Assets/add-from-internet.png" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.FromInternet}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Classes="source"
                        Classes.selected="{Binding IsSourceTitleOnly}"
                        Command="{Binding SelectSourceCommand}"
                        CommandParameter="TitleOnly">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Image Width="40"
                               Height="40"
                               Stretch="Uniform"
                               Source="/Assets/add-from-media.png" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.TitleOnly}}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
            <StackPanel Spacing="3">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectMediaName}}" />
                <TextBox Classes="source-field" Text="{Binding MediaName}" />
                <StackPanel IsVisible="{Binding IsLocationPickerVisible}" Spacing="3">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Location}}" />
                    <ComboBox Classes="source-field"
                              ItemsSource="{Binding LocationChoices}"
                              SelectedItem="{Binding SelectedLocation}"
                              AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Location}}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationItemViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" MinHeight="84">
                <StackPanel IsVisible="{Binding IsSourceMedia}" Spacing="3">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectDrive}}" />
                    <ComboBox Classes="source-field"
                              ItemsSource="{Binding AvailableDrives}"
                              SelectedItem="{Binding SelectedDrive}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.IncludeMediaInfo}}"
                              IsChecked="{Binding IncludeMediaInfo}" />
                    <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFolders}}"
                              IsChecked="{Binding IncludeSubfolders}" />
                    <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFiles}}"
                              IsChecked="{Binding IncludeFiles}" />
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectedRootAlwaysAdded}}"
                               Foreground="#666666"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSourceFolder}" Spacing="3">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectFolder}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Classes="source-field" Text="{Binding SourceValue}" />
                        <Button Grid.Column="1"
                                Classes="source-field"
                                Content="..."
                                Width="28"
                                Click="OnBrowseFolderClicked" />
                    </Grid>
                    <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFolders}}"
                              IsChecked="{Binding IncludeSubfolders}" />
                    <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AddFiles}}"
                              IsChecked="{Binding IncludeFiles}" />
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.SelectedRootAlwaysAdded}}"
                               Foreground="#666666"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSourceInternet}" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox ItemsSource="{Binding InternetProtocols}"
                                  SelectedItem="{Binding InternetProtocol}"
                                  AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.InternetProtocol}}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <iconPacks:PackIconControl Width="16" Height="16"
                                                                   Kind="{Binding Converter={StaticResource InternetProtocolIcon}}"
                                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1"
                                x:Name="PasteInternetUrlButton"
                                IsEnabled="False"
                                Content="{i18n:Translate {x:Static i18n:UiKeys.PasteInternetUrl}}"
                                Click="OnPasteInternetUrlClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,72" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="3">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.InternetHost}}" />
                        <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}" />
                        <TextBox Grid.Row="1" Classes="source-field" Text="{Binding InternetHost}"
                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.InternetHost}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="source-field"
                                 Text="{Binding InternetPort}" PlaceholderText="{Binding SuggestedInternetPort}" MaxLength="5"
                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Port}}" />
                    </Grid>
                    <TextBlock IsVisible="{Binding !IsSmbInternetProtocol}"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.InternetPath}}" />
                    <TextBlock IsVisible="{Binding IsSmbInternetProtocol}"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.InternetSharePath}}" />
                    <TextBox Classes="source-field" Text="{Binding InternetPath}" />
                    <views:RemoteCredentialsForm DataContext="{Binding InternetCredentials}" />
                    <StackPanel Spacing="4" IsVisible="{Binding !InternetCredentials.IsSftp}">
                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CheckHostKey}}"
                                Command="{Binding CheckInternetConnectionCommand}" />
                        <TextBlock Text="{Binding InternetCheckStatus}" TextWrapping="Wrap"
                                   IsVisible="{Binding InternetCheckStatus, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock IsVisible="{Binding IsSourceTitleOnly}"
                           Text="{i18n:Translate {x:Static i18n:UiKeys.TitleOnlyMediaHint}}"
                           TextWrapping="Wrap" />
            </Grid>

            <Grid Grid.Row="2">
                <TabControl TabStripPlacement="Bottom">
                    <TabControl.Template>
                        <ControlTemplate>
                            <Grid RowDefinitions="80,28">
                                <Border BorderBrush="#B0B0B0" BorderThickness="1">
                                    <ContentPresenter Name="PART_SelectedContentHost"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" />
                                </Border>
                                <!-- Leave room for the dialog actions beside the tab headers. -->
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                Grid.Row="1"
                                                Margin="0,0,154,0"
                                                VerticalAlignment="Center"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Theme="{StaticResource AddToListTabItemTheme}"
                             Header="{i18n:Translate {x:Static i18n:UiKeys.AddContents}}">
                        <StackPanel Margin="10" Spacing="6">
                            <RadioButton Content="{i18n:Translate {x:Static i18n:UiKeys.AsNewMedia}}"
                                         IsChecked="{Binding IsTargetNewMedia, Mode=OneWay}"
                                         Command="{Binding SelectTargetCommand}"
                                         CommandParameter="NewMedia" />
                            <RadioButton Content="{i18n:Translate {x:Static i18n:UiKeys.ToSelectedMediaFolder}}"
                                         IsChecked="{Binding IsTargetSelectedFolder, Mode=OneWay}"
                                         Command="{Binding SelectTargetCommand}"
                                         CommandParameter="SelectedFolder" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Theme="{StaticResource AddToListTabItemTheme}"
                             Header="{i18n:Translate {x:Static i18n:UiKeys.Misc}}">
                        <StackPanel Margin="10" Spacing="6">
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.IncludeExtendedInfo}}"
                                      IsChecked="{Binding IncludeExtendedInfo}"
                                      IsEnabled="{Binding IsScanOptionsEnabled}" />
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,2"
                            Spacing="6">
                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                            Width="72"
                            Height="25"
                            Command="{Binding ConfirmCommand}" />
                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                            Width="72"
                            Height="25"
                            Click="OnCancelClicked" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       MinHeight="14"
                       Foreground="#B00000"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
