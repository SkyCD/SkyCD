<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:ui="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
        x:Class="SkyCD.App.Views.TagsWindow"
        x:DataType="vm:TagsDialogViewModel"
        Title="{i18n:Translate {x:Static ui:UiKeys.ManageTags}}"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SkySpaceSm}" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="Gray" />
            <Button Content="{i18n:Translate {x:Static ui:UiKeys.Close}}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="90" />
        </StackPanel>
        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Translate {x:Static ui:UiKeys.Tags}}" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox x:Name="PART_TagList" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" MinHeight="180"
                     AutomationProperties.Name="{i18n:Translate {x:Static ui:UiKeys.Tags}}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagAssignmentViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding UsageCount, StringFormat='({0})'}" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="{DynamicResource SkySpaceSm}">
                <TextBlock Text="{i18n:Translate {x:Static ui:UiKeys.NewTag}}" />
                <TextBox Text="{Binding NewTagName, Mode=TwoWay}" AutomationProperties.Name="{i18n:Translate {x:Static ui:UiKeys.TagName}}" />
                <Button x:Name="PART_CreateButton" Content="{i18n:Translate {x:Static ui:UiKeys.NewTag}}" Command="{Binding CreateTagCommand}" />
                <Separator Margin="0,6,0,6" />
                <TextBlock Text="{i18n:Translate {x:Static ui:UiKeys.RenameTag}}" />
                <TextBox Text="{Binding RenameTo, Mode=TwoWay}" AutomationProperties.Name="{i18n:Translate {x:Static ui:UiKeys.RenameTag}}" />
                <Button Content="{i18n:Translate {x:Static ui:UiKeys.RenameTag}}" Command="{Binding RenameTagCommand}" />
                <Separator Margin="0,6,0,6" />
                <TextBlock Text="{i18n:Translate {x:Static ui:UiKeys.MergeInto}}" />
                <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding MergeTarget, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagAssignmentViewModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{i18n:Translate {x:Static ui:UiKeys.MergeTags}}" Command="{Binding MergeTagsCommand}" />
                <Separator Margin="0,6,0,6" />
                <Button Content="{i18n:Translate {x:Static ui:UiKeys.DeleteTag}}" Command="{Binding DeleteTagCommand}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Spacing="{DynamicResource SkySpaceSm}">
                <Button Content="{i18n:Translate {x:Static ui:UiKeys.ShowItems}}" Command="{Binding ShowItemsCommand}" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding FilterResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" MaxHeight="120"
                         AutomationProperties.Name="{i18n:Translate {x:Static ui:UiKeys.AssignedItems}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogFindResult">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                <TextBlock Text="{Binding Document.Name}" />
                                <TextBlock Text="{Binding FullPath}" Foreground="Gray" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{i18n:Translate {x:Static ui:UiKeys.OpenResult}}" Command="{Binding NavigateToSelectedCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
