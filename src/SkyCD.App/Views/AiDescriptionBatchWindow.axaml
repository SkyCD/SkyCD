<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:media="clr-namespace:SkyCD.Presentation.MediaCache;assembly=SkyCD.Presentation"
        x:Class="SkyCD.App.Views.AiDescriptionBatchWindow"
        x:DataType="vm:AiDescriptionBatchDialogViewModel"
        Width="600"
        Height="480"
        MinWidth="480"
        MinHeight="360"
        CanResize="True"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.AiDescriptionBatch}}">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding ItemCountText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProviderText}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            <TextBlock Text="{Binding ContextText}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.RegenerateExisting}}"
                      IsChecked="{Binding RegenerateExisting, Mode=TwoWay}"
                      IsEnabled="{Binding CanStart}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="4">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="16" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,8,0,0" BorderThickness="1" CornerRadius="3"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                Background="{DynamicResource ThemeBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.DescriptionResults}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="media:AiDescriptionBatchItemResult">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,2">
                                <TextBlock Text="{Binding Name}" MinWidth="160" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,10,0,0">
            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Start}}"
                    Command="{Binding StartCommand}"
                    MinWidth="80"
                    IsDefault="True" />
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                    Command="{Binding CancelCommand}"
                    MinWidth="80" />
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Close}}"
                    Click="OnCloseClicked"
                    MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
