<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:ct="clr-namespace:SkyCD.UI.Controls.Toolbars;assembly=SkyCD.UI"
        xmlns:cl="clr-namespace:SkyCD.UI.Controls.Lists;assembly=SkyCD.UI"
        xmlns:cs="clr-namespace:SkyCD.UI.Controls.StatusBar;assembly=SkyCD.UI"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkyCD.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/skycd.ico"
        Width="503"
        Height="273"
        MinWidth="320"
        MinHeight="200"
        Title="SkyCD">

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
        <converters:MenuIconConverter x:Key="MenuIconConverter" />
        <converters:StatusBadgeIconConverter x:Key="StatusBadgeIconConverter" />
        <ControlTheme x:Key="DynamicMenuItemTheme"
                      TargetType="MenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Header"
                    Value="{ReflectionBinding DataContext.Header, RelativeSource={RelativeSource Self}}" />
            <Setter Property="HotKey"
                    Value="{ReflectionBinding DataContext.HotKey, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Icon"
                    Value="{ReflectionBinding DataContext.Icon, RelativeSource={RelativeSource Self}, Converter={StaticResource MenuIconConverter}}" />
            <Setter Property="Command"
                    Value="{ReflectionBinding DataContext.Command, RelativeSource={RelativeSource Self}}" />
            <Setter Property="CommandParameter"
                    Value="{ReflectionBinding DataContext.CommandParameter, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToggleType"
                    Value="{ReflectionBinding DataContext.ToggleType, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsChecked"
                    Value="{ReflectionBinding DataContext.IsChecked, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsEnabled"
                    Value="{ReflectionBinding DataContext.IsEnabled, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ItemsSource"
                    Value="{ReflectionBinding DataContext.Items, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ItemContainerTheme" Value="{DynamicResource DynamicMenuItemTheme}" />
        </ControlTheme>
        <ContextMenu x:Key="BrowserContextMenu" ItemsSource="{Binding BrowserContextMenuItems}">
            <ContextMenu.ItemContainerTheme>
                <StaticResource ResourceKey="DynamicMenuItemTheme" />
            </ContextMenu.ItemContainerTheme>
        </ContextMenu>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" IsEnabled="{Binding IsCatalogInteractionEnabled}">
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.FileMenu}}"
                      ItemsSource="{Binding FileMenuItems}"
                      ItemContainerTheme="{StaticResource DynamicMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.EditMenu}}"
                      ItemsSource="{Binding EditMenuItems}"
                      ItemContainerTheme="{StaticResource DynamicMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.ViewMenu}}"
                      ItemsSource="{Binding ViewMenuItems}"
                      ItemContainerTheme="{StaticResource DynamicMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.ToolsMenu}}"
                      ItemsSource="{Binding ToolsMenuItems}"
                      ItemContainerTheme="{StaticResource DynamicMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.HelpMenu}}"
                      ItemsSource="{Binding HelpMenuItems}"
                      ItemContainerTheme="{StaticResource DynamicMenuItemTheme}" />
        </Menu>

        <ct:ClassicToolbar DockPanel.Dock="Top">
            <ct:ClassicToolbar.Items>
                <ct:ClassicToolbarButton Command="{Binding NewCatalogCommand}"
                                         ImageSrc="/Assets/new.png"
                                         Text="{i18n:Translate {x:Static i18n:UiKeys.NewToolbar}}" />
                <ct:ClassicToolbarButton Command="{Binding OpenCatalogCommand}"
                                         ImageSrc="/Assets/open.png"
                                         Text="{i18n:Translate {x:Static i18n:UiKeys.OpenToolbar}}" />
                <ct:ClassicToolbarButton Command="{Binding SaveCatalogCommand}"
                                         ImageSrc="/Assets/save.png"
                                         Text="{i18n:Translate {x:Static i18n:UiKeys.SaveToolbar}}" />
            </ct:ClassicToolbar.Items>
        </ct:ClassicToolbar>

        <cs:StatusBar x:Name="MainStatusBar"
                      DockPanel.Dock="Bottom"
                      IsVisible="{Binding IsStatusBarShown}"
                      StatusText="{Binding StatusText}"
                      ProgressText="{Binding ProgressText}"
                      IsProgressVisible="{Binding IsProgressVisible}"
                      ProgressValue="{Binding ProgressValue}" />

        <Grid x:Name="MainLayoutGrid" RowDefinitions="*" IsEnabled="{Binding IsCatalogInteractionEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="121" MinWidth="50" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView Grid.Column="0"
                      MinWidth="50"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ItemsSource="{Binding TreeNodes}"
                      SelectedItem="{Binding SelectedTreeNode}"
                      ContextRequested="OnTreeContextRequested">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:BrowserTreeNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:BrowserTreeNode" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Title}">
                            <Image Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   Source="{Binding IconGlyph, Converter={StaticResource IconConverter}}" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu ItemsSource="{Binding TreeContextMenuItems}">
                        <ContextMenu.ItemContainerTheme>
                            <StaticResource ResourceKey="DynamicMenuItemTheme" />
                        </ContextMenu.ItemContainerTheme>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeControlMidBrush}"
                          ShowsPreview="True" />

            <cl:BrowserItemsView Grid.Column="2"
                                 ListMinWidth="120"
                                 ItemsSource="{Binding BrowserItems}"
                                 SelectedItem="{Binding SelectedBrowserItem}"
                                 SelectedItems="{Binding SelectedBrowserItems}"
                                 ViewMode="{Binding CurrentViewMode}"
                                 DetailsColumns="{Binding BrowserDetailsColumns}"
                                 BrowserGridItemWidth="{Binding BrowserGridItemWidth}"
                                 BrowserGridItemHeight="{Binding BrowserGridItemHeight}"
                                 IconConverter="{StaticResource IconConverter}"
                                 StatusIconConverter="{StaticResource StatusBadgeIconConverter}"
                                 ContextRequested="OnBrowserContextRequested"
                                 ListContextMenu="{DynamicResource BrowserContextMenu}"
                                 DoubleTapped="OnBrowserListDoubleTapped">
            </cl:BrowserItemsView>
        </Grid>
    </DockPanel>

</Window>
