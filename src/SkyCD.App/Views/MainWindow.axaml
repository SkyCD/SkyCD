<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:ct="clr-namespace:SkyCD.UI.Controls.Toolbars;assembly=SkyCD.UI"
        xmlns:cl="clr-namespace:SkyCD.UI.Controls.Lists;assembly=SkyCD.UI"
        xmlns:cs="clr-namespace:SkyCD.UI.Controls.StatusBar;assembly=SkyCD.UI"
        xmlns:pv="clr-namespace:SkyCD.UI.Controls.Preview;assembly=SkyCD.UI"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkyCD.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        DragDrop.AllowDrop="True"
        DragDrop.DragEnter="OnWindowDragOver"
        DragDrop.DragOver="OnWindowDragOver"
        DragDrop.DragLeave="OnWindowDragLeave"
        DragDrop.Drop="OnWindowDrop"
        Icon="/Assets/skycd.ico"
        Width="503"
        Height="273"
        MinWidth="320"
        MinHeight="200"
        Title="SkyCD">

    <Window.Styles>
        <Style Selector="TextBox.rename-editor">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="{DynamicResource SkyGapXXxs}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.rename-editor.invalid">
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
        <converters:StatusBadgeIconConverter x:Key="StatusBadgeIconConverter" />
        <!-- Menu row metrics live in Styles/MenuStyles.axaml so every menu surface shares them. -->
        <ContextMenu x:Key="BrowserContextMenu" ItemsSource="{Binding BrowserContextMenuItems}" />
        <ContextMenu x:Key="DetailsHeaderContextMenu" ItemsSource="{Binding DetailsHeaderMenuItems}" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" IsEnabled="{Binding IsCatalogInteractionEnabled}">
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.FileMenu}}"
                      ItemsSource="{Binding FileMenuItems}"
                      ItemContainerTheme="{StaticResource AppMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.EditMenu}}"
                      ItemsSource="{Binding EditMenuItems}"
                      ItemContainerTheme="{StaticResource AppMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.ViewMenu}}"
                      ItemsSource="{Binding ViewMenuItems}"
                      ItemContainerTheme="{StaticResource AppMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.ToolsMenu}}"
                      ItemsSource="{Binding ToolsMenuItems}"
                      ItemContainerTheme="{StaticResource AppMenuItemTheme}" />
            <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.HelpMenu}}"
                      ItemsSource="{Binding HelpMenuItems}"
                      ItemContainerTheme="{StaticResource AppMenuItemTheme}" />
        </Menu>

        <ct:ClassicToolbar x:Name="MainToolbar" DockPanel.Dock="Top" />

        <cs:StatusBar x:Name="MainStatusBar"
                      DockPanel.Dock="Bottom"
                      IsVisible="{Binding IsStatusBarShown}"
                      StatusText="{Binding StatusText}"
                      SecondaryStatusText="{Binding QuickFindStatus}"
                      ProgressText="{Binding ProgressText}"
                      IsProgressVisible="{Binding IsProgressVisible}"
                      ProgressValue="{Binding ProgressValue}" />

        <Grid x:Name="MainLayoutGrid" RowDefinitions="*" IsEnabled="{Binding IsCatalogInteractionEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="121" MinWidth="50" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="MainTreeView"
                      Grid.Column="0"
                      MinWidth="50"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ItemsSource="{Binding TreeNodes}"
                      SelectedItem="{Binding SelectedTreeNode}"
                      ContextRequested="OnTreeContextRequested"
                      GotFocus="OnTreeGotFocus"
                      PointerPressed="OnTreePointerPressed">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:BrowserTreeNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:BrowserTreeNode" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}" ToolTip.Tip="{Binding Title}">
                            <Image Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   Source="{Binding IconGlyph, Converter={StaticResource IconConverter}}" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsRenaming}" />
                            <TextBox Classes="rename-editor"
                                     Classes.invalid="{Binding HasRenameError}"
                                     Text="{Binding RenameText, Mode=TwoWay}"
                                     IsVisible="{Binding IsRenaming}"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding RenameError}"
                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Rename}}"
                                     KeyDown="OnRenameEditorKeyDown"
                                     LostFocus="OnRenameEditorLostFocus" />
                            <TextBlock Text="{Binding DecorationIndicator}" FontSize="{DynamicResource SkyFontCaption}" Opacity="0.8" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu ItemsSource="{Binding TreeContextMenuItems}" />
                </TreeView.ContextMenu>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeControlMidBrush}"
                          ShowsPreview="True" />

            <DockPanel Grid.Column="2" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource SkyInsetSm}" Spacing="{DynamicResource SkySpaceXs}"
                            IsVisible="{Binding IsQuickFilterOpen}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                        <TextBox x:Name="QuickFindBox" Text="{Binding QuickFindQuery, Mode=TwoWay}"
                                 PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.QuickFind}}"
                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.QuickFind}}" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding SearchWholeCatalog}"
                                  Content="{i18n:Translate {x:Static i18n:UiKeys.WholeCatalog}}" />
                    </Grid>
                </StackPanel>
                <Panel DockPanel.Dock="Bottom" IsVisible="{Binding !IsQuickFilterOpen}">
                    <pv:MediaPreviewPane x:Name="MainPreviewPane"
                                         Height="150"
                                         MinHeight="70"
                                         IsVisible="{Binding IsPreviewPaneVisible}"
                                         State="{Binding Preview.State}"
                                         EntryName="{Binding Preview.EntryName}"
                                         StatusText="{Binding Preview.StatusText}"
                                         StateMessage="{Binding Preview.StateMessage}"
                                         PreviewImage="{Binding Preview.PreviewImage}"
                                         PreviewText="{Binding Preview.PreviewText}"
                                         PreviewAutomationName="{Binding Preview.PreviewAutomationName}"
                                         Fields="{Binding Preview.Fields}" />
                </Panel>

                <Grid>
                    <cl:BrowserItemsView x:Name="MainBrowserItemsView"
                                         ListMinWidth="120"
                                         ItemsSource="{Binding VisibleBrowserItems}"
                                         IsVisible="{Binding ShowBrowserItems}"
                                         SelectedItem="{Binding SelectedBrowserItem}"
                                         SelectedItems="{Binding SelectedBrowserItems}"
                                         EditingItemId="{Binding EditingBrowserItemId}"
                                         RenameText="{Binding BrowserItemRenameText, Mode=TwoWay}"
                                         RenameError="{Binding BrowserItemRenameError}"
                                         HasRenameError="{Binding HasBrowserItemRenameError}"
                                         RenameCommitted="OnBrowserRenameCommitted"
                                         RenameCancelled="OnBrowserRenameCancelled"
                                         RenameAbandoned="OnBrowserRenameAbandoned"
                                         ViewMode="{Binding CurrentViewMode}"
                                         DetailsColumns="{Binding BrowserDetailsColumns}"
                                         SortColumnId="{Binding CurrentSortMode}"
                                         IsSortDescending="{Binding IsSortDescending}"
                                         BrowserGridItemWidth="{Binding BrowserGridItemWidth}"
                                         BrowserGridItemHeight="{Binding BrowserGridItemHeight}"
                                         IconConverter="{StaticResource IconConverter}"
                                         StatusIconConverter="{StaticResource StatusBadgeIconConverter}"
                                         ThumbnailProvider="{Binding BrowserThumbnailProvider}"
                                         ContextRequested="OnBrowserContextRequested"
                                         ListContextMenu="{DynamicResource BrowserContextMenu}"
                                         HeaderContextMenu="{DynamicResource DetailsHeaderContextMenu}"
                                         DoubleTapped="OnBrowserListDoubleTapped"
                                         DetailsColumnReordered="OnDetailsColumnReordered"
                                         DetailsColumnResized="OnDetailsColumnResized"
                                         DetailsColumnClicked="OnDetailsColumnClicked"
                                         GotFocus="OnBrowserGotFocus"
                                         PointerPressed="OnBrowserPointerPressed">
                    </cl:BrowserItemsView>
                    <DockPanel IsVisible="{Binding ShowQuickFindResults}">
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="{DynamicResource SkyInsetSm}"
                                Command="{Binding OpenQuickFindResultCommand}"
                                Content="{i18n:Translate {x:Static i18n:UiKeys.OpenResult}}" />
                        <ListBox x:Name="QuickFindResultList" ItemsSource="{Binding QuickFindResults}"
                                 SelectedItem="{Binding SelectedQuickFindResult, Mode=TwoWay}"
                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Results}}"
                                 DoubleTapped="OnQuickFindResultDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CatalogFindResult">
                                    <Grid ColumnDefinitions="2*,4*,Auto" ColumnSpacing="{DynamicResource SkySpaceMd}" ToolTip.Tip="{Binding FullPath}">
                                        <TextBlock Text="{Binding Document.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Context}" Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding MatchedField}" Opacity="0.75"
                                                   IsVisible="{Binding HasMatchedField}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBlock Text="{Binding SelectedContentsNotice}"
                               IsVisible="{Binding ShowBrowserContentsNotice}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource SkyInsetLg}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.8" />
                    <Border IsVisible="{Binding IsCatalogLoading}"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            Padding="{DynamicResource SkyInsetLg}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="{DynamicResource SkySpaceSm}"
                                    MaxWidth="360">
                            <TextBlock Classes="h2"
                                       Text="{Binding StatusText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         Height="6" />
                            <TextBlock Classes="caption"
                                       Text="{Binding ProgressText}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <Border x:Name="DropHint"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="{DynamicResource SkyInsetMd}"
                    Padding="{DynamicResource SkyInsetMd}"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    Background="{DynamicResource ThemeControlMidBrush}"
                    BorderBrush="{DynamicResource ThemeAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource SkyCornerRadiusLarge}">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.DropToAddToLibrary}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>

</Window>
