<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:ops="clr-namespace:SkyCD.Presentation.Operations;assembly=SkyCD.Presentation"
        x:Class="SkyCD.App.Views.AddingProgressWindow"
        x:DataType="vm:AddingProgressDialogViewModel"
        Width="520"
        Height="540"
        MinWidth="480"
        MinHeight="460"
        CanResize="True"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.Adding}}">

    <Design.DataContext>
        <vm:AddingProgressDialogViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Grid Margin="{DynamicResource SkyInsetMd}"
          RowDefinitions="*,Auto"
          RowSpacing="{DynamicResource SkySpaceSm}">
        <!--
            The blocks above the footer scroll only once the window is too short for them (the
            thumbnail is visible at MinHeight), so the footer keeps the SkyInsetMd inset instead
            of being pushed past the window edge. The scroller already stretches its content to
            the viewport, so the error log grows with the window when everything fits; a MinHeight
            bound back to the viewport would sustain the Auto scrollbar it triggers.
        -->
        <ScrollViewer x:Name="ProgressContentScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  RowSpacing="{DynamicResource SkySpaceSm}">
                <!-- Filtering line: what is currently being examined, with the active source shown inline -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource SkySpaceXs}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Filtering}}" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="{DynamicResource SkySpaceXxs}"
                                VerticalAlignment="Center">
                        <Image Classes="source-icon"
                               Width="{DynamicResource SkyIconSize}"
                               Height="{DynamicResource SkyIconSize}"
                               Stretch="Uniform"
                               Source="/Assets/add-from-media.png"
                               IsVisible="{Binding IsMediaSource}"
                               ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.FromMedia}}" />
                        <Image Classes="source-icon"
                               Width="{DynamicResource SkyIconSize}"
                               Height="{DynamicResource SkyIconSize}"
                               Stretch="Uniform"
                               Source="/Assets/add-from-folder.png"
                               IsVisible="{Binding IsFolderSource}"
                               ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.FromFolder}}" />
                        <Image Classes="source-icon"
                               Width="{DynamicResource SkyIconSize}"
                               Height="{DynamicResource SkyIconSize}"
                               Stretch="Uniform"
                               Source="/Assets/add-from-internet.png"
                               IsVisible="{Binding IsInternetSource}"
                               ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.FromInternet}}" />
                        <TextBlock Text="{Binding SourceLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding FilteringText}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                </Grid>

                <!-- Grouped statistics with right-aligned values -->
                <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource SkySpaceXxs}">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.VolumeStatistics}}" FontWeight="SemiBold" />
                        <Border Height="1" Margin="{DynamicResource SkyGapBottomXxs}" Background="{DynamicResource ThemeBorderLowBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Processed}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding ProcessedCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Skipped}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding SkippedCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Failed}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding FailedCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Errors}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding ErrorCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Warnings}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding WarningCount}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="{DynamicResource SkySpaceXxs}">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanStatistics}}" FontWeight="SemiBold" />
                        <Border Height="1" Margin="{DynamicResource SkyGapBottomXxs}" Background="{DynamicResource ThemeBorderLowBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Discovered}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding ScanDiscoveredCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Skipped}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding ScanSkippedCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="stat-label" Text="{i18n:Translate {x:Static i18n:UiKeys.Failed}}" />
                            <TextBlock Grid.Column="1" Classes="stat-value" Text="{Binding ScanFailedCount}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- One progress bar, captioned by the current stage -->
                <StackPanel Grid.Row="2" Spacing="{DynamicResource SkySpaceXs}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                        <TextBlock Text="{Binding StageCaptionText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OverallProgressText}"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding OverallProgressValue}"
                                 IsIndeterminate="{Binding IsOverallIndeterminate}"
                                 Height="14" />
                </StackPanel>

                <!-- Newest thumbnail of the running operation; hidden until one has been produced -->
                <StackPanel Grid.Row="3"
                            Spacing="{DynamicResource SkySpaceXs}"
                            IsVisible="{Binding HasLatestThumbnail}">
                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.LatestThumbnail}}" FontWeight="SemiBold" />
                    <Border Height="96"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource SkyCornerRadius}"
                            Background="{DynamicResource ThemeBackgroundBrush}">
                        <Image Source="{Binding LatestThumbnail}"
                               Stretch="Uniform"
                               Margin="{DynamicResource SkyInsetXs}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Always-visible error log -->
                <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="{DynamicResource SkySpaceXs}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ErrorLog}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{i18n:Translate {x:Static i18n:UiKeys.CopyLog}}"
                                Click="OnCopyLogClicked"
                                Padding="{DynamicResource SkyControlPadding}" />
                        <Button Grid.Column="2"
                                Content="{i18n:Translate {x:Static i18n:UiKeys.ClearLog}}"
                                Command="{Binding ClearLogCommand}"
                                Padding="{DynamicResource SkyControlPadding}" />
                    </Grid>
                    <Border Grid.Row="1"
                            MinHeight="90"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="{DynamicResource ThemeBackgroundBrush}">
                        <ScrollViewer x:Name="LogScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ops:OperationLogEntry">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                                   FontSize="{DynamicResource SkyFontSecondary}"
                                                   Margin="{DynamicResource SkyControlPaddingTight}"
                                                   TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Footer: status, analysis time and Cancel, sharing one baseline and pinned inside the window inset -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="{DynamicResource SkySpaceMd}">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PleaseWait}}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SkySpaceXs}"
                        VerticalAlignment="Center">
                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AnalysisTime}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding AnalysisTimeText}"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code,Consolas,Courier New,monospace" />
            </StackPanel>
            <Button Grid.Column="2"
                    Classes.close="{Binding IsCloseMode}"
                    IsEnabled="{Binding CanDismiss}"
                    Click="OnDismissClicked"
                    VerticalAlignment="Center"
                    Width="72">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}" />
                    </Style>
                    <Style Selector="Button.close">
                        <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.Close}}" />
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Grid>
</Window>
