<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        x:Class="SkyCD.App.Views.ToolbarCustomizationWindow"
        x:DataType="vm:ToolbarCustomizationViewModel"
        Width="720"
        Height="460"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.CustomizeToolbar}}">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,*,Auto">
        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CustomizeToolbarHint}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{i18n:Translate {x:Static i18n:UiKeys.ToolbarCommands}}"
                           Margin="0,0,0,4" />
                <ListBox x:Name="CommandList"
                         ItemsSource="{Binding AvailableCommands}"
                         SelectedItem="{Binding SelectedCommand}"
                         DoubleTapped="OnCommandDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolbarCommandChoiceViewModel">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Category}"
                                           FontSize="9"
                                           Opacity="0.65" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AddToolbarButton}}"
                        Command="{Binding AddCommand}"
                        MinWidth="110" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AddSeparator}}"
                        Command="{Binding AddSeparatorCommand}"
                        MinWidth="110" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.RemoveToolbarButton}}"
                        Command="{Binding RemoveCommand}"
                        MinWidth="110" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MoveUp}}"
                        Command="{Binding MoveUpCommand}"
                        MinWidth="110" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MoveDown}}"
                        Command="{Binding MoveDownCommand}"
                        MinWidth="110" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.ResetToolbar}}"
                        Command="{Binding ResetCommand}"
                        MinWidth="110" />
            </StackPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="{i18n:Translate {x:Static i18n:UiKeys.ToolbarButtons}}"
                           Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding SelectedItems}"
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolbarEntryViewModel">
                            <Grid Margin="2,1">
                                <TextBlock Text="{Binding Label}"
                                           IsVisible="{Binding !IsSeparator}"
                                           VerticalAlignment="Center" />
                                <Border Height="1"
                                        Background="{DynamicResource ThemeBorderMidBrush}"
                                        IsVisible="{Binding IsSeparator}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="90" />
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                    IsCancel="True"
                    MinWidth="90"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
