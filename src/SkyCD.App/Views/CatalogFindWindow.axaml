<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        x:Class="SkyCD.App.Views.CatalogFindWindow"
        x:DataType="vm:CatalogFindDialogViewModel"
        Width="720" Height="480" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.FindCatalog}}">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="QueryTextBox"
                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.FindCatalogHint}}"
                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" MinWidth="90"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.Find}}"
                    Command="{Binding SearchCommand}" IsDefault="True" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 DoubleTapped="OnResultsDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogFindResult">
                    <Grid Margin="4,3" ColumnDefinitions="2*,4*" ColumnSpacing="12">
                        <TextBlock Text="{Binding Document.Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
            <Button Grid.Column="1" MinWidth="90"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.OpenResult}}"
                    Command="{Binding NavigateToResultCommand}" CommandParameter="{Binding SelectedResult}" />
            <Button Grid.Column="2" MinWidth="90" IsCancel="True"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.Close}}" Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
