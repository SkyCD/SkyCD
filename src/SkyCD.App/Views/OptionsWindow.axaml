<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:media="clr-namespace:SkyCD.Plugin.Abstractions.Capabilities.Media;assembly=SkyCD.Plugin.Abstractions"
        xmlns:hostmedia="clr-namespace:SkyCD.Plugin.Host.Media;assembly=SkyCD.Plugin.Host"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:lucide="clr-namespace:IconPacks.Avalonia.Lucide;assembly=IconPacks.Avalonia.Lucide"
        xmlns:multiSelect="clr-namespace:SkyCD.UI.Controls.Selectors.MultiSelectDropdown;assembly=SkyCD.UI"
        xmlns:colorSelect="clr-namespace:SkyCD.UI.Controls.Selectors.ColorPaletteDropdown;assembly=SkyCD.UI"
        x:Class="SkyCD.App.Views.OptionsWindow"
        x:DataType="vm:OptionsDialogViewModel"
        Width="760"
        Height="520"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        CanMinimize="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.Options}}">

    <Design.DataContext>
        <vm:OptionsDialogViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.acpAgentCard">
            <Setter Property="BorderBrush" Value="{DynamicResource TabCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.acpAgentCard.selected">
            <Setter Property="BorderBrush" Value="#5795D6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style Selector="Button.acpUseAgent">
            <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.UseAcpAgent}}" />
        </Style>
        <Style Selector="Border.acpAgentCard.selected Button.acpUseAgent">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Theme">
                <ControlTheme TargetType="Button">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="#234767" BorderBrush="#5795D6" BorderThickness="1" CornerRadius="3">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  Padding="7,4" HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" Foreground="#E2F0FF" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </Setter>
            <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentSelected}}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
        <converters:PluginIconConverter x:Key="PluginIconConverter" />
        <converters:IconGlyphToSymbolConverter x:Key="IconGlyphToSymbolConverter" />
        <converters:LanguageFlagImageConverter x:Key="LanguageFlagImageConverter" />
        <converters:StatusBadgeIconConverter x:Key="StatusBadgeIconConverter" />
        <converters:AcpAgentIconConverter x:Key="AcpAgentIconConverter" />
        <converters:AcpAgentSelectionConverter x:Key="AcpAgentSelectionConverter" />
        <ItemsPanelTemplate x:Key="AcpAgentCardsPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="AcpAgentCardTemplate" x:DataType="media:AcpAgentChoice">
            <Border Classes="acpAgentCard" MinHeight="96" Margin="3"
                    Background="{DynamicResource TabCardBackgroundBrush}"
                    CornerRadius="6">
                <Classes.selected>
                    <MultiBinding Converter="{StaticResource AcpAgentSelectionConverter}">
                        <Binding />
                        <ReflectionBinding Path="DataContext.AcpCardAgent"
                                           RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                    </MultiBinding>
                </Classes.selected>
                <Grid ColumnDefinitions="34,*" ColumnSpacing="9" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Border Width="34" Height="34" CornerRadius="7" Background="#36516D"
                            VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="{Binding IconLabel}" Foreground="White" FontWeight="SemiBold"
                                       IsVisible="{Binding !IconPaths.Count}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconPaths, Converter={StaticResource AcpAgentIconConverter}}"
                                   Width="20" Height="20" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Description}" Opacity="0.78"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBlock Text="{Binding DisplayVersion}" Opacity="0.7"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="acpUseAgent" IsVisible="{Binding IsInstalled}"
                                    Click="OnSelectAcpAgentClicked" />
                            <Button IsVisible="{Binding CanInstall}" Click="OnInstallAcpAgentClicked"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.InstallAcpAgent}}" />
                            <Button IsVisible="{Binding CanUpdate}" Click="OnInstallAcpAgentClicked"
                                    ToolTip.Tip="{Binding RegistryVersion}"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.UpdateAcpAgent}}" />
                            <Button IsVisible="{Binding IsManaged}" Click="OnUninstallAcpAgentClicked"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.UninstallAcpAgent}}" />
                            <Button IsVisible="{Binding CanLocateExecutable}" Click="OnBrowseAcpAgentClicked"
                                    ToolTip.Tip="{Binding ExpectedExecutable}"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.LocateAcpAgent}}" />
                            <TextBlock IsVisible="{Binding !HasAvailableAction}" Opacity="0.7"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentUnavailable}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Padding="14,10,14,8">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Settings}}"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1"
              IsEnabled="{Binding !ConfirmCommand.IsRunning}"
              Margin="14,10,14,10"
              ColumnDefinitions="250,*"
              ColumnSpacing="14">
            <Border BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Grid.RowSpan="2">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBox PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.Search}}"
                             Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredSettingCategories}"
                             SelectedItem="{Binding SelectedSettingCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionsSettingCategory">
                                <TextBlock Text="{Binding Title}" Margin="8,5" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Foreground="#8C8C8C"
                               FontSize="11"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.NavigateCategoriesHint}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="{i18n:Translate {x:Static i18n:UiKeys.Tools}}" />
                        <Run Text="  >  " />
                        <Run Text="{Binding CurrentCategoryName}" />
                    </TextBlock>

                    <StackPanel Grid.Row="1"
                                IsVisible="{Binding ShowPluginPathSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ProjectSettings}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginPath}}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PluginPath}" />
                            <Button Grid.Column="2"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.Browse}}"
                                    MinWidth="90"
                                    Command="{Binding BrowsePluginPathCommand}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowPluginListSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Plugins}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBox Width="260"
                                     Text="{Binding PluginFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.FilterPlugins}}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="#8C8C8C"
                                       Text="{Binding InfoMessage}" />
                        </Grid>
                        <Border Grid.Row="2"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="2*,3*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.On}}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{i18n:Translate {x:Static i18n:UiKeys.Installed}}" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding FilteredPlugins}"
                                                 SelectedItem="{Binding SelectedPlugin}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OptionsPluginItem">
                                                    <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"
                                                            Padding="8,6">
                                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                            <CheckBox
                                                                IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <Panel Grid.Column="1"
                                                                   Width="24"
                                                                   Height="24"
                                                                   VerticalAlignment="Top">
                                                                <Image
                                                                    Source="{Binding IconKey, Converter={StaticResource PluginIconConverter}}"
                                                                    IsVisible="{Binding HasIcon}" />
                                                                <iconPacks:PackIconControl
                                                                    Kind="{x:Static lucide:PackIconLucideKind.Puzzle}"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="#9CA3AF"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding !HasIcon}" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Type}" Foreground="#9CA3AF"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <Button Content="{Binding SelectedPlugin.Type}"
                                                Foreground="#9CA3AF"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding OpenSelectedPluginAuthorUrlCommand}" />
                                        <TextBlock Text="{Binding SelectedPlugin.ExtendedInfo}" Foreground="#8C8C8C"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Refresh}}"
                                                MinWidth="90"
                                                Command="{Binding RefreshPluginsCommand}" />
                                    </StackPanel>
                                    <Border Grid.Row="2"
                                            BorderBrush="#2E2E2E"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10">
                                        <TextBlock Text="{Binding SelectedPluginDescription}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#CFCFCF" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                IsVisible="False"
                                Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Actions}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Refresh}}"
                                    MinWidth="90"
                                    Command="{Binding RefreshPluginsCommand}" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding ShowPluginInfoSection}"
                                   Text="{Binding InfoMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="8"
                          IsVisible="{Binding ShowPluginSettingsSection}">
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     IsVisible="{Binding SelectedPluginPage.IsLoading}" />
                        <TextBlock Grid.Row="1" Text="{Binding SelectedPluginPage.Error}"
                                   IsVisible="{Binding SelectedPluginPage.HasError}" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding SelectedPluginPage.Content}"
                                            HorizontalContentAlignment="Stretch" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowLanguageSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ApplicationSettings}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Language}}" VerticalAlignment="Top" />
                            <ListBox Grid.Column="1"
                                     ItemsSource="{Binding Languages}"
                                     SelectedItem="{Binding SelectedLanguage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageItem">
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    AutomationProperties.Name="{Binding Name}">
                                            <Image Width="20" Height="16"
                                                   Source="{Binding Flag, Converter={StaticResource LanguageFlagImageConverter}}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowMcpSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.McpServer}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Enabled}}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpServerEnabled}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ShowStatusIcon}}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpStatusIconVisible}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnDefinitions="140,120,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     IsEnabled="{Binding IsMcpServerEnabled}"
                                     Text="{Binding McpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ServerUri}}" VerticalAlignment="Center" />
                            <TextBox x:Name="McpUrlTextBox"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding McpBaseUrl}"
                                     DoubleTapped="OnMcpUrlDoubleTapped" />
                            <Button Grid.Column="2"
                                    Content="⧉"
                                    FontSize="14"
                                    MinWidth="34"
                                    ToolTip.Tip="{Binding McpCopyTooltip}"
                                    Click="OnCopyMcpUrlClicked" />
                        </Grid>
                        <Border IsVisible="{Binding ShowMcpAlert}"
                                Background="#1B5E20"
                                BorderBrush="#2E7D32"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding McpAlertMessage}"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowStatusesSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ItemStatuses}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="↺"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetStatusesTooltip}}"
                                    Command="{Binding ResetStatusVariantsCommand}" />
                            <Button Content="+"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding AddStatusVariantCommand}" />
                            <Button Content="-"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding RemoveStatusVariantCommand}" />
                        </StackPanel>

                        <Border BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Grid.Row="2">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="2*,220,2*,140" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Status}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Icon}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{i18n:Translate {x:Static i18n:UiKeys.Type}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{i18n:Translate {x:Static i18n:UiKeys.Color}}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding StatusVariants}"
                                         SelectedItem="{Binding SelectedStatusVariant}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusVariantItemViewModel">
                                            <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid ColumnDefinitions="2*,220,2*,140" ColumnSpacing="10">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <multiSelect:MultiSelectDropdown Grid.Column="1"
                                                                                     IsIconPicker="True"
                                                                                     IconKeys="{Binding IconOptions}"
                                                                                     SelectedIconKey="{Binding IconGlyph, Mode=TwoWay}"
                                                                                     IsSingleSelect="True"
                                                                                     ShowItemLabels="False"
                                                                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SelectIcon}}">
                                                        <multiSelect:MultiSelectDropdown.ItemPreviewTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <ContentControl Width="16" Height="16"
                                                                                Foreground="{DynamicResource ThemeForegroundBrush}"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                VerticalContentAlignment="Stretch"
                                                                                Content="{Binding ., Converter={StaticResource StatusBadgeIconConverter}}" />
                                                            </DataTemplate>
                                                        </multiSelect:MultiSelectDropdown.ItemPreviewTemplate>
                                                    </multiSelect:MultiSelectDropdown>
                                                    <multiSelect:MultiSelectDropdown Grid.Column="2"
                                                                                     ItemsSource="{Binding TypeOptions}"
                                                                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SelectItemTypes}}" />
                                                    <colorSelect:ColorPaletteDropdownControl Grid.Column="3"
                                                                                             SelectedColor="{Binding IconColor, Mode=TwoWay}"
                                                                                             ItemsSource="{Binding ColorOptions}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowStatusAlert}"
                                Grid.Row="3"
                                Background="#7F1D1D"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding StatusAlertMessage}"
                                       Foreground="#FEE2E2"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowCustomPropertiesSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CustomProperties}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CustomPropertiesDescription}}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="+"
                                        FontSize="16"
                                        Width="34"
                                        Height="28"
                                        Command="{Binding AddCustomPropertyCommand}"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddProperty}}" />
                                <Button Content="-"
                                        FontSize="16"
                                        Width="34"
                                        Height="28"
                                        Command="{Binding RemoveCustomPropertyCommand}"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemoveProperty}}" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Grid.Row="2">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PropertyName}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.DefaultValue}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding CustomProperties}"
                                         SelectedItem="{Binding SelectedCustomProperty}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomPropertyItemViewModel">
                                            <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="1" Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowCustomPropertyAlert}"
                                Grid.Row="3"
                                Background="#7F1D1D"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding CustomPropertyAlertMessage}"
                                       Foreground="#FEE2E2"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" IsVisible="{Binding ShowAcpSection}"
                          RowDefinitions="Auto,*,Auto">
                        <TextBox Margin="0,0,0,12"
                                 PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SearchAcpAgents}}"
                                 Text="{Binding AcpSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding !IsAcpLoading}" />

                        <Border Grid.Row="1" BorderBrush="{DynamicResource TabCardBorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <ScrollViewer IsVisible="{Binding !IsAcpLoading}"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="12" Spacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentInstalled}}" IsVisible="{Binding HasInstalledAcpAgents}"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding InstalledAcpAgents}" IsVisible="{Binding HasInstalledAcpAgents}"
                                                      ItemTemplate="{StaticResource AcpAgentCardTemplate}"
                                                      ItemsPanel="{StaticResource AcpAgentCardsPanel}" />
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentsAvailable}}" IsVisible="{Binding HasAvailableAcpAgents}"
                                                   FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <ItemsControl ItemsSource="{Binding AvailableAcpAgents}" IsVisible="{Binding HasAvailableAcpAgents}"
                                                      ItemTemplate="{StaticResource AcpAgentCardTemplate}"
                                                      ItemsPanel="{StaticResource AcpAgentCardsPanel}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid IsVisible="{Binding !IsAcpLoading}">
                                    <TextBlock IsVisible="{Binding HasNoMatchingAcpAgents}"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.NoMatchingAcpAgents}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                                </Grid>
                                <StackPanel IsVisible="{Binding IsAcpLoading}" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Spacing="10">
                                    <ProgressBar Width="124" Height="5" IsIndeterminate="{Binding IsAcpLoading}" />
                                    <TextBlock Text="{Binding AcpLoadingLabel}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock IsVisible="{Binding HasAcpRegistryStatus}" Text="{Binding AcpRegistryStatus}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasAcpAlert}" Text="{Binding AcpAlertMessage}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#DC2626" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowScanSection}"
                          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanExclusions}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanSettings}}" FontWeight="SemiBold" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipSymbolicLinks}}"
                                      IsChecked="{Binding SkipSymbolicLinks}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.HiddenSystemEntries}}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding HiddenSystemPolicyOptions}"
                                          SelectedIndex="{Binding SelectedHiddenSystemPolicyIndex}" />
                            </Grid>
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipRecycleBins}}"
                                      IsChecked="{Binding SkipRecycleBins}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipWellKnownSystemFolders}}"
                                      IsChecked="{Binding SkipWellKnownSystemFolders}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipEmptyFolders}}"
                                      IsChecked="{Binding SkipEmptyFolders}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipOnlineOnlyCloudFiles}}"
                                      IsChecked="{Binding SkipOnlineOnlyCloudFiles}"
                                      IsVisible="{Binding IsOnlineOnlyCloudFilesOptionVisible}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.IncludeExtendedInfo}}"
                                      IsChecked="{Binding IncludeExtendedInfo}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.ShowScanErrorsAfterScan}}"
                                      IsChecked="{Binding ShowScanErrorsAfterScan}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SaveScanErrorsToComments}}"
                                      IsChecked="{Binding SaveScanErrorsToComments}" />
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanCompletionHeader}}"
                                       Margin="0,8,0,0"
                                       FontWeight="SemiBold" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.EjectMediaAfterScan}}"
                                      IsChecked="{Binding EjectMediaAfterScan}"
                                      IsEnabled="{Binding IsMediaEjectionSupported}" />
                            <TextBlock Text="{Binding MediaEjectionSupportHint}"
                                       Margin="28,0,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Opacity="0.75" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.ActivateMainWindowAfterScan}}"
                                      IsChecked="{Binding ActivateMainWindowAfterScan}" />
                            <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.PlaySoundAfterScan}}"
                                      IsChecked="{Binding PlaySoundAfterScan}" />
                        </StackPanel>

                        <Border Grid.Row="2"
                                Height="1"
                                Margin="0,4"
                                Background="#2E2E2E"
                                HorizontalAlignment="Stretch" />

                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ExclusionRules}}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="↺"
                                        FontSize="16"
                                        Width="34"
                                        Height="28"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetRulesTooltip}}"
                                        Command="{Binding ResetScanExclusionRulesCommand}" />
                                <Button Content="+"
                                        FontSize="16"
                                        Width="34"
                                        Height="28"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddRule}}"
                                        Command="{Binding AddScanExclusionRuleCommand}" />
                                <Button Content="-"
                                        FontSize="16"
                                        Width="34"
                                        Height="28"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemoveRule}}"
                                        Command="{Binding RemoveScanExclusionRuleCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Grid.Row="4">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="2*,160,120" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Pattern}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.EntryType}}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.IncludeByMask}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ScanExclusionRules}"
                                         SelectedItem="{Binding SelectedScanExclusionRule}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScanExclusionRuleItemViewModel">
                                            <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid ColumnDefinitions="2*,160,120" ColumnSpacing="10">
                                                    <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding EntryTypeOptions}"
                                                              SelectedIndex="{Binding EntryTypeIndex, Mode=TwoWay}" />
                                                    <CheckBox Grid.Column="2"
                                                              IsChecked="{Binding IsInclude, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.IncludeByMask}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowScanAlert}"
                                Grid.Row="5"
                                Background="#7F1D1D"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding ScanAlertMessage}"
                                       Foreground="#FEE2E2"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowLocationsSection}"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Locations}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                MinHeight="120">
                            <ListBox ItemsSource="{Binding Locations}"
                                     SelectedItem="{Binding SelectedLocation}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LocationItemViewModel">
                                        <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UsageCount, StringFormat='({0})'}"
                                                           Foreground="#8C8C8C"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NewLocation}}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewLocationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.LocationName}}" />
                            <Button Grid.Column="2"
                                    MinWidth="90"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.NewLocation}}"
                                    Command="{Binding CreateLocationCommand}" />
                        </Grid>

                        <Grid Grid.Row="3" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.RenameLocation}}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding RenameTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.RenameLocation}}" />
                            <Button Grid.Column="2"
                                    MinWidth="90"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.RenameLocation}}"
                                    Command="{Binding RenameLocationCommand}" />
                        </Grid>

                        <Grid Grid.Row="4" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.MergeInto}}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Locations}"
                                      SelectedItem="{Binding MergeTarget, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LocationItemViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    MinWidth="90"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.MergeLocations}}"
                                    Command="{Binding MergeLocationsCommand}" />
                        </Grid>

                        <Grid Grid.Row="5" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding LocationsStatusText}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Opacity="0.8" />
                            <Button Grid.Column="2"
                                    MinWidth="90"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.DeleteLocation}}"
                                    Command="{Binding DeleteLocationCommand}" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowDetailsColumnsSection}"
                          RowDefinitions="Auto,Auto,Auto,*"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.DetailsColumns}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.DetailsColumnsDescription}}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="↑"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding MoveDetailsColumnUpCommand}"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.MoveUp}}" />
                            <Button Content="↓"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding MoveDetailsColumnDownCommand}"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.MoveDown}}" />
                        </StackPanel>

                        <Border Grid.Row="3"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1">
                            <ListBox ItemsSource="{Binding DetailsColumns}"
                                     SelectedItem="{Binding SelectedDetailsColumn}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailsColumnOptionItemViewModel">
                                        <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsRemovable}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Header}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RequiredLabel}"
                                                           IsVisible="{Binding IsRequired}"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowToolbarSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Toolbar}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.CustomizeToolbarHint}}"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{i18n:Translate {x:Static i18n:UiKeys.ToolbarCommands}}"
                                           Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding Toolbar.AvailableCommands}"
                                         SelectedItem="{Binding Toolbar.SelectedCommand}"
                                         DoubleTapped="OnToolbarCommandDoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolbarCommandChoiceViewModel">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="9"
                                                           Opacity="0.65" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AddToolbarButton}}"
                                        Command="{Binding Toolbar.AddCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AddSeparator}}"
                                        Command="{Binding Toolbar.AddSeparatorCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.RemoveToolbarButton}}"
                                        Command="{Binding Toolbar.RemoveCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MoveUp}}"
                                        Command="{Binding Toolbar.MoveUpCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MoveDown}}"
                                        Command="{Binding Toolbar.MoveDownCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.ResetToolbar}}"
                                        Command="{Binding Toolbar.ResetCommand}"
                                        MinWidth="110" />
                            </StackPanel>

                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{i18n:Translate {x:Static i18n:UiKeys.ToolbarButtons}}"
                                           Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding Toolbar.SelectedItems}"
                                         SelectedItem="{Binding Toolbar.SelectedItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolbarEntryViewModel">
                                            <Grid Margin="2,1">
                                                <TextBlock Text="{Binding Label}"
                                                           IsVisible="{Binding !IsSeparator}"
                                                           VerticalAlignment="Center" />
                                                <Border Height="1"
                                                        Background="{DynamicResource ThemeBorderMidBrush}"
                                                        IsVisible="{Binding IsSeparator}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowAiDescriptionSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <ScrollViewer x:Name="AiDescriptionSettingsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiDescription}}" FontSize="15" />
                                    <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="180,*"
                                      ColumnSpacing="10"
                                      IsVisible="{Binding ShowAiDescriptionImplementationSection}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiImplementation}}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AiDescriptionImplementations}"
                                              SelectedItem="{Binding SelectedAiDescriptionImplementation}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="hostmedia:AiDescriptionImplementationChoice">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiScanSettings}}" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="180,120,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.MaxAiScanFileSize}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding AiScanMaxFileSizeMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                Background="#2E2E2E" />

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiMimeExclusions}}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="↺"
                                            FontSize="16"
                                            Width="34"
                                            Height="28"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetMimeTypesTooltip}}"
                                            Command="{Binding ResetAiScanExclusionsCommand}" />
                                    <Button Content="+"
                                            FontSize="16"
                                            Width="34"
                                            Height="28"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddMimeType}}"
                                            Command="{Binding AddAiScanExclusionCommand}" />
                                    <Button Content="-"
                                            FontSize="16"
                                            Width="34"
                                            Height="28"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemoveMimeType}}"
                                            Command="{Binding RemoveAiScanExclusionCommand}" />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="AiScanExclusionsListBorder"
                                    Grid.Row="1"
                                    BorderBrush="#2E2E2E"
                                    BorderThickness="1">
                                <Grid RowDefinitions="Auto,*">
                                    <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.MimeType}}" FontWeight="SemiBold" />
                                    </Border>
                                    <ListBox x:Name="AiScanExclusionsList"
                                             Grid.Row="1"
                                             ItemsSource="{Binding AiScanExclusions}"
                                             SelectedItem="{Binding SelectedAiScanExclusion}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiScanExclusionItemViewModel">
                                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBox Text="{Binding MimeType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3"
                                IsVisible="{Binding ShowAiDescriptionAlert}"
                                Background="#7F1D1D"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding AiDescriptionAlertMessage}"
                                       Foreground="#FEE2E2"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding ShowAiProviderSection}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderCategory}}" FontSize="15" />
                                <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                            </Grid>

                            <Border BorderBrush="#2E2E2E"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderSettings}}"
                                               FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProvider}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AiProviders}"
                                                  SelectedItem="{Binding SelectedAiProvider}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="media:AiProviderChoice">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="180,120,120,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.InternetProtocol}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AiProviderProtocols}"
                                                  SelectedItem="{Binding AiProviderProtocol}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding AiProviderPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderAddress}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding AiProviderAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderEndpoint}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 IsReadOnly="True"
                                                 Text="{Binding AiProviderEndpointUrl}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderApiKey}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 PasswordChar="*"
                                                 Text="{Binding AiProviderApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderModel}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding AiProviderModels}"
                                                  Text="{Binding AiProviderModel, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Content="↻"
                                                FontSize="16"
                                                Width="34"
                                                Height="28"
                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AiProviderRefreshModels}}"
                                                Command="{Binding RefreshAiProviderModelsCommand}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderOutputLanguage}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AiProviderLanguages}"
                                                  SelectedItem="{Binding AiProviderLanguage}" />
                                    </Grid>
                                    <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.AiProviderResizeImages}}"
                                              IsChecked="{Binding AiProviderResizeLargeImages}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AiProviderCheckConnection}}"
                                                Command="{Binding CheckAiProviderConnectionCommand}" />
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AiProviderStartServer}}"
                                                IsVisible="{Binding AiProviderCanStartServer}"
                                                Command="{Binding StartAiProviderServerCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AiProviderConnectionStatus}"
                                               Foreground="#9BD1FF"
                                               TextWrapping="Wrap" />
                                    <Border IsVisible="{Binding ShowAiProviderAlert}"
                                            Background="#7F1D1D"
                                            BorderBrush="#DC2626"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,4">
                                        <TextBlock Text="{Binding AiProviderAlertMessage}"
                                                   Foreground="#FEE2E2"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="4"
                            IsVisible="{Binding ShowNoSearchResults}"
                            BorderBrush="#6A5C2D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NoSettingsMatch}}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Save}}"
                        MinWidth="90"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                        MinWidth="90"
                        IsCancel="True"
                        Click="OnCancelClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
