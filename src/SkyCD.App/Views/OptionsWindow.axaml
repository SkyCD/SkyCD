<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        x:Class="SkyCD.App.Views.OptionsWindow"
        x:DataType="vm:OptionsDialogViewModel"
        Width="760"
        Height="520"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        CanMinimize="False"
        Icon="/Assets/skycd.ico"
        Title="Options">

    <Design.DataContext>
        <vm:OptionsDialogViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Padding="14,10,14,8">
            <TextBlock Text="Settings"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1"
              Margin="14,10,14,10"
              ColumnDefinitions="250,*"
              ColumnSpacing="14">
            <Border BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Grid.RowSpan="2">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBox PlaceholderText="Search"
                             Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredSettingCategories}"
                             SelectedItem="{Binding SelectedSettingCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="8,5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Foreground="#8C8C8C"
                               FontSize="11"
                               Text="Use arrows to navigate categories" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="Tools" />
                        <Run Text="  >  " />
                        <Run Text="{Binding CurrentCategoryName}" />
                    </TextBlock>

                    <StackPanel Grid.Row="1"
                                IsVisible="{Binding ShowPluginPathSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="Project Settings" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="Plug-in path:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PluginPath}" />
                            <Button Grid.Column="2"
                                    Content="Browse..."
                                    MinWidth="90"
                                    Command="{Binding BrowsePluginPathCommand}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowPluginListSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="Plug-ins" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBox Width="260"
                                     PlaceholderText="Type to filter installed plugins" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="#8C8C8C"
                                       Text="{Binding InfoMessage}" />
                        </Grid>
                        <Border Grid.Row="2"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="2*,3*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="On" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="Installed" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding Plugins}"
                                                 SelectedItem="{Binding SelectedPlugin}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OptionsPluginItem">
                                                    <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"
                                                            Padding="8,6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <CheckBox
                                                                IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Type}" Foreground="#9CA3AF"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <Button Content="{Binding SelectedPlugin.Type}"
                                                Foreground="#9CA3AF"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding OpenSelectedPluginAuthorUrlCommand}" />
                                        <TextBlock Text="{Binding SelectedPlugin.ExtendedInfo}" Foreground="#8C8C8C"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Refresh"
                                                MinWidth="90"
                                                Command="{Binding RefreshPluginsCommand}" />
                                        <Button Content="Configure"
                                                MinWidth="90"
                                                Command="{Binding ConfigurePluginCommand}" />
                                    </StackPanel>
                                    <Border Grid.Row="2"
                                            BorderBrush="#2E2E2E"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10">
                                        <TextBlock Text="{Binding InfoMessage}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#CFCFCF" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                IsVisible="False"
                                Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="Actions" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh"
                                    MinWidth="90"
                                    Command="{Binding RefreshPluginsCommand}" />
                            <Button Content="Configure"
                                    MinWidth="90"
                                    Command="{Binding ConfigurePluginCommand}" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding ShowPluginInfoSection}"
                                   Text="{Binding InfoMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowLanguageSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="Application Settings" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="Language:" VerticalAlignment="Top" />
                            <ListBox Grid.Column="1"
                                     ItemsSource="{Binding Languages}"
                                     SelectedItem="{Binding SelectedLanguage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageItem">
                                        <TextBlock Text="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowMcpSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="MCP Server" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="Enabled:" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpServerEnabled}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="Show status icon:" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpStatusIconVisible}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnDefinitions="140,120,*" ColumnSpacing="10">
                            <TextBlock Text="Port:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     IsEnabled="{Binding IsMcpServerEnabled}"
                                     Text="{Binding McpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="Server URI:" VerticalAlignment="Center" />
                            <TextBox x:Name="McpUrlTextBox"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding McpBaseUrl}"
                                     DoubleTapped="OnMcpUrlDoubleTapped" />
                            <Button Grid.Column="2"
                                    Content="⧉"
                                    FontSize="14"
                                    MinWidth="34"
                                    ToolTip.Tip="{Binding McpCopyTooltip}"
                                    Click="OnCopyMcpUrlClicked" />
                        </Grid>
                        <Border IsVisible="{Binding ShowMcpAlert}"
                                Background="#1B5E20"
                                BorderBrush="#2E7D32"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding McpAlertMessage}"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowStatusesSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="Item Statuses" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="↺"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    ToolTip.Tip="Reset statuses"
                                    Command="{Binding ResetStatusVariantsCommand}" />
                            <Button Content="+"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding AddStatusVariantCommand}" />
                            <Button Content="-"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding RemoveStatusVariantCommand}" />
                        </StackPanel>

                        <Border BorderBrush="#2E2E2E"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="84,2*,2*" ColumnSpacing="10">
                                        <TextBlock Text="Icon" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Icon Key" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding StatusVariants}"
                                         SelectedItem="{Binding SelectedStatusVariant}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusVariantItemViewModel">
                                            <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid ColumnDefinitions="84,2*,2*" ColumnSpacing="10">
                                                    <Border Width="72"
                                                            Height="40"
                                                            BorderBrush="#4B5563"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Background="#1F2937"
                                                            Classes="status-icon-drop"
                                                            DragDrop.AllowDrop="True"
                                                            Tag="{Binding}"
                                                            PointerPressed="OnStatusIconSquarePointerPressed">
                                                        <Grid>
                                                            <Image Width="16"
                                                                   Height="16"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Source="{Binding IconGlyph, Converter={StaticResource IconConverter}}" />
                                                            <Border HorizontalAlignment="Center"
                                                                    VerticalAlignment="Top"
                                                                    Background="#111827"
                                                                    CornerRadius="3"
                                                                    Padding="4,1"
                                                                    Margin="2"
                                                                    IsVisible="{Binding IsDropHintVisible}">
                                                                <TextBlock Text="that droping there is posisble"
                                                                           FontSize="10"
                                                                           Foreground="#D1FAE5" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding IconGlyph}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowStatusAlert}"
                                Background="#7F1D1D"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding StatusAlertMessage}"
                                       Foreground="#FEE2E2"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="4"
                            IsVisible="{Binding ShowNoSearchResults}"
                            BorderBrush="#6A5C2D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <TextBlock Text="No settings match the current search."
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Save"
                        MinWidth="90"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="Cancel"
                        MinWidth="90"
                        IsCancel="True"
                        Click="OnCancelClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
