<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:marketplace="clr-namespace:SkyCD.Presentation.Marketplace;assembly=SkyCD.Presentation"
        xmlns:media="clr-namespace:SkyCD.SDK.Capabilities.Media;assembly=SkyCD.SDK"
        xmlns:hostmedia="clr-namespace:SkyCD.Plugin.Host.Media;assembly=SkyCD.Plugin.Host"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:lucide="clr-namespace:IconPacks.Avalonia.Lucide;assembly=IconPacks.Avalonia.Lucide"
        xmlns:multiSelect="clr-namespace:SkyCD.UI.Controls.Selectors.MultiSelectDropdown;assembly=SkyCD.UI"
        xmlns:colorSelect="clr-namespace:SkyCD.UI.Controls.Selectors.ColorPaletteDropdown;assembly=SkyCD.UI"
        xmlns:actions="clr-namespace:SkyCD.UI.Controls.Actions;assembly=SkyCD.UI"
        xmlns:search="clr-namespace:SkyCD.UI.Controls.SearchTextBox;assembly=SkyCD.UI"
        x:Class="SkyCD.App.Views.OptionsWindow"
        x:DataType="vm:OptionsDialogViewModel"
        Width="760"
        Height="520"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        CanMinimize="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.Options}}">

    <Design.DataContext>
        <vm:OptionsDialogViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.acpAgentCard">
            <Setter Property="BorderBrush" Value="{DynamicResource TabCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource SkyInsetMd}" />
        </Style>
        <Style Selector="Border.acpAgentCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SkyAcpAgentSelectedBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="{DynamicResource SkyInsetMd}" />
        </Style>
        <Style Selector="Button.acpUseAgent">
            <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.UseAcpAgent}}" />
        </Style>
        <!-- External links stay Buttons so Tab/Enter activate them, but render as links with the ↗ affordance. -->
        <Style Selector="Button.pluginLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pluginLink TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="Button.pluginLink:pointerover TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Border.acpAgentCard.selected Button.acpUseAgent">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Theme">
                <ControlTheme TargetType="Button">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{DynamicResource SkyAcpAgentSelectedBackground}" BorderBrush="{DynamicResource SkyAcpAgentSelectedBorder}" BorderThickness="1" CornerRadius="{DynamicResource SkyCornerRadiusMedium}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  Padding="{DynamicResource SkyControlPadding}" HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" Foreground="{DynamicResource SkyAcpAgentSelectedForeground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </Setter>
            <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentSelected}}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
        <converters:PluginIconConverter x:Key="PluginIconConverter" />
        <converters:PluginGlyphConverter x:Key="PluginGlyphConverter" />
        <converters:PluginBitmapConverter x:Key="PluginBitmapConverter" />
        <converters:IconGlyphToSymbolConverter x:Key="IconGlyphToSymbolConverter" />
        <converters:LanguageFlagImageConverter x:Key="LanguageFlagImageConverter" />
        <converters:StatusBadgeIconConverter x:Key="StatusBadgeIconConverter" />
        <converters:AcpAgentIconConverter x:Key="AcpAgentIconConverter" />
        <converters:AcpAgentSelectionConverter x:Key="AcpAgentSelectionConverter" />
        <converters:ToolbarIconConverter x:Key="ToolbarIconConverter" />
        <ItemsPanelTemplate x:Key="AcpAgentCardsPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="AcpAgentCardTemplate" x:DataType="media:AcpAgentChoice">
            <Border Classes="acpAgentCard" MinHeight="96" Margin="{DynamicResource SkyInsetXs}"
                    Background="{DynamicResource TabCardBackgroundBrush}"
                    CornerRadius="{DynamicResource SkyAcpAgentCardRadius}">
                <Classes.selected>
                    <MultiBinding Converter="{StaticResource AcpAgentSelectionConverter}">
                        <Binding />
                        <ReflectionBinding Path="DataContext.AcpCardAgent"
                                           RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                    </MultiBinding>
                </Classes.selected>
                <Grid ColumnSpacing="{DynamicResource SkySpaceSm}" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource SkySpaceSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource SkyAcpAgentIconColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="{DynamicResource SkyAcpAgentBadgeRadius}" Background="{DynamicResource SkyAcpAgentBadgeBackground}"
                            VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="{Binding IconLabel}" Foreground="White" FontWeight="SemiBold"
                                       IsVisible="{Binding !IconPaths.Count}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconPaths, Converter={StaticResource AcpAgentIconConverter}}"
                                   Width="20" Height="20" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource SkySpaceXs}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Description}" Opacity="0.78"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceXs}">
                        <TextBlock Text="{Binding DisplayVersion}" Opacity="0.7"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXs}">
                            <Button Classes="acpUseAgent" IsVisible="{Binding IsInstalled}"
                                    Click="OnSelectAcpAgentClicked" />
                            <Button IsVisible="{Binding CanInstall}" Click="OnInstallAcpAgentClicked"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.InstallAcpAgent}}" />
                            <Button IsVisible="{Binding CanUpdate}" Click="OnInstallAcpAgentClicked"
                                    ToolTip.Tip="{Binding RegistryVersion}"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.UpdateAcpAgent}}" />
                            <Button IsVisible="{Binding IsManaged}" Click="OnUninstallAcpAgentClicked"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.UninstallAcpAgent}}" />
                            <Button IsVisible="{Binding CanLocateExecutable}" Click="OnBrowseAcpAgentClicked"
                                    ToolTip.Tip="{Binding ExpectedExecutable}"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.LocateAcpAgent}}" />
                            <TextBlock IsVisible="{Binding !HasAvailableAction}" Opacity="0.7"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentUnavailable}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid
              IsEnabled="{Binding !ConfirmCommand.IsRunning}"
              Margin="{DynamicResource SkyInsetMd}"
             
              ColumnSpacing="{DynamicResource SkySpaceLg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SkyOptionsSidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SkyCornerRadius}"
                    Padding="{DynamicResource SkyInsetSm}"
                    Grid.RowSpan="2">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource SkySpaceSm}">
                    <search:SearchTextBox PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.Search}}"
                                                 Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <ListBox Grid.Row="1"
                             x:Name="SettingsCategoriesList"
                             ItemsSource="{Binding SidebarEntries}"
                             SelectedItem="{Binding SelectedSidebarEntry}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Focusable" Value="{ReflectionBinding !IsGroupHeader}" />
                            </Style>
                            <Style Selector="ListBoxItem TextBlock.sidebarGroup">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionsSidebarEntry">
                                <TextBlock Text="{Binding Title}"
                                           Margin="{Binding RowMargin}"
                                           Classes.sidebarGroup="{Binding IsGroupHeader}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               FontSize="{DynamicResource SkyFontCaption}"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.NavigateCategoriesHint}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SkyCornerRadius}"
                    Padding="{DynamicResource SkyInsetMd}">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="{DynamicResource SkySpaceSm}">
                    <TextBlock FontSize="{DynamicResource SkyFontSubtitle}" FontWeight="SemiBold"
                               TextWrapping="Wrap">
                        <Run Text="{i18n:Translate {x:Static i18n:UiKeys.Tools}}" />
                        <Run Text="  >  " />
                        <Run Text="{Binding CurrentCategoryPath}" />
                    </TextBlock>

                <Grid Grid.Row="2"
                      IsVisible="{Binding ShowPluginListSection}"
                      RowDefinitions="Auto,*"
                      RowSpacing="{DynamicResource SkySpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                        <search:SearchTextBox Text="{Binding PluginSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.FilterPlugins}}"
                                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.FilterPlugins}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXs}">
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.PluginUpdateAll}}"
                                    Command="{Binding UpdateAllPluginsCommand}"
                                    AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PluginUpdateAll}}" />
                            <Button AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PluginFilterAll}}"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.PluginManageHint}}">
                                <iconPacks:PackIconControl Kind="{x:Static lucide:PackIconLucideKind.Funnel}"
                                                           Width="14"
                                                           Height="14" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.PluginFilterAll}}"
                                                    Command="{Binding ShowAllPluginSectionsCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.PluginFilterInstalled}}"
                                                    Command="{Binding ShowInstalledPluginsOnlyCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.PluginFilterMarketplace}}"
                                                    Command="{Binding ShowMarketplacePluginsOnlyCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                    <StackPanel IsVisible="{Binding ShowInstalledPluginSection}"
                                                Spacing="{DynamicResource SkySpaceXxs}">
                                        <TextBlock Text="{Binding InstalledPluginsHeader}"
                                                   FontWeight="SemiBold"
                                                   Padding="{DynamicResource SkyInsetXs}" />
                                        <ListBox ItemsSource="{Binding FilteredPlugins}"
                                                 SelectedItem="{Binding SelectedPlugin}"
                                                 IsVisible="{Binding !ShowInstalledPluginsEmptyState}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="OnInstalledPluginsSelectionChanged">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OptionsPluginItem">
                                                    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="{DynamicResource SkyInsetSm}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                                              ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                            <Panel Width="32" Height="32" VerticalAlignment="Center">
                                                                <Image Source="{Binding ListIcon, Converter={StaticResource PluginBitmapConverter}}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                       IsVisible="{Binding HasListBitmapIcon}" />
                                                                <iconPacks:PackIconControl
                                                                    Kind="{x:Static lucide:PackIconLucideKind.Puzzle}"
                                                                    Width="28"
                                                                    Height="28"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                                    IsVisible="{Binding !HasListBitmapIcon}" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="{DynamicResource SkySpaceXxs}">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Type}"
                                                                           Classes="caption"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <ToggleSwitch Grid.Column="2"
                                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          OnContent=""
                                                                          OffContent=""
                                                                          MinWidth="0"
                                                                          VerticalAlignment="Center"
                                                                          AutomationProperties.Name="{Binding Name}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:TextKeys.PluginFilterNoMatches}}"
                                                   Classes="caption"
                                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                   Padding="{DynamicResource SkyInsetSm}"
                                                   TextWrapping="Wrap"
                                                   IsHitTestVisible="False"
                                                   IsVisible="{Binding ShowInstalledPluginsEmptyState}" />
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding ShowMarketplacePluginSection}"
                                                Spacing="{DynamicResource SkySpaceXxs}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding MarketplacePluginsHeader}"
                                                       FontWeight="SemiBold"
                                                       Padding="{DynamicResource SkyInsetXs}" />
                                            <Button Grid.Column="1"
                                                    Content="{Binding MarketplaceSectionToggleText}"
                                                    Command="{Binding ToggleMarketplaceSectionCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="{DynamicResource SkyInsetXs}" />
                                        </Grid>
                                        <StackPanel IsVisible="{Binding ShowMarketplaceSectionContent}"
                                                    Spacing="{DynamicResource SkySpaceXs}">
                                            <ProgressBar Height="3"
                                                         IsIndeterminate="True"
                                                         IsVisible="{Binding IsMarketplaceLoading}" />
                                            <TextBlock Text="{i18n:Translate {x:Static i18n:TextKeys.PluginCatalogEmpty}}"
                                                       Classes="caption"
                                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                       Padding="{DynamicResource SkyInsetSm}"
                                                       TextWrapping="Wrap"
                                                       IsHitTestVisible="False"
                                                       IsVisible="{Binding ShowMarketplacePaneEmptyState}" />
                                            <TextBlock Text="{i18n:Translate {x:Static i18n:TextKeys.PluginMarketplaceFilterNoMatches}}"
                                                       Classes="caption"
                                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                       Padding="{DynamicResource SkyInsetSm}"
                                                       TextWrapping="Wrap"
                                                       IsHitTestVisible="False"
                                                       IsVisible="{Binding ShowMarketplacePaneFilterEmptyState}" />
                                            <TextBlock Text="{Binding MarketplaceStatusMessage}"
                                                       Classes="caption"
                                                       Padding="{DynamicResource SkyInsetSm}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding ShowMarketplaceStatusMessage}" />
                                            <ListBox ItemsSource="{Binding FilteredMarketplacePlugins}"
                                                     SelectedItem="{Binding SelectedMarketplacePlugin}"
                                                     IsVisible="{Binding ShowMarketplacePaneList}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="OnMarketplacePluginsSelectionChanged">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    </Style>
                                                </ListBox.Styles>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="marketplace:MarketplacePluginItem">
                                                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="{DynamicResource SkyInsetSm}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                                <Panel Width="24" Height="24" VerticalAlignment="Center">
                                                                    <Image Source="{Binding IconKey, Converter={StaticResource PluginIconConverter}}"
                                                                           IsVisible="{Binding HasBitmapIcon}" />
                                                                    <iconPacks:PackIconControl
                                                                        Kind="{Binding IconKey, Converter={StaticResource PluginGlyphConverter}}"
                                                                        Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                                        IsVisible="{Binding HasGlyphIcon}" />
                                                                </Panel>
                                                                <StackPanel Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Spacing="{DynamicResource SkySpaceXxs}">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Publisher}"
                                                                               Classes="caption"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding VersionSummary}"
                                                                               Classes="caption"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                                                        Content="{Binding PrimaryActionLabel}"
                                                                        IsVisible="{Binding ShowPrimaryAction}"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding $parent[Window].((vm:OptionsDialogViewModel)DataContext).RequestMarketplaceInstallCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding !IsMarketplaceBrowseSelected}"
                              RowDefinitions="Auto,Auto,*"
                              RowSpacing="{DynamicResource SkySpaceSm}">
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock x:Name="SelectedPluginTitle"
                                               Text="{Binding SelectedPlugin.Name}"
                                               Classes="h2"
                                               TextWrapping="Wrap" />
                                    <Panel Grid.Column="1"
                                           Width="48"
                                           Height="48"
                                           VerticalAlignment="Top">
                                        <Image Source="{Binding SelectedPlugin.Icon, Converter={StaticResource PluginBitmapConverter}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                               IsVisible="{Binding SelectedPlugin.HasBitmapIcon}" />
                                        <iconPacks:PackIconControl
                                            Kind="{x:Static lucide:PackIconLucideKind.Puzzle}"
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                            IsVisible="{Binding !SelectedPlugin.HasBitmapIcon}" />
                                    </Panel>
                                </Grid>
                                <Button Content="{Binding SelectedPlugin.Type}"
                                        Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenSelectedPluginAuthorUrlCommand}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="{DynamicResource SkySpaceSm}">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                    <actions:SplitActionButton x:Name="InstalledPluginActionButton"
                                                               PrimaryContent="{Binding PluginPrimaryActionLabel}"
                                                               PrimaryCommand="{Binding ToggleSelectedPluginEnabledCommand}"
                                                               PrimaryToolTip="{Binding PluginPrimaryActionToolTip}"
                                                               IsPrimaryEnabled="{Binding !IsPluginActionBusy}"
                                                               IsSecondaryVisible="True"
                                                               IsSecondaryEnabled="{Binding !IsPluginActionBusy}"
                                                               SecondaryContent="{i18n:Translate {x:Static i18n:TextKeys.PluginUninstallAction}}"
                                                               SecondaryCommand="{Binding RequestPluginUninstallCommand}"
                                                               SecondaryToolTip="{i18n:Translate {x:Static i18n:TextKeys.PluginUninstallActionToolTip}}" />
                                    <TextBlock Text="{Binding SelectedPluginDetailsVersion}"
                                               Classes="caption"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border IsVisible="{Binding HasPluginUninstallConfirmation}"
                                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource SkyCornerRadius}"
                                        Padding="{DynamicResource SkyInsetSm}">
                                    <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{Binding PluginUninstallConfirmationPrompt}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                            <Button Content="{i18n:Translate {x:Static i18n:TextKeys.PluginUninstallAction}}"
                                                    MinWidth="90"
                                                    Command="{Binding ConfirmPluginUninstallCommand}" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                                                    MinWidth="90"
                                                    Command="{Binding CancelPluginUninstallCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding PluginActionAlertMessage}"
                                           IsVisible="{Binding HasPluginActionAlert}"
                                           Classes="caption"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TabControl Grid.Row="2">
                                <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.PluginTabOverview}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedPluginDescription}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ThemeForegroundBrush}"
                                                       IsVisible="{Binding HasPluginDescription}" />
                                            <TextBlock Text="{Binding SelectedPluginDescription}"
                                                       Classes="caption"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                       IsVisible="{Binding !HasPluginDescription}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.PluginTabConfiguration}}"
                                         IsVisible="{Binding HasPluginConfigurationPage}"
                                         IsSelected="{Binding IsPluginConfigurationTabSelected, Mode=TwoWay}">
                                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource SkySpaceSm}">
                                        <ProgressBar Height="3"
                                                     IsIndeterminate="True"
                                                     IsVisible="{Binding SelectedPluginConfigurationPage.IsLoading}" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedPluginConfigurationPage.Error}"
                                                   IsVisible="{Binding SelectedPluginConfigurationPage.HasError}"
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                                            <ContentControl Content="{Binding SelectedPluginConfigurationPage.Content}"
                                                            HorizontalContentAlignment="Stretch" />
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.PluginTabAdditionalInfo}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="{DynamicResource SkySpaceMd}">
                                            <StackPanel Spacing="{DynamicResource SkySpaceXs}">
                                                <Button Classes="pluginLink"
                                                        IsVisible="{Binding HasSelectedPluginDetailsProjectUrl}"
                                                        Command="{Binding OpenSelectedPluginProjectUrlCommand}"
                                                        ToolTip.Tip="{Binding SelectedPlugin.ProjectUrl}"
                                                        AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PluginProjectLinkLabel}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXxs}">
                                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginProjectLinkLabel}}" />
                                                        <TextBlock Text="↗" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="pluginLink"
                                                        IsVisible="{Binding HasSelectedPluginDetailsAuthorUrl}"
                                                        Command="{Binding OpenSelectedPluginAuthorUrlCommand}"
                                                        ToolTip.Tip="{Binding SelectedPlugin.AuthorUrl}"
                                                        AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PluginAuthorLinkLabel}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXxs}">
                                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginAuthorLinkLabel}}" />
                                                        <TextBlock Text="↗" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="Auto,*"
                                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  RowSpacing="{DynamicResource SkySpaceXs}"
                                                  ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginVendorLabel}}"
                                                           Classes="caption"
                                                           IsVisible="{Binding HasSelectedPluginDetailsType}" />
                                                <SelectableTextBlock Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsType}"
                                                                     TextWrapping="Wrap"
                                                                     IsVisible="{Binding HasSelectedPluginDetailsType}" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginVersionLabel}}"
                                                           Classes="caption"
                                                           IsVisible="{Binding HasSelectedPluginDetailsVersionNumber}" />
                                                <SelectableTextBlock Grid.Row="1"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsVersionNumber}"
                                                                     TextWrapping="Wrap"
                                                                     IsVisible="{Binding HasSelectedPluginDetailsVersionNumber}" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginSizeLabel}}"
                                                           Classes="caption"
                                                           IsVisible="{Binding HasSelectedPluginDetailsSize}" />
                                                <SelectableTextBlock Grid.Row="2"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsSize}"
                                                                     IsVisible="{Binding HasSelectedPluginDetailsSize}" />
                                                <TextBlock Grid.Row="3"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginIdentityLabel}}"
                                                           Classes="caption" />
                                                <SelectableTextBlock Grid.Row="3"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsId}"
                                                                     TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="4"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.Type}}"
                                                           Classes="caption"
                                                           IsVisible="{Binding HasSelectedPluginDetailsCapabilityType}" />
                                                <SelectableTextBlock Grid.Row="4"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsCapabilityType}"
                                                                     TextWrapping="Wrap"
                                                                     IsVisible="{Binding HasSelectedPluginDetailsCapabilityType}" />
                                                <TextBlock Grid.Row="5"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginExtensionLabel}}"
                                                           Classes="caption"
                                                           IsVisible="{Binding HasSelectedPluginDetailsExtension}" />
                                                <SelectableTextBlock Grid.Row="5"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsExtension}"
                                                                     IsVisible="{Binding HasSelectedPluginDetailsExtension}" />
                                                <TextBlock Grid.Row="6"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginUpdatesFromLabel}}"
                                                           Classes="caption"
                                                           IsVisible="{Binding HasSelectedPluginDetailsUpdateSource}" />
                                                <SelectableTextBlock Grid.Row="6"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedPluginDetailsUpdateSource}"
                                                                     IsVisible="{Binding HasSelectedPluginDetailsUpdateSource}" />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding IsMarketplaceBrowseSelected}"
                              RowDefinitions="Auto,Auto,*"
                              RowSpacing="{DynamicResource SkySpaceSm}">
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock x:Name="SelectedMarketplacePluginTitle"
                                               Text="{Binding SelectedMarketplacePlugin.Title}"
                                               Classes="h2"
                                               TextWrapping="Wrap" />
                                    <Panel Grid.Column="1"
                                           Width="24"
                                           Height="24"
                                           VerticalAlignment="Top">
                                        <Image Source="{Binding SelectedMarketplacePlugin.IconKey, Converter={StaticResource PluginIconConverter}}"
                                               IsVisible="{Binding SelectedMarketplacePlugin.HasBitmapIcon}" />
                                        <iconPacks:PackIconControl
                                            Kind="{Binding SelectedMarketplacePlugin.IconKey, Converter={StaticResource PluginGlyphConverter}}"
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                            IsVisible="{Binding SelectedMarketplacePlugin.HasGlyphIcon}" />
                                    </Panel>
                                </Grid>
                                <TextBlock Text="{Binding SelectedMarketplacePlugin.Publisher}"
                                           Classes="caption" />
                                <TextBlock Text="{Binding SelectedMarketplacePlugin.SourceLabel}"
                                           Classes="caption" />
                                <TextBlock Text="{Binding SelectedMarketplacePlugin.CompatibilityMessage}"
                                           Classes="caption"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="{DynamicResource SkySpaceSm}">
                                <Border IsVisible="{Binding IsInstallConfirmationVisible}"
                                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource SkyCornerRadius}"
                                        Padding="{DynamicResource SkyInsetSm}">
                                    <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{Binding ConfirmationPrompt}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:TextKeys.PluginRunsCodeNotice}}"
                                                   Classes="caption"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                            <Button Content="{Binding SelectedMarketplacePlugin.PrimaryActionLabel}"
                                                    MinWidth="90"
                                                    Command="{Binding ConfirmMarketplaceInstallCommand}" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                                                    MinWidth="90"
                                                    Command="{Binding CancelMarketplaceInstallCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ProgressBar Height="3"
                                             IsIndeterminate="True"
                                             IsVisible="{Binding SelectedMarketplacePlugin.IsBusy}" />
                                <TextBlock Text="{Binding SelectedMarketplacePlugin.StatusMessage}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedMarketplacePlugin.HasStatusMessage}" />
                                <TextBlock Text="{Binding SelectedMarketplacePlugin.ErrorMessage}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedMarketplacePlugin.HasError}" />
                                <actions:SplitActionButton x:Name="MarketplacePluginActionButton"
                                                           HorizontalAlignment="Left"
                                                           PrimaryContent="{Binding SelectedMarketplacePlugin.StatusLabel}"
                                                           PrimaryCommand="{Binding RequestMarketplaceInstallCommand}"
                                                           PrimaryCommandParameter="{Binding SelectedMarketplacePlugin}"
                                                           IsPrimaryEnabled="{Binding SelectedMarketplacePlugin.CanRunPrimaryAction}"
                                                           PrimaryToolTip="{i18n:Translate {x:Static i18n:TextKeys.PluginMarketplaceActionToolTip}}"
                                                           IsSecondaryVisible="{Binding SelectedMarketplacePlugin.CanUninstall}"
                                                           IsSecondaryEnabled="{Binding !IsPluginActionBusy}"
                                                           SecondaryContent="{i18n:Translate {x:Static i18n:TextKeys.PluginUninstallAction}}"
                                                           SecondaryCommand="{Binding RequestMarketplacePluginUninstallCommand}"
                                                           SecondaryToolTip="{i18n:Translate {x:Static i18n:TextKeys.PluginUninstallActionToolTip}}" />
                                <Border IsVisible="{Binding HasPluginUninstallConfirmation}"
                                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource SkyCornerRadius}"
                                        Padding="{DynamicResource SkyInsetSm}">
                                    <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{Binding PluginUninstallConfirmationPrompt}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                            <Button Content="{i18n:Translate {x:Static i18n:TextKeys.PluginUninstallAction}}"
                                                    MinWidth="90"
                                                    Command="{Binding ConfirmPluginUninstallCommand}" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                                                    MinWidth="90"
                                                    Command="{Binding CancelPluginUninstallCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding PluginActionAlertMessage}"
                                           IsVisible="{Binding HasPluginActionAlert}"
                                           Classes="caption"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TabControl Grid.Row="2">
                                <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.PluginTabOverview}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedMarketplacePlugin.Summary}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding SelectedMarketplacePlugin.HasSummary}" />
                                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NoPluginDescription}}"
                                                       Classes="caption"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                       IsVisible="{Binding ShowMarketplacePluginSummaryEmptyState}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.PluginTabAdditionalInfo}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="{DynamicResource SkySpaceMd}">
                                            <Button Classes="pluginLink"
                                                    IsVisible="{Binding HasSelectedMarketplaceProjectUrl}"
                                                    Command="{Binding OpenSelectedMarketplaceProjectUrlCommand}"
                                                    ToolTip.Tip="{Binding SelectedMarketplacePlugin.ProjectUrl}"
                                                    AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PluginProjectLinkLabel}}">
                                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXxs}">
                                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginProjectLinkLabel}}" />
                                                    <TextBlock Text="↗" />
                                                </StackPanel>
                                            </Button>
                                            <Grid ColumnDefinitions="Auto,*"
                                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                                  RowSpacing="{DynamicResource SkySpaceXs}"
                                                  ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginPublisherLabel}}"
                                                           Classes="caption" />
                                                <SelectableTextBlock Grid.Column="1"
                                                                     Text="{Binding SelectedMarketplacePlugin.Publisher}"
                                                                     TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginSourceLabel}}"
                                                           Classes="caption" />
                                                <SelectableTextBlock Grid.Row="1"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedMarketplacePlugin.Source}"
                                                                     TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.PluginVersionLabel}}"
                                                           Classes="caption" />
                                                <SelectableTextBlock Grid.Row="2"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedMarketplacePlugin.VersionSummary}"
                                                                     TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="3"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.Status}}"
                                                           Classes="caption" />
                                                <SelectableTextBlock Grid.Row="3"
                                                                     Grid.Column="1"
                                                                     Text="{Binding SelectedMarketplacePlugin.StatusLabel}"
                                                                     TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>

                    <StackPanel Grid.Row="3"
                                IsVisible="False"
                                Spacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Actions}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Refresh}}"
                                    MinWidth="90"
                                    Command="{Binding RefreshPluginsCommand}" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding ShowInstalledPluginInfoSection}"
                                   Text="{Binding InfoMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource SkySpaceSm}"
                          IsVisible="{Binding ShowPluginSettingsSection}">
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     IsVisible="{Binding SelectedPluginPage.IsLoading}" />
                        <TextBlock Grid.Row="1" Text="{Binding SelectedPluginPage.Error}"
                                   IsVisible="{Binding SelectedPluginPage.HasError}" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding SelectedPluginPage.Content}"
                                            HorizontalContentAlignment="Stretch" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowLanguageSection}"
                                Spacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ApplicationSettings}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SkySettingsLabelWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Language}}" VerticalAlignment="Top" />
                            <ListBox Grid.Column="1"
                                     ItemsSource="{Binding Languages}"
                                     SelectedItem="{Binding SelectedLanguage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageItem">
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}"
                                                    AutomationProperties.Name="{Binding Name}">
                                            <Image Width="20" Height="16"
                                                   Source="{Binding Flag, Converter={StaticResource LanguageFlagImageConverter}}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowMcpSection}"
                                Spacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.McpServerSettings}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SkySettingsLabelWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Enabled}}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpServerEnabled}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SkySettingsLabelWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ShowStatusIcon}}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpStatusIconVisible}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SkySettingsLabelWidth}" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     IsEnabled="{Binding IsMcpServerEnabled}"
                                     Text="{Binding McpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SkySettingsLabelWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ServerUri}}" VerticalAlignment="Center" />
                            <TextBox x:Name="McpUrlTextBox"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding McpBaseUrl}"
                                     DoubleTapped="OnMcpUrlDoubleTapped" />
                            <Button Grid.Column="2"
                                    Content="⧉"
                                    FontSize="{DynamicResource SkyFontBody}"
                                    MinWidth="34"
                                    ToolTip.Tip="{Binding McpCopyTooltip}"
                                    Click="OnCopyMcpUrlClicked" />
                        </Grid>
                        <Border IsVisible="{Binding ShowMcpAlert}"
                                Background="{DynamicResource SkyAlertSuccessBackground}"
                                BorderBrush="{DynamicResource SkyAlertSuccessBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SkyCornerRadius}"
                                Padding="{DynamicResource SkyControlPadding}">
                            <TextBlock Text="{Binding McpAlertMessage}"
                                       Foreground="White"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowPluginsSettingsSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginSettings}}"
                                       FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="{DynamicResource SkySpaceXs}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceXs}">
                                <TextBox Text="{Binding PluginPath, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="OnPluginPathFieldLostFocus"
                                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.PluginPath}}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding RescanPluginPathCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Content="{i18n:Translate {x:Static i18n:UiKeys.Browse}}"
                                        Command="{Binding BrowsePluginPathCommand}" />
                            </Grid>
                            <TextBlock Classes="caption"
                                       Text="{Binding InfoMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource SkyErrorForeground}"
                                       IsVisible="{Binding HasPluginPathHint}"
                                       Text="{Binding PluginPathHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="2"
                              RowDefinitions="Auto,Auto,*"
                              RowSpacing="{DynamicResource SkySpaceSm}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginRepositories}}"
                                               FontSize="{DynamicResource SkyFontBody}" />
                                    <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Classes="caption"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.PluginRepositoryHint}}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="{DynamicResource SkySpaceSm}">
                                        <Button Content="+"
                                                FontSize="{DynamicResource SkyFontSubtitle}"
                                                Width="34"
                                                Height="28"
                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddPluginRepositoryTooltip}}"
                                                Command="{Binding AddPluginRepositoryCommand}" />
                                        <Button Content="-"
                                                FontSize="{DynamicResource SkyFontSubtitle}"
                                                Width="34"
                                                Height="28"
                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemovePluginRepositoryTooltip}}"
                                                Command="{Binding RemovePluginRepositoryCommand}" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                            <Grid ColumnDefinitions="*,180" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginRepositoryColumn}}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{i18n:Translate {x:Static i18n:UiKeys.Status}}"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding PluginRepositories}"
                                                 SelectedItem="{Binding SelectedPluginRepository}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PluginRepositoryItemViewModel">
                                                    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                                        <Grid RowDefinitions="Auto,Auto"
                                                              ColumnDefinitions="*,180"
                                                              ColumnSpacing="{DynamicResource SkySpaceSm}"
                                                              RowSpacing="{DynamicResource SkySpaceXxs}">
                                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsReadOnly="{Binding IsBuiltIn}" />
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="{DynamicResource SkySpaceXs}">
                                                                <Border IsVisible="{Binding IsBuiltIn}"
                                                                        Background="{DynamicResource ThemeControlLowBrush}"
                                                                        CornerRadius="{DynamicResource SkyCornerRadius}"
                                                                        Padding="{DynamicResource SkyInsetXxs}">
                                                                    <TextBlock Classes="caption"
                                                                               Text="{i18n:Translate {x:Static i18n:UiKeys.PluginRepositoryBuiltIn}}" />
                                                                </Border>
                                                                <TextBlock Classes="caption"
                                                                           Text="{Binding StateLabel}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.ColumnSpan="2"
                                                                       Foreground="{DynamicResource SkyErrorForeground}"
                                                                       IsVisible="{Binding HasError}"
                                                                       Text="{Binding Error}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowStatusesSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ItemStatuses}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Spacing="{DynamicResource SkySpaceSm}">
                            <Button Content="↺"
                                    FontSize="{DynamicResource SkyFontSubtitle}"
                                    Width="34"
                                    Height="28"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetStatusesTooltip}}"
                                    Command="{Binding ResetStatusVariantsCommand}" />
                            <Button Content="+"
                                    FontSize="{DynamicResource SkyFontSubtitle}"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding AddStatusVariantCommand}" />
                            <Button Content="-"
                                    FontSize="{DynamicResource SkyFontSubtitle}"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding RemoveStatusVariantCommand}" />
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1"
                                Grid.Row="2">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                    <Grid ColumnDefinitions="2*,220,2*,140" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Status}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Icon}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{i18n:Translate {x:Static i18n:UiKeys.Type}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{i18n:Translate {x:Static i18n:UiKeys.Color}}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding StatusVariants}"
                                         SelectedItem="{Binding SelectedStatusVariant}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusVariantItemViewModel">
                                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                                <Grid ColumnDefinitions="2*,220,2*,140" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <multiSelect:MultiSelectDropdown Grid.Column="1"
                                                                                     IsIconPicker="True"
                                                                                     IconKeys="{Binding IconOptions}"
                                                                                     SelectedIconKey="{Binding IconGlyph, Mode=TwoWay}"
                                                                                     IsSingleSelect="True"
                                                                                     ShowItemLabels="False"
                                                                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SelectIcon}}">
                                                        <multiSelect:MultiSelectDropdown.ItemPreviewTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <ContentControl Width="16" Height="16"
                                                                                Foreground="{DynamicResource ThemeForegroundBrush}"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                VerticalContentAlignment="Stretch"
                                                                                Content="{Binding ., Converter={StaticResource StatusBadgeIconConverter}}" />
                                                            </DataTemplate>
                                                        </multiSelect:MultiSelectDropdown.ItemPreviewTemplate>
                                                    </multiSelect:MultiSelectDropdown>
                                                    <multiSelect:MultiSelectDropdown Grid.Column="2"
                                                                                     ItemsSource="{Binding TypeOptions}"
                                                                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SelectItemTypes}}" />
                                                    <colorSelect:ColorPaletteDropdownControl Grid.Column="3"
                                                                                             SelectedColor="{Binding IconColor, Mode=TwoWay}"
                                                                                             ItemsSource="{Binding ColorOptions}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowStatusAlert}"
                                Grid.Row="3"
                                Background="{DynamicResource SkyAlertErrorBackground}"
                                BorderBrush="{DynamicResource SkyAlertErrorBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SkyCornerRadius}"
                                Padding="{DynamicResource SkyControlPadding}">
                            <TextBlock Text="{Binding StatusAlertMessage}"
                                       Foreground="{DynamicResource SkyAlertErrorForeground}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowCustomPropertiesSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CustomProperties}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CustomPropertiesDescription}}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="{DynamicResource SkySpaceSm}">
                                <Button Content="+"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        Command="{Binding AddCustomPropertyCommand}"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddProperty}}" />
                                <Button Content="-"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        Command="{Binding RemoveCustomPropertyCommand}"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemoveProperty}}" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1"
                                Grid.Row="2">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PropertyName}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.DefaultValue}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding CustomProperties}"
                                         SelectedItem="{Binding SelectedCustomProperty}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomPropertyItemViewModel">
                                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="1" Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowCustomPropertyAlert}"
                                Grid.Row="3"
                                Background="{DynamicResource SkyAlertErrorBackground}"
                                BorderBrush="{DynamicResource SkyAlertErrorBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SkyCornerRadius}"
                                Padding="{DynamicResource SkyControlPadding}">
                            <TextBlock Text="{Binding CustomPropertyAlertMessage}"
                                       Foreground="{DynamicResource SkyAlertErrorForeground}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowCollectionsSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Collections}}"
                                       FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    Background="{DynamicResource ThemeBorderLowBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{DynamicResource SkySpaceXs}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="{DynamicResource SkySpaceSm}">
                                <Button Content="+"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        Command="{Binding CollectionsPage.AddCollectionCommand}"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.NewCollection}}" />
                                <Button Content="-"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        Command="{Binding CollectionsPage.DeleteCollectionCommand}"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.DeleteCollection}}" />
                            </StackPanel>
                            <Border IsVisible="{Binding CollectionsPage.IsDeleteCollectionConfirmationVisible}"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource SkyCornerRadius}"
                                    Padding="{DynamicResource SkyRowPadding}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{DynamicResource SkySpaceSm}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CollectionsPage.DeleteCollectionConfirmationPrompt}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                                            Command="{Binding CollectionsPage.ConfirmDeleteCollectionCommand}"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Ok}}" />
                                    <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                                            Command="{Binding CollectionsPage.CancelDeleteCollectionCommand}"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,*">
                                    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{DynamicResource SkyRowPadding}">
                                        <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CollectionName}}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{i18n:Translate {x:Static i18n:UiKeys.SavedSearch}}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{i18n:Translate {x:Static i18n:UiKeys.CollectionEntries}}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding CollectionsPage.Collections}"
                                             SelectedItem="{Binding CollectionsPage.SelectedCollection}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Collections}}">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.RemoveMissing}}"
                                                          Command="{Binding CollectionsPage.RemoveMissingEntriesCommand}" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CollectionListItemViewModel">
                                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="{DynamicResource SkyRowPadding}">
                                                    <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   IsVisible="{Binding !IsRenaming}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    IsVisible="{Binding IsRenaming}"
                                                                    Spacing="{DynamicResource SkySpaceXs}"
                                                                    VerticalAlignment="Center">
                                                            <TextBox Text="{Binding RenameDraft}"
                                                                     Width="200"
                                                                     AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.CollectionName}}" />
                                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Save}}"
                                                                    Command="{Binding $parent[Window].((vm:OptionsDialogViewModel)DataContext).CollectionsPage.CommitRenameCollectionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Save}}" />
                                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                                                                    Command="{Binding $parent[Window].((vm:OptionsDialogViewModel)DataContext).CollectionsPage.CancelRenameCollectionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                IsVisible="{Binding IsDynamic}"
                                                                Background="{DynamicResource ThemeControlLowBrush}"
                                                                CornerRadius="{DynamicResource SkyCornerRadius}"
                                                                Padding="{DynamicResource SkyInsetXxs}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Classes="caption"
                                                                       Text="{i18n:Translate {x:Static i18n:UiKeys.SavedSearch}}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="{DynamicResource SkySpaceXs}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EntrySummary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Content="✎"
                                                                    Command="{Binding $parent[Window].((vm:OptionsDialogViewModel)DataContext).CollectionsPage.BeginRenameCollectionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RenameCollection}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1"
                                                IsVisible="{Binding CollectionsPage.ShowEmptyCollectionsState}"
                                                Spacing="{DynamicResource SkySpaceXs}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NoCollections}}"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap" />
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CreateFirstCollection}}"
                                                HorizontalAlignment="Center"
                                                Click="OnCreateFirstCollectionClicked"
                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.CreateFirstCollection}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{DynamicResource SkyRowPadding}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CollectionMembers}}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="caption"
                                                       IsVisible="{Binding CollectionsPage.HasMissingMembers}"
                                                       Text="{Binding CollectionsPage.MissingMembersNotice}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="{DynamicResource SkySpaceXs}">
                                                <Button Content="+"
                                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                                        Width="34"
                                                        Height="28"
                                                        Command="{Binding CollectionsPage.AddSelectedEntriesCommand}"
                                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddSelected}}" />
                                                <Button Content="-"
                                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                                        Width="34"
                                                        Height="28"
                                                        Command="{Binding CollectionsPage.RequestRemoveSelectedMemberCommand}"
                                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Remove}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1"
                                            IsVisible="{Binding CollectionsPage.HasSavedQueryDescription}"
                                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{DynamicResource SkyRowPadding}">
                                        <TextBlock Classes="caption"
                                                   Text="{Binding CollectionsPage.SavedQueryDescription}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <Border Grid.Row="1"
                                            IsVisible="{Binding CollectionsPage.IsMissingSavedQuery}"
                                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{DynamicResource SkyRowPadding}">
                                        <TextBlock Classes="caption"
                                                   Text="{Binding CollectionsPage.NoSavedSearchNotice}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <search:SearchTextBox Grid.Row="2"
                                                                 Text="{Binding CollectionsPage.MemberFilterText}"
                                                                 Margin="{DynamicResource SkyRowPadding}"
                                                                 PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.FilterMembers}}"
                                                                 AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.FilterMembers}}" />
                                    <ListBox Grid.Row="3"
                                             ItemsSource="{Binding CollectionsPage.FilteredMembers}"
                                             SelectedItem="{Binding CollectionsPage.SelectedMember}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.CollectionMembers}}"
                                             DoubleTapped="OnCollectionMemberDoubleTapped">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.GoToEntry}}"
                                                          Command="{Binding CollectionsPage.NavigateToSelectedCommand}" />
                                                <MenuItem Header="{i18n:Translate {x:Static i18n:UiKeys.OpenFolder}}"
                                                          Command="{Binding CollectionsPage.OpenMemberFolderCommand}" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CollectionMemberViewModel">
                                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="{DynamicResource SkyRowPadding}">
                                                    <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FullPath}"
                                                                   Classes="caption"
                                                                   Opacity="0.7"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="3"
                                               IsHitTestVisible="False"
                                               IsVisible="{Binding CollectionsPage.ShowSelectCollectionHint}"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.SelectCollection}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3"
                                               IsHitTestVisible="False"
                                               IsVisible="{Binding CollectionsPage.ShowNoMembersHint}"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.NoMembers}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3"
                                               IsHitTestVisible="False"
                                               IsVisible="{Binding CollectionsPage.ShowNoFilterMatchHint}"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.NoFilterMatch}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                    <Border Grid.Row="4"
                                            IsVisible="{Binding CollectionsPage.IsRemoveMemberConfirmationVisible}"
                                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="{DynamicResource SkyRowPadding}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{DynamicResource SkySpaceSm}"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CollectionsPage.RemoveMemberConfirmationPrompt}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                                                    Command="{Binding CollectionsPage.ConfirmRemoveSelectedMemberCommand}"
                                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Ok}}" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                                                    Command="{Binding CollectionsPage.CancelRemoveMemberCommand}"
                                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding CollectionsPage.StatusText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowAccountsSection}"
                          RowDefinitions="Auto,*"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Accounts}}"
                                       FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    Background="{DynamicResource ThemeBorderLowBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="{DynamicResource SkyRowPadding}">
                                    <TextBlock Classes="caption"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.AccountsIntro}}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Accounts}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="{i18n:Translate {x:Static i18n:UiKeys.Accounts}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountConnectorItemViewModel">
                                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="{DynamicResource SkyRowPadding}">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                                      ColumnSpacing="{DynamicResource SkySpaceSm}"
                                                      RowSpacing="{DynamicResource SkySpaceXxs}">
                                                    <TextBlock Text="{Binding ProviderName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="{DynamicResource SkySpaceXs}"
                                                                VerticalAlignment="Center">
                                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AccountConnect}}"
                                                                IsVisible="{Binding ShowConnect}"
                                                                Command="{Binding ConnectCommand}"
                                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AccountConnect}}" />
                                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AccountSync}}"
                                                                IsVisible="{Binding ShowManage}"
                                                                Command="{Binding SyncCommand}"
                                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AccountSync}}" />
                                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AccountSignOut}}"
                                                                IsVisible="{Binding ShowManage}"
                                                                Command="{Binding SignOutCommand}"
                                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AccountSignOut}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding StateText}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Grid.Row="2"
                                                                Grid.ColumnSpan="2"
                                                                Orientation="Horizontal"
                                                                Spacing="{DynamicResource SkySpaceSm}">
                                                        <TextBlock Classes="caption"
                                                                   Opacity="0.7"
                                                                   Text="{Binding LastSyncedText}" />
                                                        <TextBlock Classes="caption"
                                                                   Opacity="0.7"
                                                                   IsVisible="{Binding HasProductCount}"
                                                                   Text="{Binding ProductCountText}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="3"
                                                               Grid.ColumnSpan="2"
                                                               IsVisible="{Binding HasError}"
                                                               Foreground="{DynamicResource SkyErrorForeground}"
                                                               Text="{Binding ErrorMessage}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="1"
                                            IsVisible="{Binding !HasAccounts}"
                                            Spacing="{DynamicResource SkySpaceXs}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AccountsEmpty}}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                    <TextBlock Classes="caption"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.AccountsEmptyHint}}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowContributedOptionsPageSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{Binding SelectedContributedPage.Title}"
                                       FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    Background="{DynamicResource ThemeBorderLowBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding SelectedContributedPage.Error}"
                                   IsVisible="{Binding SelectedContributedPage.HasError}"
                                   TextWrapping="Wrap" />
                        <ContentControl Grid.Row="2"
                                        Content="{Binding SelectedContributedPage.Content}"
                                        IsVisible="{Binding SelectedContributedPage.HasContent}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>
                    <Grid Grid.Row="2" IsVisible="{Binding ShowAcpSection}"
                          RowDefinitions="Auto,*,Auto">
                        <search:SearchTextBox Margin="{DynamicResource SkyGapBottomMd}"
                                                 PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SearchAcpAgents}}"
                                                 Text="{Binding AcpSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding !IsAcpLoading}" />

                        <Border Grid.Row="1" BorderBrush="{DynamicResource TabCardBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource SkyAcpAgentCardRadius}">
                            <Grid>
                                <ScrollViewer IsVisible="{Binding !IsAcpLoading}"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="{DynamicResource SkyInsetMd}" Spacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentInstalled}}" IsVisible="{Binding HasInstalledAcpAgents}"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding InstalledAcpAgents}" IsVisible="{Binding HasInstalledAcpAgents}"
                                                      ItemTemplate="{StaticResource AcpAgentCardTemplate}"
                                                      ItemsPanel="{StaticResource AcpAgentCardsPanel}" />
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentsAvailable}}" IsVisible="{Binding HasAvailableAcpAgents}"
                                                   FontWeight="SemiBold" Margin="{DynamicResource SkyGapTopSm}" />
                                        <ItemsControl ItemsSource="{Binding AvailableAcpAgents}" IsVisible="{Binding HasAvailableAcpAgents}"
                                                      ItemTemplate="{StaticResource AcpAgentCardTemplate}"
                                                      ItemsPanel="{StaticResource AcpAgentCardsPanel}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid IsVisible="{Binding !IsAcpLoading}">
                                    <TextBlock IsVisible="{Binding HasNoMatchingAcpAgents}"
                                               Text="{i18n:Translate {x:Static i18n:UiKeys.NoMatchingAcpAgents}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                                </Grid>
                                <StackPanel IsVisible="{Binding IsAcpLoading}" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Spacing="{DynamicResource SkySpaceSm}">
                                    <ProgressBar Width="124" Height="5" IsIndeterminate="{Binding IsAcpLoading}" />
                                    <TextBlock Text="{Binding AcpLoadingLabel}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Spacing="{DynamicResource SkySpaceSm}">
                            <TextBlock IsVisible="{Binding HasAcpRegistryStatus}" Text="{Binding AcpRegistryStatus}"
                                       Margin="{DynamicResource SkyGapTopSm}" TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasAcpAlert}" Text="{Binding AcpAlertMessage}"
                                       Margin="{DynamicResource SkyGapTopSm}" TextWrapping="Wrap" Foreground="{DynamicResource SkyErrorForeground}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowScanSection}"
                          RowDefinitions="*">
                        <ScrollViewer x:Name="ScanSettingsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanSettings}}" FontWeight="SemiBold" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipSymbolicLinks}}"
                                          IsChecked="{Binding SkipSymbolicLinks}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.HiddenSystemEntries}}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="220"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding HiddenSystemPolicyOptions}"
                                              SelectedIndex="{Binding SelectedHiddenSystemPolicyIndex}" />
                                </Grid>
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipRecycleBins}}"
                                          IsChecked="{Binding SkipRecycleBins}" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipWellKnownSystemFolders}}"
                                          IsChecked="{Binding SkipWellKnownSystemFolders}" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipEmptyFolders}}"
                                          IsChecked="{Binding SkipEmptyFolders}" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SkipOnlineOnlyCloudFiles}}"
                                          IsChecked="{Binding SkipOnlineOnlyCloudFiles}"
                                          IsVisible="{Binding IsOnlineOnlyCloudFilesOptionVisible}" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.IncludeExtendedInfo}}"
                                          IsChecked="{Binding IncludeExtendedInfo}" />
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyHeader}}"
                                           Margin="{DynamicResource SkyGapTopSm}"
                                           FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyMode}}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="220"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding ScanConcurrencyModeOptions}"
                                              SelectedIndex="{Binding SelectedScanConcurrencyModeIndex}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}"
                                      IsVisible="{Binding IsManualScanConcurrency}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyManualWorkers}}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Width="140"
                                                   HorizontalAlignment="Left"
                                                   Minimum="1"
                                                   Maximum="32"
                                                   Increment="1"
                                                   FormatString="0"
                                                   Value="{Binding ScanConcurrencyManualWorkers}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyCpuShare}}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Width="140"
                                                   HorizontalAlignment="Left"
                                                   Minimum="1"
                                                   Maximum="100"
                                                   Increment="5"
                                                   FormatString="0"
                                                   Value="{Binding ScanConcurrencyCpuSharePercent}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyLoadShrink}}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Width="140"
                                                   HorizontalAlignment="Left"
                                                   Minimum="1"
                                                   Maximum="99"
                                                   Increment="5"
                                                   FormatString="0"
                                                   Value="{Binding ScanConcurrencyLoadShrinkPercent}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyLoadSuspend}}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Width="140"
                                                   HorizontalAlignment="Left"
                                                   Minimum="2"
                                                   Maximum="100"
                                                   Increment="5"
                                                   FormatString="0"
                                                   Value="{Binding ScanConcurrencyLoadSuspendPercent}" />
                                </Grid>
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanConcurrencyHint}}"
                                           FontSize="{DynamicResource SkyFontCaption}"
                                           TextWrapping="Wrap"
                                           Opacity="0.75" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.ShowScanErrorsAfterScan}}"
                                          IsChecked="{Binding ShowScanErrorsAfterScan}" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.SaveScanErrorsToComments}}"
                                          IsChecked="{Binding SaveScanErrorsToComments}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowScanRulesSection}"
                          RowDefinitions="Auto,*,Auto"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ExclusionRules}}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="{DynamicResource SkySpaceSm}">
                                <Button Content="↺"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetRulesTooltip}}"
                                        Command="{Binding ResetScanExclusionRulesCommand}" />
                                <Button Content="+"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddRule}}"
                                        Command="{Binding AddScanExclusionRuleCommand}" />
                                <Button Content="-"
                                        FontSize="{DynamicResource SkyFontSubtitle}"
                                        Width="34"
                                        Height="28"
                                        ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemoveRule}}"
                                        Command="{Binding RemoveScanExclusionRuleCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1"
                                Grid.Row="1"
                                x:Name="ScanExclusionRulesBorder">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                    <Grid ColumnDefinitions="2*,160,120" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Pattern}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.EntryType}}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.IncludeByMask}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         x:Name="ScanExclusionRulesList"
                                         ItemsSource="{Binding ScanExclusionRules}"
                                         SelectedItem="{Binding SelectedScanExclusionRule}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScanExclusionRuleItemViewModel">
                                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                                <Grid ColumnDefinitions="2*,160,120" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                    <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding EntryTypeOptions}"
                                                              SelectedIndex="{Binding EntryTypeIndex, Mode=TwoWay}" />
                                                    <CheckBox Grid.Column="2"
                                                              IsChecked="{Binding IsInclude, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.IncludeByMask}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowScanAlert}"
                                Grid.Row="2"
                                Background="{DynamicResource SkyAlertErrorBackground}"
                                BorderBrush="{DynamicResource SkyAlertErrorBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SkyCornerRadius}"
                                Padding="{DynamicResource SkyControlPadding}">
                            <TextBlock Text="{Binding ScanAlertMessage}"
                                       Foreground="{DynamicResource SkyAlertErrorForeground}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowScanCompletionSection}"
                          RowDefinitions="*">
                        <ScrollViewer x:Name="ScanCompletionScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ScanCompletionHeader}}"
                                           FontWeight="SemiBold" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.EjectMediaAfterScan}}"
                                          IsChecked="{Binding EjectMediaAfterScan}"
                                          IsEnabled="{Binding IsMediaEjectionSupported}" />
                                <TextBlock Text="{Binding MediaEjectionSupportHint}"
                                           Margin="{DynamicResource SkyCheckboxHintIndent}"
                                           FontSize="{DynamicResource SkyFontCaption}"
                                           TextWrapping="Wrap"
                                           Opacity="0.75" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.ActivateMainWindowAfterScan}}"
                                          IsChecked="{Binding ActivateMainWindowAfterScan}" />
                                <CheckBox Content="{i18n:Translate {x:Static i18n:UiKeys.PlaySoundAfterScan}}"
                                          IsChecked="{Binding PlaySoundAfterScan}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowDetailsColumnsSection}"
                          RowDefinitions="Auto,Auto,Auto,*"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.DetailsColumns}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.DetailsColumnsDescription}}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                            <Button Content="↑"
                                    FontSize="{DynamicResource SkyFontSubtitle}"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding MoveDetailsColumnUpCommand}"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.MoveUp}}" />
                            <Button Content="↓"
                                    FontSize="{DynamicResource SkyFontSubtitle}"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding MoveDetailsColumnDownCommand}"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.MoveDown}}" />
                        </StackPanel>

                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1">
                            <ListBox ItemsSource="{Binding DetailsColumns}"
                                     SelectedItem="{Binding SelectedDetailsColumn}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailsColumnOptionItemViewModel">
                                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsRemovable}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Header}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RequiredLabel}"
                                                           IsVisible="{Binding IsRequired}"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowToolbarSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Toolbar}}" FontSize="{DynamicResource SkyFontBody}" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{i18n:Translate {x:Static i18n:UiKeys.CustomizeToolbarHint}}"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{i18n:Translate {x:Static i18n:UiKeys.ToolbarCommands}}"
                                           Margin="{DynamicResource SkyGapBottomXs}" />
                                <ListBox ItemsSource="{Binding Toolbar.AvailableCommands}"
                                         SelectedItem="{Binding Toolbar.SelectedCommand}"
                                         DoubleTapped="OnToolbarCommandDoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolbarCommandChoiceViewModel">
                                            <!-- Every command carries an icon (issue #933); it shares the toolbar slot. -->
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="{DynamicResource SkySpaceXs}"
                                                  Margin="{DynamicResource SkyGapYXxs}">
                                                <Image Width="{DynamicResource SkyIconSize}"
                                                       Height="{DynamicResource SkyIconSize}"
                                                       Source="{Binding IconPath, Converter={StaticResource ToolbarIconConverter}}"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}" />
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="{DynamicResource SkyFontCaption}"
                                                               Opacity="0.65" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="{DynamicResource SkySpaceSm}"
                                        VerticalAlignment="Center">
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AddToolbarButton}}"
                                        Command="{Binding Toolbar.AddCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AddSeparator}}"
                                        Command="{Binding Toolbar.AddSeparatorCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.RemoveToolbarButton}}"
                                        Command="{Binding Toolbar.RemoveCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MoveUp}}"
                                        Command="{Binding Toolbar.MoveUpCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MoveDown}}"
                                        Command="{Binding Toolbar.MoveDownCommand}"
                                        MinWidth="110" />
                                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.ResetToolbar}}"
                                        Command="{Binding Toolbar.ResetCommand}"
                                        MinWidth="110" />
                            </StackPanel>

                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{i18n:Translate {x:Static i18n:UiKeys.ToolbarButtons}}"
                                           Margin="{DynamicResource SkyGapBottomXs}" />
                                <ListBox ItemsSource="{Binding Toolbar.SelectedItems}"
                                         SelectedItem="{Binding Toolbar.SelectedItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolbarEntryViewModel">
                                            <Grid Margin="{DynamicResource SkyInsetXxs}"
                                                  ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="{DynamicResource SkySpaceXs}">
                                                <!-- A separator keeps its plain line: its IconPath is null, so no image resolves and the line spans the row. -->
                                                <Image Width="{DynamicResource SkyIconSize}"
                                                       Height="{DynamicResource SkyIconSize}"
                                                       Source="{Binding IconPath, Converter={StaticResource ToolbarIconConverter}}"
                                                       IsVisible="{Binding !IsSeparator}"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           IsVisible="{Binding !IsSeparator}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Height="1"
                                                        Background="{DynamicResource ThemeBorderMidBrush}"
                                                        IsVisible="{Binding IsSeparator}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowAiDescriptionSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <ScrollViewer x:Name="AiDescriptionSettingsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiDescription}}"
                                               FontSize="{DynamicResource SkyFontBody}"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid
                                      ColumnSpacing="{DynamicResource SkySpaceSm}"
                                      IsVisible="{Binding ShowAiDescriptionImplementationSection}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiImplementation}}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AiDescriptionImplementations}"
                                              SelectedItem="{Binding SelectedAiDescriptionImplementation}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="hostmedia:AiDescriptionImplementationChoice">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                    <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiScanSettings}}" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.MaxAiScanFileSize}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding AiScanMaxFileSizeMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                Margin="{DynamicResource SkyGapYXxs}"
                                Background="{DynamicResource ThemeBorderLowBrush}" />

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="{DynamicResource SkySpaceSm}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiMimeExclusions}}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="{DynamicResource SkySpaceSm}">
                                    <Button Content="↺"
                                            FontSize="{DynamicResource SkyFontSubtitle}"
                                            Width="34"
                                            Height="28"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetMimeTypesTooltip}}"
                                            Command="{Binding ResetAiScanExclusionsCommand}" />
                                    <Button Content="+"
                                            FontSize="{DynamicResource SkyFontSubtitle}"
                                            Width="34"
                                            Height="28"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AddMimeType}}"
                                            Command="{Binding AddAiScanExclusionCommand}" />
                                    <Button Content="-"
                                            FontSize="{DynamicResource SkyFontSubtitle}"
                                            Width="34"
                                            Height="28"
                                            ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RemoveMimeType}}"
                                            Command="{Binding RemoveAiScanExclusionCommand}" />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="AiScanExclusionsListBorder"
                                    Grid.Row="1"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="1">
                                <Grid RowDefinitions="Auto,*">
                                    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.MimeType}}" FontWeight="SemiBold" />
                                    </Border>
                                    <ListBox x:Name="AiScanExclusionsList"
                                             Grid.Row="1"
                                             ItemsSource="{Binding AiScanExclusions}"
                                             SelectedItem="{Binding SelectedAiScanExclusion}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiScanExclusionItemViewModel">
                                                <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{DynamicResource SkyRowPadding}">
                                                    <TextBox Text="{Binding MimeType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3"
                                IsVisible="{Binding ShowAiDescriptionAlert}"
                                Background="{DynamicResource SkyAlertErrorBackground}"
                                BorderBrush="{DynamicResource SkyAlertErrorBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SkyCornerRadius}"
                                Padding="{DynamicResource SkyControlPadding}">
                            <TextBlock Text="{Binding AiDescriptionAlertMessage}"
                                       Foreground="{DynamicResource SkyAlertErrorForeground}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding ShowAiProviderSection}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderCategory}}"
                                           FontSize="{DynamicResource SkyFontBody}"
                                           FontWeight="SemiBold" />
                                <Border Grid.Column="1" Height="1" Background="{DynamicResource ThemeBorderLowBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource SkyCornerRadius}"
                                    Background="{DynamicResource ThemeControlLowBrush}"
                                    Padding="{DynamicResource SkyInsetMd}">
                                <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProvider}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AiProviders}"
                                                  SelectedItem="{Binding SelectedAiProvider}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="media:AiProviderChoice">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.InternetProtocol}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AiProviderProtocols}"
                                                  SelectedItem="{Binding AiProviderProtocol}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding AiProviderPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderAddress}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding AiProviderAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderEndpoint}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 IsReadOnly="True"
                                                 Text="{Binding AiProviderEndpointUrl}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderApiKey}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 PasswordChar="*"
                                                 Text="{Binding AiProviderApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderModel}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding AiProviderModels}"
                                                  Text="{Binding AiProviderModel, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Content="↻"
                                                FontSize="{DynamicResource SkyFontSubtitle}"
                                                Width="34"
                                                Height="28"
                                                ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.AiProviderRefreshModels}}"
                                                Command="{Binding RefreshAiProviderModelsCommand}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AiProviderOutputLanguage}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AiProviderLanguages}"
                                                  SelectedItem="{Binding AiProviderLanguage}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="1"
                                                  Content="{i18n:Translate {x:Static i18n:UiKeys.AiProviderResizeImages}}"
                                                  IsChecked="{Binding AiProviderResizeLargeImages}" />
                                    </Grid>
                                    <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SkyFormLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AiProviderCheckConnection}}"
                                                    Command="{Binding CheckAiProviderConnectionCommand}" />
                                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.AiProviderStartServer}}"
                                                    IsVisible="{Binding AiProviderCanStartServer}"
                                                    Command="{Binding StartAiProviderServerCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding AiProviderConnectionStatus}"
                                               Foreground="{DynamicResource SkyStatusInfoForeground}"
                                               TextWrapping="Wrap" />
                                    <Border IsVisible="{Binding ShowAiProviderAlert}"
                                            Background="{DynamicResource SkyAlertErrorBackground}"
                                            BorderBrush="{DynamicResource SkyAlertErrorBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource SkyCornerRadius}"
                                            Padding="{DynamicResource SkyControlPadding}">
                                        <TextBlock Text="{Binding AiProviderAlertMessage}"
                                                   Foreground="{DynamicResource SkyAlertErrorForeground}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowMcpToolsSection}"
                          RowDefinitions="Auto,Auto,Auto,*"
                          RowSpacing="{DynamicResource SkySpaceSm}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.McpTools}}"
                                       FontSize="{DynamicResource SkyFontBody}"
                                       FontWeight="SemiBold" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    Background="{DynamicResource ThemeBorderLowBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <search:SearchTextBox Grid.Row="1"
                                                 PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SearchMcpTools}}"
                                                 Text="{Binding McpToolSearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource SkySpaceSm}">
                            <TextBlock Text="{Binding McpExposedSummary}"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.SelectAll}}"
                                    Command="{Binding SelectAllMcpToolsCommand}" />
                            <Button Grid.Column="2"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.ClearAll}}"
                                    Command="{Binding ClearMcpToolsCommand}" />
                        </Grid>

                        <Grid Grid.Row="3" RowDefinitions="*,Auto" RowSpacing="{DynamicResource SkySpaceSm}">
                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource SkyCornerRadius}"
                                    Background="{DynamicResource ThemeControlLowBrush}">
                                <ListBox ItemsSource="{Binding FilteredMcpTools}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="{DynamicResource SkyInsetXs}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:McpToolItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="{DynamicResource SkySpaceSm}">
                                                <CheckBox IsChecked="{Binding IsExposed}"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="{Binding Name}" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="{DynamicResource SkySpaceXxs}"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Name}" />
                                                    <TextBlock Text="{Binding CommandPath}"
                                                               FontSize="{DynamicResource SkyFontSecondary}"
                                                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding CommandPath}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       IsVisible="{Binding ShowNoMatchingMcpTools}"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.NoMatchingTools}}"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="4"
                            IsVisible="{Binding ShowNoSearchResults}"
                            BorderBrush="{DynamicResource SkyAlertWarningBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource SkyCornerRadius}"
                            Padding="{DynamicResource SkyInsetMd}">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NoSettingsMatch}}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0" Padding="{DynamicResource SkyInsetMd}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{DynamicResource SkySpaceSm}">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Save}}"
                        MinWidth="90"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                        MinWidth="90"
                        IsCancel="True"
                        Click="OnCancelClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
