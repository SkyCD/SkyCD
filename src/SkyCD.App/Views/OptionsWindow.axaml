<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        xmlns:multiSelect="clr-namespace:SkyCD.UI.Controls.Selectors.MultiSelectDropdown;assembly=SkyCD.UI"
        xmlns:colorSelect="clr-namespace:SkyCD.UI.Controls.Selectors.ColorPaletteDropdown;assembly=SkyCD.UI"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        x:Class="SkyCD.App.Views.OptionsWindow"
        x:DataType="vm:OptionsDialogViewModel"
        Width="760"
        Height="520"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        CanMinimize="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.Options}}">

    <Design.DataContext>
        <vm:OptionsDialogViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
        <converters:IconGlyphToSymbolConverter x:Key="IconGlyphToSymbolConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Padding="14,10,14,8">
            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Settings}}"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1"
              Margin="14,10,14,10"
              ColumnDefinitions="250,*"
              ColumnSpacing="14">
            <Border BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Grid.RowSpan="2">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBox PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.Search}}"
                             Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredSettingCategories}"
                             SelectedItem="{Binding SelectedSettingCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="8,5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Foreground="#8C8C8C"
                               FontSize="11"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.NavigateCategoriesHint}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="{i18n:Translate {x:Static i18n:UiKeys.Tools}}" />
                        <Run Text="  >  " />
                        <Run Text="{Binding CurrentCategoryName}" />
                    </TextBlock>

                    <StackPanel Grid.Row="1"
                                IsVisible="{Binding ShowPluginPathSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ProjectSettings}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.PluginPath}}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PluginPath}" />
                            <Button Grid.Column="2"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.Browse}}"
                                    MinWidth="90"
                                    Command="{Binding BrowsePluginPathCommand}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowPluginListSection}"
                          RowDefinitions="Auto,Auto,*"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Plugins}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBox Width="260"
                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.FilterPlugins}}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="#8C8C8C"
                                       Text="{Binding InfoMessage}" />
                        </Grid>
                        <Border Grid.Row="2"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="2*,3*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.On}}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Installed}}" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding Plugins}"
                                                 SelectedItem="{Binding SelectedPlugin}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OptionsPluginItem">
                                                    <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"
                                                            Padding="8,6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <CheckBox
                                                                IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Type}" Foreground="#9CA3AF"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <Button Content="{Binding SelectedPlugin.Type}"
                                                Foreground="#9CA3AF"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding OpenSelectedPluginAuthorUrlCommand}" />
                                        <TextBlock Text="{Binding SelectedPlugin.ExtendedInfo}" Foreground="#8C8C8C"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Refresh}}"
                                                MinWidth="90"
                                                Command="{Binding RefreshPluginsCommand}" />
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Configure}}"
                                                MinWidth="90"
                                                Command="{Binding ConfigurePluginCommand}" />
                                    </StackPanel>
                                    <Border Grid.Row="2"
                                            BorderBrush="#2E2E2E"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10">
                                        <TextBlock Text="{Binding InfoMessage}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#CFCFCF" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                IsVisible="False"
                                Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Actions}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Refresh}}"
                                    MinWidth="90"
                                    Command="{Binding RefreshPluginsCommand}" />
                            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Configure}}"
                                    MinWidth="90"
                                    Command="{Binding ConfigurePluginCommand}" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding ShowPluginInfoSection}"
                                   Text="{Binding InfoMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowLanguageSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ApplicationSettings}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Language}}" VerticalAlignment="Top" />
                            <ListBox Grid.Column="1"
                                     ItemsSource="{Binding Languages}"
                                     SelectedItem="{Binding SelectedLanguage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageItem">
                                        <TextBlock Text="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding ShowMcpSection}"
                                Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.McpServer}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Enabled}}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpServerEnabled}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ShowStatusIcon}}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsMcpStatusIconVisible}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        </Grid>
                        <Grid ColumnDefinitions="140,120,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Port}}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     IsEnabled="{Binding IsMcpServerEnabled}"
                                     Text="{Binding McpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ServerUri}}" VerticalAlignment="Center" />
                            <TextBox x:Name="McpUrlTextBox"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding McpBaseUrl}"
                                     DoubleTapped="OnMcpUrlDoubleTapped" />
                            <Button Grid.Column="2"
                                    Content="⧉"
                                    FontSize="14"
                                    MinWidth="34"
                                    ToolTip.Tip="{Binding McpCopyTooltip}"
                                    Click="OnCopyMcpUrlClicked" />
                        </Grid>
                        <Border IsVisible="{Binding ShowMcpAlert}"
                                Background="#1B5E20"
                                BorderBrush="#2E7D32"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding McpAlertMessage}"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2"
                          IsVisible="{Binding ShowStatusesSection}"
                          RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.ItemStatuses}}" FontSize="15" />
                            <Border Grid.Column="1" Height="1" Background="#2E2E2E" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="↺"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.ResetStatusesTooltip}}"
                                    Command="{Binding ResetStatusVariantsCommand}" />
                            <Button Content="+"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding AddStatusVariantCommand}" />
                            <Button Content="-"
                                    FontSize="16"
                                    Width="34"
                                    Height="28"
                                    Command="{Binding RemoveStatusVariantCommand}" />
                        </StackPanel>

                        <Border BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Grid.Row="2">
                            <Grid RowDefinitions="Auto,*">
                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="2*,220,2*,140" ColumnSpacing="10">
                                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.Status}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{i18n:Translate {x:Static i18n:UiKeys.Icon}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{i18n:Translate {x:Static i18n:UiKeys.Type}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{i18n:Translate {x:Static i18n:UiKeys.Color}}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding StatusVariants}"
                                         SelectedItem="{Binding SelectedStatusVariant}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusVariantItemViewModel">
                                            <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid ColumnDefinitions="2*,220,2*,140" ColumnSpacing="10">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <multiSelect:MultiSelectDropdown Grid.Column="1"
                                                                                     ItemsSource="{Binding IconOptionItems}"
                                                                                     IsSingleSelect="True"
                                                                                     ShowIconSymbols="True"
                                                                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SelectIcon}}" />
                                                    <multiSelect:MultiSelectDropdown Grid.Column="2"
                                                                                     ItemsSource="{Binding TypeOptions}"
                                                                                     PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SelectItemTypes}}" />
                                                    <colorSelect:ColorPaletteDropdownControl Grid.Column="3"
                                                                                             SelectedColor="{Binding IconColor, Mode=TwoWay}"
                                                                                             ItemsSource="{Binding ColorOptions}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowStatusAlert}"
                                Grid.Row="3"
                                Background="#7F1D1D"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock Text="{Binding StatusAlertMessage}"
                                       Foreground="#FEE2E2"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="4"
                            IsVisible="{Binding ShowNoSearchResults}"
                            BorderBrush="#6A5C2D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NoSettingsMatch}}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Save}}"
                        MinWidth="90"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                        MinWidth="90"
                        IsCancel="True"
                        Click="OnCancelClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
