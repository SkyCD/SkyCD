<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:cp="clr-namespace:SkyCD.UI.Controls.Properties;assembly=SkyCD.UI"
        xmlns:rt="clr-namespace:SkyCD.UI.Controls.RichText;assembly=SkyCD.UI"
        xmlns:rating="clr-namespace:SkyCD.UI.Controls.Rating;assembly=SkyCD.UI"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        x:Class="SkyCD.App.Views.PropertiesWindow"
        x:DataType="vm:PropertiesDialogViewModel"
        Width="411"
        Height="560"
        CanResize="False"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.Properties}}">

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
    </Window.Resources>

    <Window.Styles>
        <!--
            The value editor is part of the grid: it keeps the row's own background so the selection stays
            visible, and shows only an outer focus ring so it never draws a second box inside the cell.
        -->
        <Style Selector="TextBox.property-value-editor">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <!-- Cancel the cell padding so the text sits exactly where the row shows it; the ring covers the cell. -->
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="-8,-4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBox.property-value-editor /template/ TextPresenter">
            <!-- The cell already wraps its text; keep the editor at the cell width so neither overflows. -->
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.property-value-editor:pointerover /template/ TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.property-value-editor:focus /template/ TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="0">
        <TabControl x:Name="Tabs" Margin="8,8,8,0" SelectedIndex="0" TabStripPlacement="Top">
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.General}}">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8">
                        <Border Grid.RowSpan="2"
                                Width="{Binding #NameFields.Bounds.Height}"
                                Height="{Binding #NameFields.Bounds.Height}"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                CornerRadius="2">
                            <Image Width="24" Height="24"
                                   Source="{Binding IconGlyph, Converter={StaticResource IconConverter}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <StackPanel x:Name="NameFields"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Spacing="{DynamicResource SkySpaceXxs}">
                            <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NameLabel}}" VerticalAlignment="Top" />
                            <TextBox Text="{Binding Name}" />
                        </StackPanel>

                        <Grid x:Name="RatingRow"
                              Grid.Row="2"
                              Grid.Column="2"
                              ColumnDefinitions="Auto,*"
                              Margin="0,10,0,0">
                            <TextBlock x:Name="RatingLabel"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.RatingName}}"
                                       VerticalAlignment="Center" />
                            <rating:StarRatingControl Grid.Column="1"
                                                      Classes="star-rating"
                                                      StarSize="18"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      RatingName="{i18n:Translate {x:Static i18n:UiKeys.RatingName}}"
                                                      Value="{Binding Rating, Mode=TwoWay}"
                                                      ToolTip.Tip="{i18n:Translate {x:Static i18n:UiKeys.RatingKeyboardHint}}" />
                        </Grid>
                    </Grid>

                    <!-- The description lives in the Properties list; the comments editor takes the rest of the tab. -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,*">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CommentsLabel}}" VerticalAlignment="Top" />
                        <rt:RichTextEditor Grid.Row="1"
                                           Margin="0,4,0,0"
                                           RtfText="{Binding Comments, Mode=TwoWay}" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.Properties}}" IsVisible="{Binding HasInfoTab}">
                <cp:PropertiesList x:Name="InfoPropertiesList"
                                   PropertiesData="{Binding InfoProperties}"
                                   DescriptionRowHeader="{Binding DescriptionHeader}"
                                   PropertyHeader="{i18n:Translate {x:Static i18n:UiKeys.Property}}"
                                   ValueHeader="{i18n:Translate {x:Static i18n:UiKeys.Value}}">
                    <!-- The description row shows the unified value with its source annotation and AI actions. -->
                    <cp:PropertiesList.ValueCellTemplate>
                        <DataTemplate x:DataType="cp:PropertiesRow">
                            <Panel>
                                <TextBlock Text="{Binding Value}"
                                           IsVisible="{Binding !IsDescriptionRow}"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="{DynamicResource SkySpaceXxs}"
                                            IsVisible="{Binding IsDescriptionRow}">
                                    <TextBlock Text="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.DescriptionText}"
                                               TextWrapping="Wrap"
                                               MaxHeight="120"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.SourceText}"
                                               FontSize="{DynamicResource SkyFontCaption}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <TextBlock Text="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.StateText}"
                                               FontSize="{DynamicResource SkyFontCaption}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXs}">
                                        <Button Content="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.GenerateButtonText}"
                                                Command="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.GenerateCommand}"
                                                IsVisible="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.CanShowGenerate}"
                                                IsEnabled="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.CanGenerate}"
                                                Padding="6,2" />
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.CopyDescription}}"
                                                Command="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.CopyCommand}"
                                                IsEnabled="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.CanCopy}"
                                                Padding="6,2" />
                                        <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Clear}}"
                                                Command="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.ClearCommand}"
                                                IsVisible="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.CanShowClear}"
                                                IsEnabled="{Binding $parent[Window].((vm:PropertiesDialogViewModel)DataContext).Description.CanClear}"
                                                Padding="6,2" />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </cp:PropertiesList.ValueCellTemplate>
                </cp:PropertiesList>
            </TabItem>
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.Tags}}" IsVisible="{Binding HasTagsTab}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding TagAssignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagAssignmentViewModel">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned, Mode=TwoWay}" Margin="0,2,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.CustomProperties}}" IsVisible="{Binding HasCustomProperties}">
                <cp:PropertiesList x:Name="CustomPropertiesList"
                                   Rows="{Binding CustomProperties}"
                                   RowIsTabStop="False"
                                   EditValueInPlace="True"
                                   PropertyHeader="{i18n:Translate {x:Static i18n:UiKeys.Property}}"
                                   ValueHeader="{i18n:Translate {x:Static i18n:UiKeys.Value}}">
                    <!-- Tab navigation cannot reach unrealized rows. -->
                    <cp:PropertiesList.RowsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </cp:PropertiesList.RowsPanel>
                    <cp:PropertiesList.PropertyCellTemplate>
                        <DataTemplate x:DataType="vm:CustomPropertyItemViewModel">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </cp:PropertiesList.PropertyCellTemplate>
                    <cp:PropertiesList.ValueCellTemplate>
                        <DataTemplate x:DataType="vm:CustomPropertyItemViewModel">
                            <!-- The value text stays in the row; the editor only covers it while editing. -->
                            <Panel>
                                <TextBlock Text="{Binding DefaultValue}"
                                           IsVisible="{Binding !IsEditing}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding Name}" />
                                <TextBox Classes="property-value-editor"
                                         IsVisible="{Binding IsEditing}"
                                         Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{Binding Name}"
                                         KeyDown="OnCustomPropertyValueKeyDown" />
                            </Panel>
                        </DataTemplate>
                    </cp:PropertiesList.ValueCellTemplate>
                </cp:PropertiesList>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1"
              HorizontalAlignment="Right"
              Margin="0,10,12,10"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="{DynamicResource SkySpaceSm}">
            <Button Grid.Column="0"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                    MinWidth="74"
                    Padding="10,4"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
            <Button Grid.Column="1"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                    MinWidth="74"
                    Padding="10,4"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </Grid>
    </Grid>
</Window>