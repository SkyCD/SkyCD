<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        xmlns:cp="clr-namespace:SkyCD.UI.Controls.Properties;assembly=SkyCD.UI"
        xmlns:rt="clr-namespace:SkyCD.UI.Controls.RichText;assembly=SkyCD.UI"
        xmlns:converters="clr-namespace:SkyCD.App.Converters"
        x:Class="SkyCD.App.Views.PropertiesWindow"
        x:DataType="vm:PropertiesDialogViewModel"
        Width="411"
        Height="426"
        MinWidth="411"
        MinHeight="426"
        CanResize="True"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.Properties}}">

    <Window.Resources>
        <converters:IconGlyphConverter x:Key="IconConverter" />
    </Window.Resources>

    <Grid RowDefinitions="*,Auto" Margin="0">
        <TabControl Margin="8,8,8,0" SelectedIndex="0" TabStripPlacement="Top">
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.General}}">
                <Grid Margin="10,8,10,10" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,8,*">
                    <Border Grid.RowSpan="2"
                            Width="{Binding #NameFields.Bounds.Height}"
                            Height="{Binding #NameFields.Bounds.Height}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            CornerRadius="2">
                        <Image Width="24" Height="24"
                               Source="{Binding IconGlyph, Converter={StaticResource IconConverter}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel x:Name="NameFields"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Spacing="2">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NameLabel}}" VerticalAlignment="Top" />
                        <TextBox Text="{Binding Name}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,4" Text="{i18n:Translate {x:Static i18n:UiKeys.CommentsLabel}}"
                               VerticalAlignment="Top" />
                    <rt:RichTextEditor Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Margin="0,0,0,0"
                                       RtfText="{Binding Comments, Mode=TwoWay}" />
                </Grid>
            </TabItem>
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.Properties}}" IsVisible="{Binding HasInfoTab}">
                <cp:PropertiesList Margin="8,8,8,10"
                                   PropertiesData="{Binding InfoProperties}"
                                   PropertyHeader="{i18n:Translate {x:Static i18n:UiKeys.Property}}"
                                   ValueHeader="{i18n:Translate {x:Static i18n:UiKeys.Value}}" />
            </TabItem>
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.Tags}}" IsVisible="{Binding HasTagsTab}">
                <ScrollViewer Margin="8">
                    <ItemsControl ItemsSource="{Binding TagAssignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagAssignmentViewModel">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned, Mode=TwoWay}" Margin="0,2,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{i18n:Translate {x:Static i18n:UiKeys.CustomProperties}}" IsVisible="{Binding HasCustomProperties}">
                <ScrollViewer Margin="8">
                    <ItemsControl ItemsSource="{Binding CustomProperties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomPropertyItemViewModel">
                                <StackPanel Margin="0,0,0,8" Spacing="4">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBox Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1"
              HorizontalAlignment="Right"
              Margin="0,10,12,10"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="6">
            <Button Grid.Column="0"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.Ok}}"
                    MinWidth="74"
                    Padding="10,4"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
            <Button Grid.Column="1"
                    Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                    MinWidth="74"
                    Padding="10,4"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </Grid>
    </Grid>
</Window>