<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:vm="clr-namespace:SkyCD.Presentation.ViewModels;assembly=SkyCD.Presentation"
        x:Class="SkyCD.App.Views.MergeLocationsWindow"
        x:DataType="vm:MergeLocationsDialogViewModel"
        Width="430"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static i18n:UiKeys.MergeLocations}}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          Margin="16"
          RowSpacing="{DynamicResource SkySpaceSm}">
        <TextBlock Text="{Binding Summary}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Text="{i18n:Translate {x:Static i18n:UiKeys.MergeInto}}" />

        <ComboBox Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Destinations}"
                  SelectedItem="{Binding SelectedDestination, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocationItemViewModel">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource SkySpaceSm}"
                    Margin="0,14,0,0">
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.MergeLocations}}"
                    MinWidth="90"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Click="OnConfirmClicked" />
            <Button Content="{i18n:Translate {x:Static i18n:UiKeys.Cancel}}"
                    MinWidth="90"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
