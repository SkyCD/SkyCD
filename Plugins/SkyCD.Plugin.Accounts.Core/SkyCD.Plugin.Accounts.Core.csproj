<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommandDotNet" Version="8.1.1"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Accounts</AssemblyTitle>
        <Description>Contributes the list licenses and list subscriptions CLI commands shared by the account sync plugins.</Description>
    </PropertyGroup>
</Project>
