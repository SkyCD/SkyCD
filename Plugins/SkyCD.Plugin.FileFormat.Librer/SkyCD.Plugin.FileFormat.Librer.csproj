<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.12" />
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Librer Disk Database</AssemblyTitle>
        <Description>Read-only import of Librer disk database files.</Description>
    </PropertyGroup>
</Project>
