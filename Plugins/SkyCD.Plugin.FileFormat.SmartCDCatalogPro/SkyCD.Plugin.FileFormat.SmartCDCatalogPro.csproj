<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
        <PackageReference Include="JetDatabaseWriter" Version="2.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\Storage\TemporaryDatabase.cs" Link="Shared\Storage\TemporaryDatabase.cs"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Smart CD Catalog PRO</AssemblyTitle>
        <Description>Read-only import of Smart CD Catalog PRO (.scdc) catalogs.</Description>
    </PropertyGroup>
</Project>
