<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>GenDesc Templates</AssemblyTitle>
        <Description>Renders user-editable description templates over metadata supplied by the Wikipedia and video-database metadata source plugins.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SkyCD.SDK/SkyCD.SDK.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Shared fact bag and URL matching used by the plugin and the separate source plugins. -->
        <Compile Include="..\Shared\OnlineMetadata\Models\DescriptionFacts.cs" Link="Shared\OnlineMetadata\Models\DescriptionFacts.cs" />
        <Compile Include="..\Shared\OnlineMetadata\Sources\UrlHelpers.cs" Link="Shared\OnlineMetadata\Sources\UrlHelpers.cs" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Ai.GenDesc.Tests" />
    </ItemGroup>
</Project>
