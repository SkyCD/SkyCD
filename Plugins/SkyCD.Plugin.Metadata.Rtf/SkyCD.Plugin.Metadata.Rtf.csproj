<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Formatting\SkyCD.Formatting.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the other preview plugins: one page layout and one encode helper. -->
        <Compile Include="..\Shared\Preview\Export\PreviewArtifactEncoder.cs" Link="Shared\Preview\Export\PreviewArtifactEncoder.cs"/>
        <Compile Include="..\Shared\Preview\Export\SkiaPageRenderer.cs" Link="Shared\Preview\Export\SkiaPageRenderer.cs"/>
        <Compile Include="..\Shared\Preview\Export\SkiaPageText.cs" Link="Shared\Preview\Export\SkiaPageText.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: renders the parsed document to a bounded PNG thumbnail. -->
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Rich Text Format Document Metadata and Preview</AssemblyTitle>
        <Description>Reads the RTF information group, document statistics and a bounded text excerpt, and renders a bounded thumbnail of the document's leading text. The source is never modified and embedded references are never followed.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.Rtf.Tests"/>
    </ItemGroup>
</Project>
