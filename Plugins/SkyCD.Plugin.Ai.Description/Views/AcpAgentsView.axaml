<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
             xmlns:models="clr-namespace:SkyCD.Plugin.Ai.Description.Models"
             xmlns:views="clr-namespace:SkyCD.Plugin.Ai.Description.Views"
             xmlns:search="clr-namespace:SkyCD.UI.Controls.SearchTextBox;assembly=SkyCD.UI"
             x:Class="SkyCD.Plugin.Ai.Description.Views.AcpAgentsView"
             x:DataType="views:AcpAgentsPageViewModel">
    <UserControl.Styles>
        <Style Selector="Border.acpAgentCard">
            <Setter Property="BorderBrush" Value="{DynamicResource TabCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource SkyInsetMd}" />
        </Style>
        <Style Selector="Border.acpAgentCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SkyAcpAgentSelectedBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="{DynamicResource SkyInsetMd}" />
        </Style>
        <Style Selector="Button.acpUseAgent">
            <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.UseAcpAgent}}" />
        </Style>
        <Style Selector="Border.acpAgentCard.selected Button.acpUseAgent">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Theme">
                <ControlTheme TargetType="Button">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{DynamicResource SkyAcpAgentSelectedBackground}" BorderBrush="{DynamicResource SkyAcpAgentSelectedBorder}" BorderThickness="1" CornerRadius="{DynamicResource SkyCornerRadiusMedium}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  Padding="{DynamicResource SkyControlPadding}" HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" Foreground="{DynamicResource SkyAcpAgentSelectedForeground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </Setter>
            <Setter Property="Content" Value="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentSelected}}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <views:AcpAgentIconConverter x:Key="AcpAgentIconConverter" />
        <views:AcpAgentSelectionConverter x:Key="AcpAgentSelectionConverter" />
        <ItemsPanelTemplate x:Key="AcpAgentCardsPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="AcpAgentCardTemplate" x:DataType="models:AcpAgentChoice">
            <Border Classes="acpAgentCard" MinHeight="96" Margin="{DynamicResource SkyInsetXs}"
                    Background="{DynamicResource TabCardBackgroundBrush}"
                    CornerRadius="{DynamicResource SkyAcpAgentCardRadius}">
                <Classes.selected>
                    <MultiBinding Converter="{StaticResource AcpAgentSelectionConverter}">
                        <Binding />
                        <ReflectionBinding Path="DataContext.AcpCardAgent"
                                           RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                    </MultiBinding>
                </Classes.selected>
                <Grid ColumnSpacing="{DynamicResource SkySpaceSm}" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource SkySpaceSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource SkyAcpAgentIconColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="{DynamicResource SkyAcpAgentBadgeRadius}" Background="{DynamicResource SkyAcpAgentBadgeBackground}"
                            VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="{Binding IconLabel}" Foreground="White" FontWeight="SemiBold"
                                       IsVisible="{Binding !IconPaths.Count}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconPaths, Converter={StaticResource AcpAgentIconConverter}}"
                                   Width="20" Height="20" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource SkySpaceXs}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Description}" Opacity="0.78"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SkySpaceXs}">
                        <TextBlock Text="{Binding DisplayVersion}" Opacity="0.7"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXs}">
                            <Button Classes="acpUseAgent" IsVisible="{Binding IsInstalled}"
                                    Click="OnSelectAcpAgentClicked" />
                            <Button IsVisible="{Binding CanInstall}" Click="OnInstallAcpAgentClicked"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.InstallAcpAgent}}" />
                            <Button IsVisible="{Binding CanUpdate}" Click="OnInstallAcpAgentClicked"
                                    ToolTip.Tip="{Binding RegistryVersion}"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.UpdateAcpAgent}}" />
                            <Button IsVisible="{Binding IsManaged}" Click="OnUninstallAcpAgentClicked"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.UninstallAcpAgent}}" />
                            <Button IsVisible="{Binding CanLocateExecutable}" Click="OnBrowseAcpAgentClicked"
                                    ToolTip.Tip="{Binding ExpectedExecutable}"
                                    Content="{i18n:Translate {x:Static i18n:UiKeys.LocateAcpAgent}}" />
                            <TextBlock IsVisible="{Binding !HasAvailableAction}" Opacity="0.7"
                                       Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentUnavailable}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="{DynamicResource SkySpaceSm}">
        <search:SearchTextBox PlaceholderText="{i18n:Translate {x:Static i18n:UiKeys.SearchAcpAgents}}"
                              Text="{Binding AcpSearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding !IsAcpLoading}" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource TabCardBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource SkyAcpAgentCardRadius}">
            <Grid>
                <ScrollViewer IsVisible="{Binding !IsAcpLoading}"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{DynamicResource SkyInsetMd}" Spacing="{DynamicResource SkySpaceSm}">
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentInstalled}}" IsVisible="{Binding HasInstalledAcpAgents}"
                                   FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding InstalledAcpAgents}" IsVisible="{Binding HasInstalledAcpAgents}"
                                      ItemTemplate="{StaticResource AcpAgentCardTemplate}"
                                      ItemsPanel="{StaticResource AcpAgentCardsPanel}" />
                        <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.AcpAgentsAvailable}}" IsVisible="{Binding HasAvailableAcpAgents}"
                                   FontWeight="SemiBold" Margin="{DynamicResource SkyGapTopSm}" />
                        <ItemsControl ItemsSource="{Binding AvailableAcpAgents}" IsVisible="{Binding HasAvailableAcpAgents}"
                                      ItemTemplate="{StaticResource AcpAgentCardTemplate}"
                                      ItemsPanel="{StaticResource AcpAgentCardsPanel}" />
                    </StackPanel>
                </ScrollViewer>
                <Grid IsVisible="{Binding !IsAcpLoading}">
                    <TextBlock IsVisible="{Binding HasNoMatchingAcpAgents}"
                               Text="{i18n:Translate {x:Static i18n:UiKeys.NoMatchingAcpAgents}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                </Grid>
                <StackPanel IsVisible="{Binding IsAcpLoading}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="{DynamicResource SkySpaceSm}">
                    <ProgressBar Width="124" Height="5" IsIndeterminate="{Binding IsAcpLoading}" />
                    <TextBlock Text="{Binding AcpLoadingLabel}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="{DynamicResource SkySpaceSm}">
            <TextBlock IsVisible="{Binding HasAcpRegistryStatus}" Text="{Binding AcpRegistryStatus}"
                       Margin="{DynamicResource SkyGapTopSm}" TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding HasAcpAlert}" Text="{Binding AcpAlertMessage}"
                       Margin="{DynamicResource SkyGapTopSm}" TextWrapping="Wrap" Foreground="{DynamicResource SkyErrorForeground}" />
        </StackPanel>
    </Grid>
</UserControl>
