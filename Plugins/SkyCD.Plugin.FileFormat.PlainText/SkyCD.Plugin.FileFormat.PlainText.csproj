<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <Compile Include="..\Shared\EncodingProfiles\LegacyEncoding.cs" Link="Shared\EncodingProfiles\LegacyEncoding.cs" />
        <!-- Shared with the CSV and XML exporters: one copy of size, timestamp and text formatting. -->
        <Compile Include="..\Shared\ExportFormatting\ExportValueFormatting.cs" Link="Shared\ExportFormatting\ExportValueFormatting.cs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.SDK\SkyCD.SDK.csproj"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Plain Text List Export</AssemblyTitle>
        <Description>Exports the current list or result set as aligned fixed-width or tab-delimited text.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
</Project>
