<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>MyCatalogue</AssemblyTitle>
        <Description>Read-only import of MyCatalogue (*.mdb) catalogs.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]" />
        <PackageReference Include="JustyBase.UCanAccess.File" Version="1.1.0" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\Storage\TemporaryDatabase.cs" Link="Shared\Storage\TemporaryDatabase.cs" />
    </ItemGroup>
</Project>
