<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the other preview plugins: one bounded cover pipeline and one encode helper. -->
        <Compile Include="..\Shared\Preview\Export\PreviewArtifactEncoder.cs" Link="Shared\Preview\Export\PreviewArtifactEncoder.cs"/>
        <Compile Include="..\Shared\Preview\Export\CoverImageRenderer.cs" Link="Shared\Preview\Export\CoverImageRenderer.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: reads ComicInfo.xml and the first page from cbz/cbr/cb7 containers. SharpCompress is already
             used by SkyCD.Plugin.Metadata.Archives, so the license evaluation is shared (see docs/plugins/ecomic.md). -->
        <PackageReference Include="SharpCompress" Version="0.50.8"/>
        <!-- MIT: decodes the extracted page and encodes the bounded cover thumbnail. -->
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
        <!-- Configuration surface only; the extraction capabilities never touch UI types. -->
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>eComic Metadata and Covers</AssemblyTitle>
        <Description>Reads ComicInfo.xml from cbz, cbr and cb7 comic archives, publishes series and title metadata with optional preferred names and writer tags, and extracts a bounded cover image during indexing.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.EComic.Tests"/>
    </ItemGroup>
</Project>
