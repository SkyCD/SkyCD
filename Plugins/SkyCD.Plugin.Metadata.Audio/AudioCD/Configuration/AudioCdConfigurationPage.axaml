<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SkyCD.Plugin.Metadata.Audio.AudioCD.Configuration.AudioCdConfigurationPage">
    <Grid Margin="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource SkySpaceSm}">
        <TextBlock Text="Online sources" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Spacing="{DynamicResource SkySpaceXs}">
            <CheckBox x:Name="MusicBrainzCheckBox" Content="MusicBrainz" />
            <CheckBox x:Name="GnudbCheckBox" Content="GnuDb" />
            <CheckBox x:Name="OfflineCheckBox" Content="Work offline (never contact the sources)" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Disc record" FontWeight="SemiBold" Margin="{DynamicResource SkyGapTopSm}" />
        <StackPanel Grid.Row="3" Spacing="{DynamicResource SkySpaceXs}">
            <CheckBox x:Name="DiscArtistTagsCheckBox" Content="Write the artist name as a tag" />
            <CheckBox x:Name="DiscCoversCheckBox" Content="Download the cover image" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                <TextBlock Text="Cover size (px):" VerticalAlignment="Center" />
                <NumericUpDown x:Name="DiscCoverSizeInput" Minimum="32" Maximum="2048" Increment="1" Width="140" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Track records" FontWeight="SemiBold" Margin="{DynamicResource SkyGapTopSm}" />
        <StackPanel Grid.Row="5" Spacing="{DynamicResource SkySpaceXs}">
            <CheckBox x:Name="TrackArtistTagsCheckBox" Content="Write the artist name as a tag" />
            <CheckBox x:Name="TrackCoversCheckBox" Content="Download the cover image" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
                <TextBlock Text="Cover size (px):" VerticalAlignment="Center" />
                <NumericUpDown x:Name="TrackCoverSizeInput" Minimum="32" Maximum="2048" Increment="1" Width="140" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="Network" FontWeight="SemiBold" Margin="{DynamicResource SkyGapTopSm}" />
        <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="{DynamicResource SkySpaceSm}">
            <TextBlock Text="Request timeout (seconds):" VerticalAlignment="Center" />
            <NumericUpDown x:Name="RequestTimeoutInput" Minimum="1" Maximum="30" Increment="1" Width="140" />
        </StackPanel>

        <TextBlock Grid.Row="8"
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   Text="MusicBrainz allows one request per second; GnuDb is a free community database. Missing artwork and unmatched discs are skipped." />

    </Grid>
</UserControl>
