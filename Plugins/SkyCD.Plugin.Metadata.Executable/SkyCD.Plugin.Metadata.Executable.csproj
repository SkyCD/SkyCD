<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the other preview plugins: one PNG/JPEG encode helper. -->
        <Compile Include="..\Shared\Preview\Export\PreviewArtifactEncoder.cs" Link="Shared\Preview\Export\PreviewArtifactEncoder.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: reads the ISO 9660 volume a type 1 AppImage appends to its runtime. -->
        <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13"/>
        <!-- Apache-2.0: icon directory parsing for the executable facts (issue #1221). Pixel decoding stays SkiaSharp. -->
        <PackageReference Include="MetadataExtractor" Version="2.9.3" />
        <!-- MIT: decoding embedded PNG icons and encoding the bounded preview. -->
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Executable File Facts and Icons</AssemblyTitle>
        <Description>Reads PE version information and technical facts from executable files with the in-box PE reader, and extracts the program's own icon as a bounded, index-time PNG preview so the catalog can show it offline. PNG icons are decoded with SkiaSharp; no Windows-only API is used.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.Executable.Tests"/>
    </ItemGroup>
</Project>
