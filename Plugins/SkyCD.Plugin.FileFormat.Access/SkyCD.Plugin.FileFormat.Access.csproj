<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Microsoft Access List Export</AssemblyTitle>
        <Description>Exports the current list or result set to a Microsoft Access database (*.mdb).</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SkyCD.SDK/SkyCD.SDK.csproj" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="JustyBase.UCanAccess.File" Version="1.1.0" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\Storage\TemporaryDatabase.cs" Link="Shared\Storage\TemporaryDatabase.cs" />
    </ItemGroup>
</Project>
