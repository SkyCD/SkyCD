<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Configuration surface only; extraction never touches UI types. No general metadata library is -->
        <!-- referenced: the obvious candidate drags in an XMP toolkit whose NuGet license the policy gate -->
        <!-- reports as unknown, so the handful of portable tags read here are parsed directly. -->
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>File Metadata</AssemblyTitle>
        <Description>Reads portable keywords, hierarchical tags, comments and ratings from XMP, IPTC, PNG text chunks and TIFF tags, so metadata written by Windows, Lightroom, digiKam and similar tools travels with the file.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.FileMetadata.Tests"/>
    </ItemGroup>
</Project>
