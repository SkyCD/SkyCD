<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the image plugin: one copy of the XMP/IPTC/TIFF parsing, compiled into each. -->
        <Compile Include="..\Shared\MediaMetadata\*.cs" Link="Shared\MediaMetadata\%(Filename)%(Extension)"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>File Metadata</AssemblyTitle>
        <Description>Reads the tags, comment and rating a user assigned through Windows, Linux or macOS file properties, and the portable tags stored inside TIFF containers, TIFF-based RAW files and XMP sidecars.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.FileMetadata.Tests"/>
    </ItemGroup>
</Project>
