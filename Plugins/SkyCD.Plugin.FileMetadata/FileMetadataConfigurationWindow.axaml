<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SkyCD.Plugin.FileMetadata.FileMetadataConfigurationWindow"
        Width="480"
        Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
        <CheckBox x:Name="CollectionEnabledCheckBox"
                  Content="Collect file metadata while indexing" />
        <CheckBox Grid.Row="1"
                  x:Name="KeywordsEnabledCheckBox"
                  Content="Read keywords and tags" />
        <CheckBox Grid.Row="2"
                  x:Name="SplitHierarchicalCheckBox"
                  Content="Split hierarchical tags into separate levels" />
        <CheckBox Grid.Row="3"
                  x:Name="CommentsEnabledCheckBox"
                  Content="Read comments and captions" />
        <CheckBox Grid.Row="4"
                  x:Name="RatingsEnabledCheckBox"
                  Content="Read star ratings" />
        <TextBlock Grid.Row="5"
                   Text="Supported extensions (semicolon separated)"
                   FontWeight="SemiBold" />
        <TextBox Grid.Row="6" x:Name="ExtensionsTextBox" />
        <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Content="_OK"
                    MinWidth="75"
                    IsDefault="True"
                    Click="OnOkClicked" />
            <Button Content="_Cancel"
                    MinWidth="75"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
