<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>JetBrains Accounts</AssemblyTitle>
        <Description>Connects to a JetBrains Account to sync license records into the accounts catalog.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommandDotNet" Version="8.1.1"/>
    </ItemGroup>
</Project>
