<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the other preview plugins: one PNG/JPEG encode helper. -->
        <Compile Include="..\Shared\Preview\Export\PreviewArtifactEncoder.cs" Link="Shared\Preview\Export\PreviewArtifactEncoder.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: decodes the configured preview text with the font's own glyphs and encodes a bounded PNG.
             SkiaSharp is already used by SkyCD.Plugin.Metadata.Image, SkyCD.Plugin.Metadata.Rtf and SkyCD.Plugin.Metadata.EComic. -->
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
        <!-- Configuration surface only; extraction never touches UI types. -->
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Font Metadata and Previews</AssemblyTitle>
        <Description>Reads font name, version and copyright from ttf, ttc, otf and otc files and renders a bounded preview image with the font's own glyphs.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.Fonts.Tests"/>
    </ItemGroup>
</Project>
