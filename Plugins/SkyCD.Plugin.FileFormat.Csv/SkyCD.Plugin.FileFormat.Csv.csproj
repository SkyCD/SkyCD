<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <Compile Include="..\Shared\EncodingProfiles\LegacyEncoding.cs" Link="Shared\EncodingProfiles\LegacyEncoding.cs" />
        <!-- Shared with the plain-text and XML exporters: one copy of size, timestamp and text formatting. -->
        <Compile Include="..\Shared\ExportFormatting\ExportValueFormatting.cs" Link="Shared\ExportFormatting\ExportValueFormatting.cs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.SDK\SkyCD.SDK.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Apache-2.0: compliant per dependency-license-policy.json -->
        <PackageReference Include="CsvHelper" Version="34.0.0" />
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>SkyCD CSV</AssemblyTitle>
        <Description>Reads and writes SkyCD CSV catalogs and exports the current list as CSV.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
</Project>