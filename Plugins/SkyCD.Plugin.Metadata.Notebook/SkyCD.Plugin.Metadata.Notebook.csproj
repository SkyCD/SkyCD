<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: bounded Jupyter Notebook reader. Same version as every other OfficeIMO package. -->
        <PackageReference Include="OfficeIMO.Reader.Notebook" Version="3.6.2"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Jupyter Notebook Metadata</AssemblyTitle>
        <Description>Reads notebook format version, kernel language, cell counts and leading cell titles from Jupyter notebooks through the bounded OfficeIMO reader. The source is never executed, stored output payloads are never decoded, and no kernel, widget or remote resource is contacted.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.Notebook.Tests"/>
    </ItemGroup>
</Project>
