<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- BSD-2-Clause: parses CommonMark/GFM structure for headings, links, code and plain text. -->
        <PackageReference Include="Markdig" Version="1.6.0"/>
        <!-- MIT: reads the YAML front matter block that Markdown documents commonly use. -->
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the other preview plugins: one page layout and one encode helper. -->
        <Compile Include="..\Shared\Preview\Export\PreviewArtifactEncoder.cs" Link="Shared\Preview\Export\PreviewArtifactEncoder.cs"/>
        <Compile Include="..\Shared\Preview\Export\SkiaPageRenderer.cs" Link="Shared\Preview\Export\SkiaPageRenderer.cs"/>
        <Compile Include="..\Shared\Preview\Export\SkiaPageText.cs" Link="Shared\Preview\Export\SkiaPageText.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: renders the leading document content to a page thumbnail. -->
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Markdown Document Metadata</AssemblyTitle>
        <Description>Reads YAML front matter and the document structure of Markdown files, publishes a bounded plain-text excerpt, and renders the leading content as a page thumbnail. The source is never modified, markup is never interpreted as code, and external references are never followed.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.Markdown.Tests"/>
    </ItemGroup>
</Project>
