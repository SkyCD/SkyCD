<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:loans="clr-namespace:SkyCD.Plugin.Feature.Loans.Models"
        xmlns:local="clr-namespace:SkyCD.Plugin.Feature.Loans.Views"
        x:Class="SkyCD.Plugin.Feature.Loans.Views.LoansWindow"
        Width="411" Height="460"
        CanResize="False" CanMinimize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/skycd.ico"
        Title="{i18n:Translate {x:Static loans:LoansKeys.Loans}}">
    <DockPanel>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="8"
                Content="{i18n:Translate {x:Static i18n:UiKeys.Close}}" IsCancel="True" Click="CloseClicked" />
        <local:LoanEditor />
    </DockPanel>
</Window>
