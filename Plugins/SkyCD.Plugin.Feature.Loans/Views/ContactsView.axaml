<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:loans="clr-namespace:SkyCD.Plugin.Feature.Loans.Models"
        xmlns:vm="clr-namespace:SkyCD.Plugin.Feature.Loans.Views"
        x:Class="SkyCD.Plugin.Feature.Loans.Views.ContactsView"
        x:DataType="vm:ContactsDialogViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="{DynamicResource SkySpaceSm}" Margin="{DynamicResource SkyGapTopMd}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SkyErrorForeground}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="{DynamicResource SkySpaceSm}" LineSpacing="{DynamicResource SkySpaceSm}">
                <Button Content="{i18n:Translate {x:Static loans:LoansKeys.NewContact}}"
                        Command="{Binding AddContactCommand}" />
                <Button Content="{i18n:Translate {x:Static loans:LoansKeys.DeleteContact}}"
                        Command="{Binding DeleteContactCommand}" />
                <Button Content="{i18n:Translate {x:Static loans:LoansKeys.SaveContact}}"
                        Command="{Binding SaveContactCommand}" />
                <Button Content="{i18n:Translate {x:Static loans:LoansKeys.ImportContacts}}"
                        Click="ImportClicked" />
                <Button Content="{i18n:Translate {x:Static loans:LoansKeys.ExportContacts}}"
                        Click="ExportClicked" />
            </WrapPanel>
        </StackPanel>

        <Grid ColumnSpacing="{DynamicResource SkySpaceSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SkyContactsLabelWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PART_ContactList"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                     AutomationProperties.Name="{i18n:Translate {x:Static loans:LoansKeys.Contacts}}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="loans:ContactListItem">
                        <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding DisplayLabel}" FontSize="{DynamicResource SkyFontCaption}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TabControl Grid.Column="1">
                <TabItem Header="{i18n:Translate {x:Static loans:LoansKeys.ContactDetails}}">
                    <ScrollViewer Margin="{DynamicResource SkyInsetSm}">
                        <StackPanel Spacing="{DynamicResource SkySpaceSm}">
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.NameLabel}}" />
                                <TextBox Text="{Binding ContactName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactDisplayName}}" />
                                <TextBox Text="{Binding ContactDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                    <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactPhone}}" />
                                    <TextBox Text="{Binding ContactPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="{DynamicResource SkySpaceXxs}">
                                    <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactFax}}" />
                                    <TextBox Text="{Binding ContactFax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactEmail}}" />
                                <TextBox Text="{Binding ContactEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactWebPage}}" />
                                <TextBox Text="{Binding ContactWebPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactMessenger}}" />
                                <TextBox Text="{Binding ContactMessenger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactAddress}}" />
                                <TextBox Text="{Binding ContactAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                                <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                    <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactCompany}}" />
                                    <TextBox Text="{Binding ContactCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="{DynamicResource SkySpaceXxs}">
                                    <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.ContactPosition}}" />
                                    <TextBox Text="{Binding ContactPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                                <TextBlock Text="{i18n:Translate {x:Static i18n:UiKeys.CommentsLabel}}" />
                                <TextBox Text="{Binding ContactComments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{i18n:Translate {x:Static loans:LoansKeys.ContactLentItems}}">
                    <Grid Margin="{DynamicResource SkyInsetSm}" RowDefinitions="Auto,*">
                        <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.NoLentItems}}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasLentItems}" />
                        <ListBox Grid.Row="1" Margin="{DynamicResource SkyGapTopSm}"
                                 ItemsSource="{Binding LentItems}"
                                 IsVisible="{Binding HasLentItems}"
                                 AutomationProperties.Name="{i18n:Translate {x:Static loans:LoansKeys.ContactLentItems}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="loans:ContactLentItem">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
