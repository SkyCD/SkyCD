<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
             xmlns:loans="clr-namespace:SkyCD.Plugin.Feature.Loans.Models"
             xmlns:vm="clr-namespace:SkyCD.Plugin.Feature.Loans.Views"
             x:Class="SkyCD.Plugin.Feature.Loans.Views.LoanEditor"
             x:DataType="vm:LoanDialogViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource SkySpaceXs}" Margin="{DynamicResource SkyInsetSm}">
        <StackPanel Spacing="{DynamicResource SkySpaceXs}">
            <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.Borrower}}" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Borrowers}" SelectedItem="{Binding SelectedBorrower}"
                      AutomationProperties.Name="{i18n:Translate {x:Static loans:LoansKeys.Borrower}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{ReflectionBinding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{i18n:Translate {x:Static loans:LoansKeys.ManageBorrowers}}"
                    Command="{Binding ManageBorrowersCommand}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SkySpaceSm}">
                <StackPanel Spacing="{DynamicResource SkySpaceXxs}">
                    <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.LoanDateLabel}}" />
                    <TextBox Text="{Binding LoanDate}" PlaceholderText="YYYY-MM-DD"
                             AutomationProperties.Name="{i18n:Translate {x:Static loans:LoansKeys.LoanDateLabel}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource SkySpaceXxs}">
                    <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.LoanDueLabel}}" />
                    <TextBox Text="{Binding DueDate}" PlaceholderText="YYYY-MM-DD"
                             AutomationProperties.Name="{i18n:Translate {x:Static loans:LoansKeys.LoanDueLabel}}" />
                </StackPanel>
            </Grid>
            <TextBox Text="{Binding Note}" PlaceholderText="{i18n:Translate {x:Static loans:LoansKeys.LoanNote}}" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SkySpaceXs}">
                <Button Content="{Binding SaveLabel}" Command="{Binding MarkLentCommand}" />
                <Button Content="{i18n:Translate {x:Static loans:LoansKeys.MarkReturned}}" Command="{Binding MarkReturnedCommand}" IsVisible="{Binding !IsPopup}" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SkyErrorForeground}" TextWrapping="Wrap" />
            <TextBlock Text="{i18n:Translate {x:Static loans:LoansKeys.LoanHistory}}" IsVisible="{Binding !IsPopup}" />
        </StackPanel>
        <ListBox Grid.Row="1" IsVisible="{Binding !IsPopup}" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedLoan}" MinHeight="160"
                 AutomationProperties.Name="{i18n:Translate {x:Static loans:LoansKeys.LoanHistory}}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="loans:LoanHistoryRow">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" IsVisible="{Binding !IsPopup}" Text="{i18n:Translate {x:Static loans:LoansKeys.LoanChangesSave}}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
