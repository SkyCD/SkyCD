<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Loans</AssemblyTitle>
        <Description>Tracks item loans and borrowers and contributes loan badges, columns, search fields and dialog windows to the catalog.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Documents\SkyCD.Documents.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Couchbase\SkyCD.Couchbase.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.UI\SkyCD.UI.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Presentation\SkyCD.Presentation.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Couchbase.Lite" Version="4.1.3"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared application icon so the dialog windows resolve /Assets/skycd.ico in this assembly. -->
        <AvaloniaResource Include="..\..\src\SkyCD.App\Assets\skycd.ico" Link="Assets\skycd.ico"/>
    </ItemGroup>
    <ItemGroup>
        <!-- The first-party host consumes the service and view models directly (coupling choice for issue #857). -->
        <InternalsVisibleTo Include="SkyCD.Presentation"/>
        <InternalsVisibleTo Include="SkyCD.App"/>
        <InternalsVisibleTo Include="SkyCD.Plugin.Feature.Loans.Tests"/>
    </ItemGroup>
</Project>
