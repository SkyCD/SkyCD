<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SkyCD.Plugin.EComic.EComicConfigurationWindow"
        Width="460"
        Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
        <CheckBox x:Name="CollectionEnabledCheckBox"
                  Content="Collect eComic metadata while indexing" />
        <TextBlock Grid.Row="1" Text="Use in place of the file name" FontWeight="SemiBold" />
        <ComboBox Grid.Row="2" x:Name="NameSourceComboBox" HorizontalAlignment="Stretch" />
        <CheckBox Grid.Row="3"
                  x:Name="TagWritersCheckBox"
                  Content="Create tags for writers" />
        <CheckBox Grid.Row="4"
                  x:Name="ExtractCoversCheckBox"
                  Content="Extract the cover image while indexing" />
        <TextBlock Grid.Row="5" Text="Cover size (longest edge, pixels)" FontWeight="SemiBold" />
        <NumericUpDown Grid.Row="6"
                       x:Name="CoverSizeBox"
                       Minimum="64"
                       Maximum="2048"
                       Increment="16"
                       FormatString="0" />
        <TextBlock Grid.Row="7"
                   Text="Supported extensions (semicolon separated)"
                   FontWeight="SemiBold" />
        <TextBox Grid.Row="8" x:Name="ExtensionsTextBox" />
        <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Content="_OK"
                    MinWidth="75"
                    IsDefault="True"
                    Click="OnOkClicked" />
            <Button Content="_Cancel"
                    MinWidth="75"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
