<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyTitle>Video Project Metadata</AssemblyTitle>
        <Description>Reads project metadata from Adobe Premiere Pro, After Effects, DaVinci Resolve and VEGAS Pro.</Description>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SkyCD.SDK/SkyCD.SDK.csproj"/>
        <PackageReference Include="SharpZipLib" Version="1.4.2"/>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
</Project>
