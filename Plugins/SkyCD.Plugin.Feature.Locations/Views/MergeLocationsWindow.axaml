<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SkyCD.UI.Localization;assembly=SkyCD.UI"
        xmlns:models="clr-namespace:SkyCD.Plugin.Feature.Locations.Models"
        xmlns:vm="clr-namespace:SkyCD.Plugin.Feature.Locations.Views"
        x:Class="SkyCD.Plugin.Feature.Locations.Views.MergeLocationsWindow"
        x:DataType="vm:MergeLocationsDialogViewModel"
        Width="430"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{i18n:Translate {x:Static models:LocationsKeys.MergeLocations}}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          Margin="{DynamicResource SkyInsetLg}"
          RowSpacing="{DynamicResource SkySpaceSm}">
        <TextBlock Text="{Binding Summary}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Text="{i18n:Translate {x:Static models:LocationsKeys.MergeInto}}" />

        <ComboBox Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Destinations}"
                  SelectedItem="{Binding SelectedDestination, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:LocationRow">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource SkySpaceSm}">
            <Button Content="{i18n:Translate {x:Static models:LocationsKeys.Merge}}"
                    MinWidth="90"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Click="OnConfirmClicked" />
            <Button Content="{i18n:Translate {x:Static models:LocationsKeys.Cancel}}"
                    MinWidth="90"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
