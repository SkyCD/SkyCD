<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Split</AssemblyTitle>
        <Description>Splits a legacy SkyCD text (.scd) catalog into numbered part catalogs at entry boundaries.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.SDK\SkyCD.SDK.csproj"/>
        <ProjectReference Include="..\SkyCD.Plugin.FileFormat.LegacySkyCD\SkyCD.Plugin.FileFormat.LegacySkyCD.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    </ItemGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Feature.Split.Tests"/>
    </ItemGroup>
</Project>
