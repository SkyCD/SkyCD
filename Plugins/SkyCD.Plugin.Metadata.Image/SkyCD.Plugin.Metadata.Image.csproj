<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the other preview plugins: one bounded cover pipeline and one encode helper. -->
        <Compile Include="..\Shared\Preview\Export\PreviewArtifactEncoder.cs" Link="Shared\Preview\Export\PreviewArtifactEncoder.cs"/>
        <Compile Include="..\Shared\Preview\Export\CoverImageRenderer.cs" Link="Shared\Preview\Export\CoverImageRenderer.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared with the XMP sidecar plugin: one copy of the scan, text and XMP property mapping. -->
        <Compile Include="..\Shared\MediaMetadata\Parsing\MetadataScan.cs" Link="Shared\MediaMetadata\MetadataScan.cs"/>
        <Compile Include="..\Shared\MediaMetadata\Parsing\MetadataText.cs" Link="Shared\MediaMetadata\MetadataText.cs"/>
        <Compile Include="..\Shared\MediaMetadata\Parsing\XmpMetadataReader.cs" Link="Shared\MediaMetadata\XmpMetadataReader.cs"/>
        <Compile Include="..\Shared\MediaMetadata\Models\MetadataValues.cs" Link="Shared\MediaMetadata\MetadataValues.cs"/>
        <Compile Include="..\Shared\MediaMetadata\Models\SourcePrefix.cs" Link="Shared\MediaMetadata\SourcePrefix.cs"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Apache-2.0: EXIF, IPTC, XMP, PNG and WebP metadata directories. -->
        <PackageReference Include="MetadataExtractor" Version="2.9.3"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: decoding, orientation-aware scaling and thumbnail encoding. -->
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.1" GeneratePathProperty="true"/>
        <PackageReference Include="Svg.Skia" Version="[4.9.1]"/>
        <PackageReference Include="PdfPig" Version="0.1.16"/>
        <PackageReference Include="Docnet.Core" Version="2.6.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="$(PkgMagick_NET-Q8-AnyCPU)/Notice.txt" Link="Magick.NET-NOTICE.txt"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Condition="Exists('$(PkgMagick_NET-Q8-AnyCPU)/Notice.txt')"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Image Preview and Metadata</AssemblyTitle>
        <Description>Extracts image and work-file metadata and renders bounded previews for raster, RAW, vector and paint document formats.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Metadata.Image.Tests"/>
    </ItemGroup>
</Project>
