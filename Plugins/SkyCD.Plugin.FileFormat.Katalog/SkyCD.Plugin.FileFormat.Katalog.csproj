<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\Storage\TemporaryDatabase.cs" Link="Shared\Storage\TemporaryDatabase.cs"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Katalog Collections</AssemblyTitle>
        <Description>Read-only import of Katalog Memory-mode CSV/IDX folders and File-mode SQLite collections.</Description>
    </PropertyGroup>
</Project>
