<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- MIT: MD4 (eD2k) and Tiger (THEX tree) digests. No transitive dependencies. -->
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>P2P File Hashes</AssemblyTitle>
        <Description>Streams any file once to compute interoperable eD2k and Tiger Tree Hash identifiers plus a conventional SHA-256 digest.</Description>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SkyCD.Plugin.Hash.Tests"/>
    </ItemGroup>
</Project>
