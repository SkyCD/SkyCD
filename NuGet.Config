<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="skycd" value="https://nuget.pkg.github.com/SkyCD/index.json" />
    <add key="sample-config" value="https://skycd.github.io/SkyCD.Plugin.Sample.Config/index.json" />
    <add key="sample-menu" value="https://skycd.github.io/SkyCD.Plugin.Sample.Menu/index.json" />
    <add key="sample-modal" value="https://skycd.github.io/SkyCD.Plugin.Sample.Modal/index.json" />
    <add key="webbrowser" value="https://skycd.github.io/SkyCD.Plugin.Feature.WebBrowser/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="skycd">
      <package pattern="SkyCD.SDK" />
      <package pattern="SkyCD.Testing" />
      <package pattern="SkyCD.Plugin.FileFormat.CDCat" />
      <package pattern="SkyCD.Plugin.FileFormat.CDPlayer" />
      <package pattern="SkyCD.Plugin.FileFormat.Tar" />
      <package pattern="SkyCD.Plugin.Metadata.Archives" />
      <package pattern="SkyCD.Plugin.Metadata.DiskImages" />
      <package pattern="SkyCD.Plugin.Metadata.FileMetadata" />
      <package pattern="SkyCD.Plugin.Metadata.Fonts" />
      <package pattern="SkyCD.Plugin.Metadata.Hash" />
      <package pattern="SkyCD.Plugin.Metadata.Image" />
      <package pattern="SkyCD.Plugin.Metadata.Audio" />
      <package pattern="SkyCD.Plugin.Metadata.EBook" />
      <package pattern="SkyCD.Plugin.Metadata.EComic" />
      <package pattern="SkyCD.Plugin.Metadata.Email" />
      <package pattern="SkyCD.Plugin.Metadata.Notebook" />
      <package pattern="SkyCD.Plugin.Metadata.Video" />
      <package pattern="SkyCD.Plugin.Metadata.VideoProjects" />
      <package pattern="SkyCD.Plugin.Metadata.Xmp" />
      <package pattern="SkyCD.Plugin.FileFormat.AbeMeda" />
      <package pattern="SkyCD.Plugin.FileFormat.Basenji" />
      <package pattern="SkyCD.Plugin.FileFormat.BrokenX" />
      <package pattern="SkyCD.Plugin.FileFormat.Cathy" />
      <package pattern="SkyCD.Plugin.FileFormat.CDCatalogExpert" />
      <package pattern="SkyCD.Plugin.FileFormat.CDCollect" />
      <package pattern="SkyCD.Plugin.FileFormat.DiskBase" />
      <package pattern="SkyCD.Plugin.FileFormat.DiskCatalogMaker" />
      <package pattern="SkyCD.Plugin.FileFormat.DiskExplorer" />
      <package pattern="SkyCD.Plugin.FileFormat.EasyDiskCatalog" />
      <package pattern="SkyCD.Plugin.FileFormat.GCstar" />
      <package pattern="SkyCD.Plugin.FileFormat.Katalog" />
      <package pattern="SkyCD.Plugin.FileFormat.Librer" />
      <package pattern="SkyCD.Plugin.FileFormat.MyCatalogue" />
      <package pattern="SkyCD.Plugin.FileFormat.SmartCDCatalogPro" />
      <package pattern="SkyCD.Plugin.FileFormat.Tellico" />
      <package pattern="SkyCD.Plugin.FileFormat.Vvv" />
      <package pattern="SkyCD.Plugin.FileFormat.WhereIsIt" />
      <package pattern="SkyCD.Plugin.FileFormat.WinCatalog" />
      <package pattern="SkyCD.Native.Sqlite2" />
      <package pattern="SkyCD.Resource.Icons.LlmBackends" />
    </packageSource>
    <packageSource key="sample-config">
      <package pattern="SkyCD.Plugin.Sample.Config" />
    </packageSource>
    <packageSource key="sample-menu">
      <package pattern="SkyCD.Plugin.Sample.Menu" />
    </packageSource>
    <packageSource key="sample-modal">
      <package pattern="SkyCD.Plugin.Sample.Modal" />
    </packageSource>
    <packageSource key="webbrowser">
      <package pattern="SkyCD.Plugin.Feature.WebBrowser" />
    </packageSource>
  </packageSourceMapping>
</configuration>
