root = true

[*]
charset = utf-8
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent:suggestion
csharp_style_var_elsewhere:suggestion
csharp_prefer_braces = when_multiline:silent
csharp_style_pattern_matching_over_is_with_cast_check:suggestion
csharp_style_pattern_matching_over_as_with_null_check:suggestion
csharp_style_expression_bodied_methods_when_multiline:silent
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

[*.{json,yml,yaml,xml,axaml,props,targets,config}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,py}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
