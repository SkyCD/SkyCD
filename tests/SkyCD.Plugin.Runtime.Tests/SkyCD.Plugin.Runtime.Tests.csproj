<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>
    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.Core\SkyCD.Core.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Runtime\SkyCD.Plugin.Runtime.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Abstractions\SkyCD.Plugin.Abstractions.csproj"/>
        <ProjectReference Include="..\SkyCD.TestSupport\SkyCD.TestSupport.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="SkyCD.Plugin.Abstractions.Lifecycle.PluginIdAttribute">
            <_Parameter1>tests.runtime.assembly-plugin</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="SkyCD.Plugin.Abstractions.Lifecycle.MinHostVersionAttribute">
            <_Parameter1>3.0.0</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="SkyCD.Plugin.Abstractions.Lifecycle.MaxHostVersionAttribute">
            <_Parameter1>3.0.0</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <!-- Slice plugin assemblies packaged by staged-install fixtures and copied next to the tests. -->
        <Compile Remove="Slice/**/*.cs"/>
        <None Include="Slice/**/*.cs"/>
        <ProjectReference Include="Slice/SkyCD.Plugin.SlipSlice.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="Slice/Foreign/SkyCD.Plugin.ForeignSlice.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>
    <!-- Copy after the referenced slice projects are built; a plain None copy can run first on a clean tree. -->
    <Target Name="CopySliceAssemblies" AfterTargets="Build">
        <Copy SourceFiles="$(MSBuildThisFileDirectory)Slice/bin/$(Configuration)/net10.0/SkyCD.Plugin.SlipSlice.dll"
              DestinationFiles="$(OutDir)Slice.dll"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(MSBuildThisFileDirectory)Slice/Foreign/bin/$(Configuration)/net10.0/SkyCD.Plugin.ForeignSlice.dll"
              DestinationFiles="$(OutDir)ForeignSlice.dll"
              SkipUnchangedFiles="true"/>
    </Target>
</Project>
