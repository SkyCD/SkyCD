<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.6"/>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <!-- Avalonia.Headless.XUnit 12.1.4 requires the xUnit 3.2.2 extensibility API. -->
        <PackageReference Include="xunit.v3" Version="[3.2.2]"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>
    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SkyCD.App\SkyCD.App.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.UI\SkyCD.UI.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Presentation\SkyCD.Presentation.csproj"/>
        <ProjectReference Include="..\..\Plugins\SkyCD.Plugin.Ai.Provider\SkyCD.Plugin.Ai.Provider.csproj"/>
        <PackageReference Include="SkyCD.Plugin.Sample.Config" Version="[1.0.0]"/>
        <ProjectReference Include="..\..\Plugins\SkyCD.Plugin.Feature.Loans\SkyCD.Plugin.Feature.Loans.csproj"/>
        <ProjectReference Include="..\..\Plugins\SkyCD.Plugin.Metadata.AudioCD\SkyCD.Plugin.Metadata.AudioCD.csproj"/>
        <ProjectReference Include="..\..\Plugins\SkyCD.Plugin.Metadata.EBook\SkyCD.Plugin.Metadata.EBook.csproj"/>
        <ProjectReference Include="..\..\Plugins\SkyCD.Plugin.Metadata.EComic\SkyCD.Plugin.Metadata.EComic.csproj"/>
        <PackageReference Include="SkyCD.Plugin.Metadata.Fonts" Version="[0.1.0]" />
        <ProjectReference Include="..\SkyCD.TestSupport\SkyCD.TestSupport.csproj"/>
    </ItemGroup>
    <!-- The views read their Twemoji artwork from the app's output (IconifyBundle Disk mode), which is not
         copied for a referencing project; mirror it so a window the tests instantiate paints its icons. -->
    <Target Name="CopyTwemojiArtwork" AfterTargets="Build">
        <ItemGroup>
            <_TwemojiArtwork Include="..\..\src\SkyCD.App\bin\$(Configuration)\$(TargetFramework)\iconifybundle\**\*.svg"/>
        </ItemGroup>
        <Copy SourceFiles="@(_TwemojiArtwork)"
              DestinationFiles="@(_TwemojiArtwork->'$(OutDir)iconifybundle\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
    </Target>
    <Import Project="../StandalonePluginReference.targets"/>
</Project>
