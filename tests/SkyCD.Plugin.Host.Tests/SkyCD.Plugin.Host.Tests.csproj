<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="SkyCD.Plugin.Feature.WebBrowser" Version="[3.0.0]"/>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]"/>
        <PackageReference Include="SkyCD.Plugin.Sample.Config" Version="[1.0.0]"/>
        <PackageReference Include="SkyCD.Plugin.Sample.Menu" Version="[1.0.0]"/>
        <PackageReference Include="SkyCD.Plugin.Sample.Modal" Version="[1.0.0]"/>
        <ProjectReference Include="..\..\src\SkyCD.Core\SkyCD.Core.csproj"/>
        <ProjectReference Include="..\..\src\SkyCD.Plugin.Host\SkyCD.Plugin.Host.csproj"/>
        <ProjectReference Include="../SkyCD.TestSupport/SkyCD.TestSupport.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Fixtures/**/*.cs"/>
        <ProjectReference Include="Fixtures/SkyCD.Plugin.Host.ConfigurationFixture/SkyCD.Plugin.Host.ConfigurationFixture.csproj"/>
    </ItemGroup>
    <Import Project="../StandalonePluginReference.targets"/>
