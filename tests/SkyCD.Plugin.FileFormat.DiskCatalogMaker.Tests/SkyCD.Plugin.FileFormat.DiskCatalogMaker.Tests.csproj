    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\Shared\LegacyEncodingSamples.cs" Link="Shared\LegacyEncodingSamples.cs"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
